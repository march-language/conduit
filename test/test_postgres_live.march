-- Live integration tests for Conduit.Storage.Postgres (job-lifecycle slice).
--
-- Requires a Postgres database `conduit_test` on 127.0.0.1:5432 loaded with
-- priv/migrations/001_conduit_schema.sql.  If the database is unreachable the
-- tests skip (pass) rather than fail, so `forge test` is green without a DB.
--
--   createdb conduit_test
--   psql -d conduit_test -f priv/migrations/001_conduit_schema.sql
mod ConduitPostgresLiveTest do
  use Test
  use Conduit
  import Connection

  pfn puser() : String do Env.get("USER", "postgres") end

  pfn pstore() do
    Conduit.Storage.Postgres.local(puser(), "conduit_test")
  end

  -- Connect and TRUNCATE the job tables for a clean slate.
  -- Returns Err if the DB is unreachable (tests treat that as "skip").
  pfn psetup() : Result((), String) do
    match Connection.connect({ host = "127.0.0.1", port = 5432, user = puser(),
                               database = "conduit_test", password = None }) do
      Err(e)   -> Err(e)
      Ok(conn) ->
        let _ = Connection.simple_query(conn, "TRUNCATE conduit_jobs, conduit_dead_letters, conduit_cron_schedules, conduit_workflows, conduit_checkpoints, conduit_workflow_signals, conduit_workers, conduit_rate_limit_buckets CASCADE")
        let _ = Connection.close(conn)
        Ok(())
    end
  end

  -- Build a pending JobRow with sensible defaults.  `run_offset` shifts run_at
  -- relative to now (seconds); negative = already runnable.
  pfn pmk_job(id : String, queue : String, priority : Int, run_offset : Int) : Conduit.JobRow do
    let now = DateTime.now()
    {
      id = id, queue = queue, job_type = "TestJob", payload = "{}",
      status = "pending", attempt = 0, max_attempts = 3, priority = priority,
      backoff = "exponential", dead_letter_queue = None,
      inserted_at = DateTime.from_timestamp(now),
      scheduled_at = DateTime.from_timestamp(now),
      run_at = DateTime.from_timestamp(now + run_offset),
      started_at = None, completed_at = None, heartbeat_at = None,
      worker_id = None, unique_key = None, errors = Nil, tags = Nil
    }
  end

  -- Build a CronSchedule whose next_run_at is now + offset seconds.
  pfn pmk_cron(id : String, next_offset : Int) : Conduit.CronSchedule do
    {
      id = id, job_type = "CronJob", schedule = "* * * * *", timezone = "UTC",
      queue = "default", payload = "{}", overlap = "skip", enabled = true,
      last_run_at = None, last_job_id = None,
      next_run_at = Some(DateTime.from_timestamp(DateTime.now() + next_offset)),
      tags = Nil, jitter_ms = None
    }
  end

  -- Build a running WorkflowRow.
  pfn pmk_workflow(id : String) : Conduit.WorkflowRow do
    {
      id = id, workflow_type = "TestWf", parent_id = None, input = "{}",
      output = None, status = "running",
      started_at = DateTime.from_timestamp(DateTime.now()),
      completed_at = None, timeout_at = None, error = None, error_at = None,
      tags = Nil, meta = "{}"
    }
  end

  -- Build a pending WorkflowSignal for an existing workflow.
  pfn pmk_signal(wf_id : String, stype : String) : Conduit.WorkflowSignal do
    {
      id = 0, workflow_id = wf_id, signal_type = stype, payload = "{}",
      status = "pending", sent_at = DateTime.from_timestamp(DateTime.now()),
      delivered_at = None, expires_at = None, sent_by = None
    }
  end

  -- Build a running NodeInfo; last_seen_at = now + offset seconds.
  pfn pmk_node(id : String, last_seen_offset : Int) : Conduit.NodeInfo do
    {
      id = id, hostname = "host1", pid = 4321,
      queues = Cons("default", Nil), pool_size = 4,
      started_at = DateTime.from_timestamp(DateTime.now()),
      last_seen_at = DateTime.from_timestamp(DateTime.now() + last_seen_offset),
      status = "running"
    }
  end

  -- Run a no-param query returning a single boolean cell; "t" => true.
  pfn pquery_bool(conn, sql : String) : Bool do
    match Connection.exec_prepared(conn, sql, Nil) do
      Err(_)  -> false
      Ok(res) ->
        match res.rows do
          Nil          -> false
          Cons(row, _) ->
            match List.nth_opt(row, 0) do
              Some(Some(s)) -> s == "t"
              _             -> false
            end
        end
    end
  end

  -- Build a DeadLetter for an existing job.
  pfn pmk_dl(id : String, job_id : String) : Conduit.DeadLetter do
    {
      id = id, job_id = job_id, queue = "default", job_type = "TestJob",
      payload = "{}", errors = Cons("boom", Nil), attempts = 3,
      first_attempted_at = None, last_attempted_at = None,
      discarded_at = DateTime.from_timestamp(DateTime.now()),
      reviewed = false, reviewed_by = None, reviewed_at = None, retry_count = 0
    }
  end

  test "postgres: enqueue then fetch_next claims the job as running" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let _ = Conduit.Storage.enqueue(store, pmk_job("j1", "default", 0, 0))
        match Conduit.Storage.fetch_next(store, "default") do
          Err(e)        -> Test.assert_true(false, "fetch_next errored: " ++ e)
          Ok(None)      -> Test.assert_true(false, "expected a job, got None")
          Ok(Some(job)) ->
            Test.assert_eq_str(job.id, "j1", "id round-trips")
            Test.assert_eq_str(job.status, "running", "claimed as running")
            Test.assert_eq_str(job.job_type, "TestJob", "job_type round-trips")
        end
    end
  end

  test "postgres: fetch_next on an empty queue returns None" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        match Conduit.Storage.fetch_next(pstore(), "default") do
          Ok(None) -> Test.assert_true(true, "")
          _        -> Test.assert_true(false, "expected None on empty queue")
        end
    end
  end

  test "postgres: a future-scheduled job is not fetched yet" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let _ = Conduit.Storage.enqueue(store, pmk_job("future", "default", 0, 3600))
        match Conduit.Storage.fetch_next(store, "default") do
          Ok(None) -> Test.assert_true(true, "")
          _        -> Test.assert_true(false, "future job should not be runnable")
        end
    end
  end

  test "postgres: mark_completed makes the job non-fetchable" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let _ = Conduit.Storage.enqueue(store, pmk_job("j2", "default", 0, 0))
        let _ = Conduit.Storage.mark_completed(store, "j2")
        match Conduit.Storage.fetch_next(store, "default") do
          Ok(None) -> Test.assert_true(true, "")
          _        -> Test.assert_true(false, "completed job should not be fetchable")
        end
    end
  end

  test "postgres: fetch_next honours priority ordering" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let _ = Conduit.Storage.enqueue(store, pmk_job("low", "default", 1, 0))
        let _ = Conduit.Storage.enqueue(store, pmk_job("high", "default", 10, 0))
        match Conduit.Storage.fetch_next(store, "default") do
          Ok(Some(job)) -> Test.assert_eq_str(job.id, "high", "higher priority fetched first")
          _             -> Test.assert_true(false, "expected a job")
        end
    end
  end

  test "postgres: schedule_retry reschedules to pending and appends the error" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let _ = Conduit.Storage.enqueue(store, pmk_job("j3", "default", 0, 0))
        let _ = Conduit.Storage.fetch_next(store, "default")
        let past = DateTime.from_timestamp(DateTime.now() - 10)
        let _ = Conduit.Storage.schedule_retry(store, "j3", "boom", past)
        match Conduit.Storage.fetch_next(store, "default") do
          Ok(Some(job)) ->
            Test.assert_eq_str(job.id, "j3", "rescheduled job is fetchable")
            Test.assert_true(List.length(job.errors) >= 1, "error was appended and decoded")
          _ -> Test.assert_true(false, "expected the rescheduled job")
        end
    end
  end

  test "postgres: discard marks the job dead and non-fetchable" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let _ = Conduit.Storage.enqueue(store, pmk_job("j4", "default", 0, 0))
        let _ = Conduit.Storage.discard(store, "j4", "permanent failure")
        match Conduit.Storage.fetch_next(store, "default") do
          Ok(None) -> Test.assert_true(true, "")
          _        -> Test.assert_true(false, "discarded job should not be fetchable")
        end
    end
  end

  test "postgres: move_to_dead_letter inserts the DL row and marks the job dead" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let _ = Conduit.Storage.enqueue(store, pmk_job("j5", "default", 0, 0))
        let now = DateTime.from_timestamp(DateTime.now())
        let dl = {
          id = "dl5", job_id = "j5", queue = "default", job_type = "TestJob",
          payload = "{}", errors = Cons("boom", Nil), attempts = 3,
          first_attempted_at = None, last_attempted_at = None,
          discarded_at = now, reviewed = false, reviewed_by = None,
          reviewed_at = None, retry_count = 0
        }
        match Conduit.Storage.move_to_dead_letter(store, dl) do
          Err(e) -> Test.assert_true(false, "move_to_dead_letter errored: " ++ e)
          Ok(_)  ->
            match Conduit.Storage.fetch_next(store, "default") do
              Ok(None) -> Test.assert_true(true, "")
              _        -> Test.assert_true(false, "dead-lettered job should not be fetchable")
            end
        end
    end
  end

  test "postgres: rescue_stale returns timed-out running jobs to pending" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        -- A job stuck 'running' with a heartbeat from an hour ago.
        let old  = DateTime.from_timestamp(DateTime.now() - 3600)
        let base = pmk_job("j6", "default", 0, 0)
        let stuck = { base with status = "running", started_at = Some(old), heartbeat_at = Some(old) }
        let _ = Conduit.Storage.enqueue(store, stuck)
        -- threshold 60s: cutoff = now-60; heartbeat (now-3600) is older → stale.
        match Conduit.Storage.rescue_stale(store, 60) do
          Err(e)   -> Test.assert_true(false, "rescue_stale errored: " ++ e)
          Ok(ids)  ->
            Test.assert_true(List.length(ids) >= 1, "at least one job rescued")
            match Conduit.Storage.fetch_next(store, "default") do
              Ok(Some(job)) -> Test.assert_eq_str(job.id, "j6", "rescued job is runnable again")
              _             -> Test.assert_true(false, "rescued job should be fetchable")
            end
        end
    end
  end

  -- ── Cron ───────────────────────────────────────────────────────

  test "postgres: cron_upsert then cron_load_by_id round-trips" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let _ = Conduit.Storage.cron_upsert(store, pmk_cron("daily", 0))
        match Conduit.Storage.cron_load_by_id(store, "daily") do
          Err(e)        -> Test.assert_true(false, "cron_load_by_id errored: " ++ e)
          Ok(None)      -> Test.assert_true(false, "expected the cron, got None")
          Ok(Some(c))   ->
            Test.assert_eq_str(c.id, "daily", "id round-trips")
            Test.assert_eq_str(c.schedule, "* * * * *", "schedule round-trips")
            Test.assert_true(c.enabled, "enabled round-trips")
        end
    end
  end

  test "postgres: cron_upsert is idempotent on id (update, not duplicate)" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let _ = Conduit.Storage.cron_upsert(store, pmk_cron("c1", 0))
        let base = pmk_cron("c1", 0)
        let _ = Conduit.Storage.cron_upsert(store, { base with queue = "high" })
        match Conduit.Storage.cron_load_by_id(store, "c1") do
          Ok(Some(c)) -> Test.assert_eq_str(c.queue, "high", "upsert updated the queue in place")
          _           -> Test.assert_true(false, "expected the updated cron")
        end
    end
  end

  test "postgres: cron_load_due returns due, excludes future and disabled" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let _ = Conduit.Storage.cron_upsert(store, pmk_cron("due", -10))
        let _ = Conduit.Storage.cron_upsert(store, pmk_cron("future", 3600))
        let dis = pmk_cron("disabled", -10)
        let _ = Conduit.Storage.cron_upsert(store, { dis with enabled = false })
        match Conduit.Storage.cron_load_due(store) do
          Err(e)  -> Test.assert_true(false, "cron_load_due errored: " ++ e)
          Ok(due) ->
            Test.assert_eq_int(List.length(due), 1, "exactly one schedule is due")
            match due do
              Cons(c, _) -> Test.assert_eq_str(c.id, "due", "the due one is returned")
              Nil        -> Test.assert_true(false, "expected one due schedule")
            end
        end
    end
  end

  test "postgres: cron_mark_fired records last_job_id and advances next_run_at" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let _ = Conduit.Storage.cron_upsert(store, pmk_cron("m", -10))
        let next = DateTime.from_timestamp(DateTime.now() + 60)
        let _ = Conduit.Storage.cron_mark_fired(store, "m", "job-123", Some(next))
        match Conduit.Storage.cron_load_by_id(store, "m") do
          Ok(Some(c)) ->
            Test.assert_some(c.last_job_id)
            Test.assert_some(c.last_run_at)
            -- next_run_at advanced into the future, so it's no longer due
            match Conduit.Storage.cron_load_due(store) do
              Ok(Nil) -> Test.assert_true(true, "")
              Ok(_)   -> Test.assert_true(false, "after mark_fired the schedule should not be due")
              Err(e)  -> Test.assert_true(false, "cron_load_due errored: " ++ e)
            end
          _ -> Test.assert_true(false, "expected the cron after mark_fired")
        end
    end
  end

  test "postgres: cron_job_active reflects job lifecycle" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let _ = Conduit.Storage.enqueue(store, pmk_job("cj", "default", 0, 0))
        match Conduit.Storage.cron_job_active(store, "cj") do
          Ok(true) ->
            let _ = Conduit.Storage.mark_completed(store, "cj")
            match Conduit.Storage.cron_job_active(store, "cj") do
              Ok(false) -> Test.assert_true(true, "")
              _         -> Test.assert_true(false, "completed job should be inactive")
            end
          _ -> Test.assert_true(false, "pending job should be active")
        end
    end
  end

  test "postgres: cron_cancel_job kills a pending job" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let _ = Conduit.Storage.enqueue(store, pmk_job("ck", "default", 0, 0))
        let _ = Conduit.Storage.cron_cancel_job(store, "ck")
        match Conduit.Storage.cron_job_active(store, "ck") do
          Ok(false) -> Test.assert_true(true, "")
          _         -> Test.assert_true(false, "cancelled job should be inactive")
        end
    end
  end

  test "postgres: cron_delete removes the schedule" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let _ = Conduit.Storage.cron_upsert(store, pmk_cron("gone", 0))
        let _ = Conduit.Storage.cron_delete(store, "gone")
        match Conduit.Storage.cron_load_by_id(store, "gone") do
          Ok(None) -> Test.assert_true(true, "")
          _        -> Test.assert_true(false, "deleted cron should be gone")
        end
    end
  end

  test "postgres: cron_advisory_lock acquires single-node" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        match Conduit.Storage.cron_advisory_lock(pstore(), 7326482) do
          Ok(true) ->
            match Conduit.Storage.cron_advisory_unlock(pstore(), 7326482) do
              Ok(_)  -> Test.assert_true(true, "")
              Err(e) -> Test.assert_true(false, "unlock errored: " ++ e)
            end
          _ -> Test.assert_true(false, "expected to acquire the advisory lock")
        end
    end
  end

  -- ── Workflows / checkpoints / signals ──────────────────────────

  test "postgres: workflow_insert then workflow_load round-trips" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let _ = Conduit.Storage.workflow_insert(store, pmk_workflow("wf1"))
        match Conduit.Storage.workflow_load(store, "wf1") do
          Err(e)      -> Test.assert_true(false, "workflow_load errored: " ++ e)
          Ok(None)    -> Test.assert_true(false, "expected the workflow, got None")
          Ok(Some(w)) ->
            Test.assert_eq_str(w.id, "wf1", "id round-trips")
            Test.assert_eq_str(w.workflow_type, "TestWf", "type round-trips")
            Test.assert_eq_str(w.status, "running", "status round-trips")
        end
    end
  end

  test "postgres: workflow_status_get returns status, None for missing" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let _ = Conduit.Storage.workflow_insert(store, pmk_workflow("wf2"))
        match Conduit.Storage.workflow_status_get(store, "wf2") do
          Ok(Some(s)) -> Test.assert_eq_str(s, "running", "status")
          _           -> Test.assert_true(false, "expected a status")
        end
        match Conduit.Storage.workflow_status_get(store, "nope") do
          Ok(None) -> Test.assert_true(true, "")
          _        -> Test.assert_true(false, "missing workflow should be None")
        end
    end
  end

  test "postgres: workflow_update_status sets terminal status + output" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let _ = Conduit.Storage.workflow_insert(store, pmk_workflow("wf3"))
        let _ = Conduit.Storage.workflow_update_status(store, "wf3", "completed", Some("\"result\""), None)
        match Conduit.Storage.workflow_load(store, "wf3") do
          Ok(Some(w)) ->
            Test.assert_eq_str(w.status, "completed", "status updated")
            Test.assert_true(Option.is_some(w.output), "output recorded")
            Test.assert_true(Option.is_some(w.completed_at), "completed_at set")
          _ -> Test.assert_true(false, "expected the workflow")
        end
    end
  end

  test "postgres: workflow_cancel cancels a running workflow with reason" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let _ = Conduit.Storage.workflow_insert(store, pmk_workflow("wf4"))
        let _ = Conduit.Storage.workflow_cancel(store, "wf4", "user requested")
        match Conduit.Storage.workflow_load(store, "wf4") do
          Ok(Some(w)) ->
            Test.assert_eq_str(w.status, "cancelled", "status cancelled")
            Test.assert_true(Option.is_some(w.error), "cancel reason recorded")
          _ -> Test.assert_true(false, "expected the workflow")
        end
    end
  end

  test "postgres: workflow_list_all returns inserted workflows" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let _ = Conduit.Storage.workflow_insert(store, pmk_workflow("a"))
        let _ = Conduit.Storage.workflow_insert(store, pmk_workflow("b"))
        match Conduit.Storage.workflow_list_all(store) do
          Ok(ws) -> Test.assert_eq_int(List.length(ws), 2, "two workflows listed")
          Err(e) -> Test.assert_true(false, "workflow_list_all errored: " ++ e)
        end
    end
  end

  test "postgres: checkpoint_set then checkpoint_get round-trips and is first-write-wins" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let _ = Conduit.Storage.workflow_insert(store, pmk_workflow("wfc"))
        let _ = Conduit.Storage.checkpoint_set(store, "wfc", "step1", "\"v1\"", 5)
        -- second set with a different value must NOT overwrite (immutable checkpoint)
        let _ = Conduit.Storage.checkpoint_set(store, "wfc", "step1", "\"v2\"", 9)
        match Conduit.Storage.checkpoint_get(store, "wfc", "step1") do
          Ok(Some(v)) -> Test.assert_eq_str(v, "\"v1\"", "first write wins")
          _           -> Test.assert_true(false, "expected the checkpoint value")
        end
        match Conduit.Storage.checkpoint_get(store, "wfc", "absent") do
          Ok(None) -> Test.assert_true(true, "")
          _        -> Test.assert_true(false, "missing checkpoint should be None")
        end
    end
  end

  test "postgres: checkpoint_load_all returns all checkpoints for a workflow" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let _ = Conduit.Storage.workflow_insert(store, pmk_workflow("wfd"))
        let _ = Conduit.Storage.checkpoint_set(store, "wfd", "s1", "\"a\"", 1)
        let _ = Conduit.Storage.checkpoint_set(store, "wfd", "s2", "\"b\"", 2)
        match Conduit.Storage.checkpoint_load_all(store, "wfd") do
          Ok(cps) -> Test.assert_eq_int(List.length(cps), 2, "two checkpoints")
          Err(e)  -> Test.assert_true(false, "checkpoint_load_all errored: " ++ e)
        end
    end
  end

  test "postgres: signal_insert + signal_peek + signal_mark_delivered" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let _ = Conduit.Storage.workflow_insert(store, pmk_workflow("wfs"))
        match Conduit.Storage.signal_insert(store, pmk_signal("wfs", "approval")) do
          Err(e) -> Test.assert_true(false, "signal_insert errored: " ++ e)
          Ok(id) ->
            Test.assert_true(id > 0, "returns a generated id")
            match Conduit.Storage.signal_peek(store, "wfs", "approval") do
              Ok(Some(s)) ->
                Test.assert_eq_str(s.signal_type, "approval", "peek finds pending signal")
                let _ = Conduit.Storage.signal_mark_delivered(store, s.id)
                match Conduit.Storage.signal_peek(store, "wfs", "approval") do
                  Ok(None) -> Test.assert_true(true, "delivered signal no longer pending")
                  _        -> Test.assert_true(false, "signal should be delivered now")
                end
              _ -> Test.assert_true(false, "expected a pending signal")
            end
        end
    end
  end

  -- ── Node coordination ──────────────────────────────────────────

  test "postgres: node_register then node_list_active finds the node" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let _ = Conduit.Storage.node_register(store, pmk_node("node-a", 0))
        match Conduit.Storage.node_list_active(store) do
          Err(e)    -> Test.assert_true(false, "node_list_active errored: " ++ e)
          Ok(nodes) ->
            Test.assert_eq_int(List.length(nodes), 1, "one active node")
            match nodes do
              Cons(n, _) ->
                Test.assert_eq_str(n.id, "node-a", "id round-trips")
                Test.assert_eq_int(n.pool_size, 4, "pool_size round-trips")
              Nil -> Test.assert_true(false, "expected a node")
            end
        end
    end
  end

  test "postgres: node_deregister removes it from the active list" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let _ = Conduit.Storage.node_register(store, pmk_node("node-b", 0))
        let _ = Conduit.Storage.node_deregister(store, "node-b")
        match Conduit.Storage.node_list_active(store) do
          Ok(Nil) -> Test.assert_true(true, "")
          Ok(_)   -> Test.assert_true(false, "deregistered node should not be active")
          Err(e)  -> Test.assert_true(false, "node_list_active errored: " ++ e)
        end
    end
  end

  test "postgres: node_cleanup_stale stops nodes with old heartbeats" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let _ = Conduit.Storage.node_register(store, pmk_node("fresh", 0))
        let _ = Conduit.Storage.node_register(store, pmk_node("stale", -3600))
        match Conduit.Storage.node_cleanup_stale(store, 60) do
          Err(e) -> Test.assert_true(false, "node_cleanup_stale errored: " ++ e)
          Ok(n)  ->
            Test.assert_eq_int(n, 1, "exactly one stale node stopped")
            match Conduit.Storage.node_list_active(store) do
              Ok(Cons(node, Nil)) -> Test.assert_eq_str(node.id, "fresh", "only the fresh node remains active")
              _                   -> Test.assert_true(false, "expected one active node")
            end
        end
    end
  end

  test "postgres: node_reclaim_jobs resets orphaned running jobs" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let old  = DateTime.from_timestamp(DateTime.now() - 3600)
        let base = pmk_job("orphan", "default", 0, 0)
        let stuck = { base with status = "running", started_at = Some(old), heartbeat_at = Some(old) }
        let _ = Conduit.Storage.enqueue(store, stuck)
        match Conduit.Storage.node_reclaim_jobs(store, 60) do
          Err(e)  -> Test.assert_true(false, "node_reclaim_jobs errored: " ++ e)
          Ok(ids) ->
            Test.assert_true(List.length(ids) >= 1, "reclaimed the orphaned job")
            match Conduit.Storage.fetch_next(store, "default") do
              Ok(Some(job)) -> Test.assert_eq_str(job.id, "orphan", "orphan is runnable again")
              _             -> Test.assert_true(false, "reclaimed job should be fetchable")
            end
        end
    end
  end

  test "postgres: node leader lock acquires/releases single-node" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        match Conduit.Storage.node_try_leader_lock(pstore(), 8473625) do
          Ok(true) ->
            match Conduit.Storage.node_release_leader_lock(pstore(), 8473625) do
              Ok(_)  -> Test.assert_true(true, "")
              Err(e) -> Test.assert_true(false, "release errored: " ++ e)
            end
          _ -> Test.assert_true(false, "expected to acquire the leader lock")
        end
    end
  end

  test "postgres: advisory lock is held across calls and blocks other sessions" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        match Conduit.Storage.cron_advisory_lock(store, 999111) do
          Ok(true) ->
            -- A separate session must NOT acquire the same lock while the store
            -- holds it — proving the lock persists past cron_advisory_lock's
            -- return (i.e. it lives on a dedicated connection, T0.3).
            match Connection.connect({ host = "127.0.0.1", port = 5432, user = puser(),
                                       database = "conduit_test", password = None }) do
              Err(e)    -> Test.assert_true(false, "probe connect: " ++ e)
              Ok(other) ->
                Test.assert_true(pquery_bool(other, "SELECT pg_try_advisory_lock(999111)") == false,
                  "other session is blocked while the lock is held")
                let _ = Conduit.Storage.cron_advisory_unlock(store, 999111)
                Test.assert_true(pquery_bool(other, "SELECT pg_try_advisory_lock(999111)"),
                  "other session acquires after release")
                let _ = pquery_bool(other, "SELECT pg_advisory_unlock(999111)")
                let _ = Connection.close(other)
                ()
            end
          _ -> Test.assert_true(false, "expected to acquire the advisory lock")
        end
    end
  end

  -- ── Dashboard queries ──────────────────────────────────────────

  test "postgres: dashboard_queue_summary aggregates per queue" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let _ = Conduit.Storage.enqueue(store, pmk_job("s1", "email", 0, 0))
        let _ = Conduit.Storage.enqueue(store, pmk_job("s2", "email", 0, 0))
        match Conduit.Storage.dashboard_queue_summary(store) do
          Err(e)  -> Test.assert_true(false, "dashboard_queue_summary errored: " ++ e)
          Ok(sum) ->
            match sum do
              Cons(q, _) ->
                Test.assert_eq_str(q.queue, "email", "queue name")
                Test.assert_eq_int(q.pending, 2, "two pending")
              Nil -> Test.assert_true(false, "expected one queue summary")
            end
        end
    end
  end

  test "postgres: dashboard_jobs_list filters by queue and paginates" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let _ = Conduit.Storage.enqueue(store, pmk_job("a1", "q1", 0, 0))
        let _ = Conduit.Storage.enqueue(store, pmk_job("a2", "q1", 0, 0))
        let _ = Conduit.Storage.enqueue(store, pmk_job("b1", "q2", 0, 0))
        match Conduit.Storage.dashboard_jobs_list(store, "q1", "", 0) do
          Ok(jobs) -> Test.assert_eq_int(List.length(jobs), 2, "two jobs in q1")
          Err(e)   -> Test.assert_true(false, "dashboard_jobs_list errored: " ++ e)
        end
    end
  end

  test "postgres: dashboard_job_by_id returns the job without claiming it" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let _ = Conduit.Storage.enqueue(store, pmk_job("byid", "default", 0, 0))
        match Conduit.Storage.dashboard_job_by_id(store, "byid") do
          Ok(Some(j)) -> Test.assert_eq_str(j.status, "pending", "still pending (not claimed)")
          _           -> Test.assert_true(false, "expected the job by id")
        end
    end
  end

  test "postgres: dashboard_crons_list returns all schedules" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let _ = Conduit.Storage.cron_upsert(store, pmk_cron("c1", 0))
        let _ = Conduit.Storage.cron_upsert(store, pmk_cron("c2", 3600))
        match Conduit.Storage.dashboard_crons_list(store) do
          Ok(cs) -> Test.assert_eq_int(List.length(cs), 2, "two crons (incl. future)")
          Err(e) -> Test.assert_true(false, "dashboard_crons_list errored: " ++ e)
        end
    end
  end

  test "postgres: dashboard_workflows_list filters by status" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let _ = Conduit.Storage.workflow_insert(store, pmk_workflow("w1"))
        let _ = Conduit.Storage.workflow_insert(store, pmk_workflow("w2"))
        let _ = Conduit.Storage.workflow_update_status(store, "w2", "completed", None, None)
        match Conduit.Storage.dashboard_workflows_list(store, "running", 0) do
          Ok(ws) -> Test.assert_eq_int(List.length(ws), 1, "one running workflow")
          Err(e) -> Test.assert_true(false, "dashboard_workflows_list errored: " ++ e)
        end
    end
  end

  -- ── Dead letters & job admin ───────────────────────────────────

  test "postgres: dead_letter list/load/delete round-trip" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let _ = Conduit.Storage.enqueue(store, pmk_job("dj", "default", 0, 0))
        let _ = Conduit.Storage.move_to_dead_letter(store, pmk_dl("dl1", "dj"))
        match Conduit.Storage.dead_letter_list(store, 0) do
          Ok(Cons(d, Nil)) -> Test.assert_eq_str(d.id, "dl1", "listed")
          _                -> Test.assert_true(false, "expected one dead letter")
        end
        match Conduit.Storage.dead_letter_load(store, "dl1") do
          Ok(Some(d)) -> Test.assert_eq_str(d.job_id, "dj", "loaded by id")
          _           -> Test.assert_true(false, "expected to load the dead letter")
        end
        let _ = Conduit.Storage.dead_letter_delete(store, "dl1")
        match Conduit.Storage.dead_letter_load(store, "dl1") do
          Ok(None) -> Test.assert_true(true, "")
          _        -> Test.assert_true(false, "deleted dead letter should be gone")
        end
    end
  end

  test "postgres: dead_letter_delete_all clears the table" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let _ = Conduit.Storage.enqueue(store, pmk_job("d1", "default", 0, 0))
        let _ = Conduit.Storage.enqueue(store, pmk_job("d2", "default", 0, 0))
        let _ = Conduit.Storage.move_to_dead_letter(store, pmk_dl("x1", "d1"))
        let _ = Conduit.Storage.move_to_dead_letter(store, pmk_dl("x2", "d2"))
        match Conduit.Storage.dead_letter_delete_all(store) do
          Ok(n)  -> Test.assert_eq_int(n, 2, "deleted both")
          Err(e) -> Test.assert_true(false, "dead_letter_delete_all errored: " ++ e)
        end
    end
  end

  test "postgres: job_retry resets a dead job to runnable" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let _ = Conduit.Storage.enqueue(store, pmk_job("r1", "default", 0, 0))
        let _ = Conduit.Storage.discard(store, "r1", "nope")
        let _ = Conduit.Storage.job_retry(store, "r1")
        match Conduit.Storage.fetch_next(store, "default") do
          Ok(Some(j)) -> Test.assert_eq_str(j.id, "r1", "retried job is runnable")
          _           -> Test.assert_true(false, "expected the retried job")
        end
    end
  end

  test "postgres: job_delete removes the row" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let _ = Conduit.Storage.enqueue(store, pmk_job("del", "default", 0, 0))
        let _ = Conduit.Storage.job_delete(store, "del")
        match Conduit.Storage.dashboard_job_by_id(store, "del") do
          Ok(None) -> Test.assert_true(true, "")
          _        -> Test.assert_true(false, "deleted job should be gone")
        end
    end
  end

  -- ── Rate limiting & unique jobs ─────────────────────────────────

  test "postgres: rate_limit_acquire allows up to the rate then denies" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let a1 = Conduit.Storage.rate_limit_acquire(store, "k", 2)
        let a2 = Conduit.Storage.rate_limit_acquire(store, "k", 2)
        let a3 = Conduit.Storage.rate_limit_acquire(store, "k", 2)
        match (a1, a2, a3) do
          (Ok(true), Ok(true), Ok(false)) -> Test.assert_true(true, "")
          _ -> Test.assert_true(false, "expected allow, allow, deny within the same second")
        end
    end
  end

  test "postgres: unique_check / unique_release" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let base = pmk_job("u1", "default", 0, 0)
        let _ = Conduit.Storage.enqueue(store, { base with unique_key = Some("fp-1") })
        match Conduit.Storage.unique_check(store, "fp-1") do
          Ok(true) ->
            let _ = Conduit.Storage.unique_release(store, "u1")
            match Conduit.Storage.unique_check(store, "fp-1") do
              Ok(false) -> Test.assert_true(true, "")
              _         -> Test.assert_true(false, "released key should be free")
            end
          _ -> Test.assert_true(false, "active unique key should be taken")
        end
    end
  end

  -- ── Event store ─────────────────────────────────────────────────

  test "postgres: event_append + load + count + load_up_to" do
    match psetup() do
      Err(_) -> ()
      Ok(_)  ->
        let store = pstore()
        let _ = Conduit.Storage.workflow_insert(store, pmk_workflow("wfe"))
        let _ = Conduit.Storage.event_append(store, "wfe", 0, "checkpoint", "{\"v\":1}")
        let _ = Conduit.Storage.event_append(store, "wfe", 1, "checkpoint", "{\"v\":2}")
        let _ = Conduit.Storage.event_append(store, "wfe", 2, "checkpoint", "{\"v\":3}")
        match Conduit.Storage.event_count(store, "wfe") do
          Ok(n)  -> Test.assert_eq_int(n, 3, "three events")
          Err(e) -> Test.assert_true(false, "event_count errored: " ++ e)
        end
        match Conduit.Storage.event_load_all(store, "wfe") do
          Ok(evs) -> Test.assert_eq_int(List.length(evs), 3, "loaded all three")
          Err(e)  -> Test.assert_true(false, "event_load_all errored: " ++ e)
        end
        match Conduit.Storage.event_load_up_to(store, "wfe", 1) do
          Ok(evs) -> Test.assert_eq_int(List.length(evs), 2, "loaded up to sequence 1")
          Err(e)  -> Test.assert_true(false, "event_load_up_to errored: " ++ e)
        end
    end
  end

end
