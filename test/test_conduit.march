  -- ─────────────────────────────────────────────────────────────

  test "workflow_event_type_fields" do
    let now = DateTime.from_timestamp(DateTime.now())
    let evt : Conduit.WorkflowEvent = {
      id: 42,
      workflow_id: "wf-abc",
      sequence: 0,
      event_type: "checkpoint",
      payload: "{\"name\":\"step1\",\"value\":\"hello\"}",
      recorded_at: now
    }
    assert_eq_int(evt.id, 42)
    assert_eq_str(evt.workflow_id, "wf-abc")
    assert_eq_int(evt.sequence, 0)
    assert_eq_str(evt.event_type, "checkpoint")
    assert_true(String.contains(evt.payload, "step1"))
  end

