  test "cron_config: default jitter_ms is None" do
    let cfg = Conduit.CronConfig.default()
    match cfg.jitter_ms do
      None    -> assert_true(true)
      Some(_) -> assert_true(false)
    end
  end

  test "cron_config: jitter_ms can be set to Some(5000)" do
    let base = Conduit.CronConfig.default()
    let cfg = { base with jitter_ms: Some(5000) }
    match cfg.jitter_ms do
      None    -> assert_true(false)
      Some(j) -> assert_eq_int(j, 5000)
