  -- =========================================================================
  -- Stage 1: Shutdown drain flag
  -- =========================================================================

  test "shutdown: not draining by default" do
    Conduit.Shutdown.clear_draining()
    assert_true(Conduit.Shutdown.is_draining() == false)
  end

  test "shutdown: set_draining marks node as draining" do
    Conduit.Shutdown.clear_draining()
    Conduit.Shutdown.set_draining()
    assert_true(Conduit.Shutdown.is_draining())
    Conduit.Shutdown.clear_draining()
  end

  test "shutdown: clear_draining resets drain flag" do
    Conduit.Shutdown.set_draining()
    Conduit.Shutdown.clear_draining()
    assert_true(Conduit.Shutdown.is_draining() == false)
  end

  -- =========================================================================
  -- Stage 1: Config drain_timeout_ms
  -- =========================================================================

  test "config: default drain_timeout_ms is 15000" do
    let cfg = Conduit.Config.default()
    assert_eq_int(cfg.drain_timeout_ms, 15000)
  end

  test "config: drain_timeout_ms can be overridden" do
    let base = Conduit.Config.default()
    let cfg = { base with drain_timeout_ms: 30000 }
    assert_eq_int(cfg.drain_timeout_ms, 30000)
  end

