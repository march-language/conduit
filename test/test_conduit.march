  -- ─────────────────────────────────────────────────────────────

  fn test_workflow_config_default_is_checkpoint_mode() do
    let cfg = Conduit.WorkflowConfig.default()
    match cfg.execution_mode do
      Conduit.ExecutionMode.Checkpoint -> assert_true(true)
      _                                -> assert_true(false)
    end
    assert_none(cfg.timeout)
  end

  fn test_workflow_error_failed_carries_message() do
    let e = Conduit.WorkflowError.Failed("something broke")
    match e do
      Conduit.WorkflowError.Failed(msg) -> assert_eq_str(msg, "something broke")
      _                                  -> assert_true(false)
    end
  end

  fn test_workflow_error_cancelled_carries_reason() do
    let e = Conduit.WorkflowError.Cancelled("user request")
    match e do
      Conduit.WorkflowError.Cancelled(r) -> assert_eq_str(r, "user request")
      _                                   -> assert_true(false)
    end
  end

  fn test_workflow_error_timed_out_has_no_payload() do
    let e = Conduit.WorkflowError.TimedOut
    match e do
      Conduit.WorkflowError.TimedOut -> assert_true(true)
      _                               -> assert_true(false)
    end
  end

  fn test_workflow_error_storage_error_carries_message() do
    let e = Conduit.WorkflowError.StorageError("db unreachable")
    match e do
      Conduit.WorkflowError.StorageError(m) -> assert_eq_str(m, "db unreachable")
      _                                      -> assert_true(false)
    end
  end

