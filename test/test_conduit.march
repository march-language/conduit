  fn test_queue_summary_type_fields() do
    let qs : Conduit.Dashboard.QueueSummary = {
      queue       = "default",
      pending     = 10,
      running     = 2,
      failed      = 1,
      dead        = 0,
      throughput  = 500,
      avg_latency = 42
    }
    assert_eq_str(qs.queue, "default")
    assert_eq_int(qs.pending, 10)
    assert_eq_int(qs.running, 2)
    assert_eq_int(qs.failed, 1)
    assert_eq_int(qs.dead, 0)
    assert_eq_int(qs.throughput, 500)
    assert_eq_int(qs.avg_latency, 42)
  end

  -- ─────────────────────────────────────────────────────────────
  -- Phase 6: Auth
  -- ─────────────────────────────────────────────────────────────

  fn test_dashboard_auth_none_always_allows() do
    let auth = Conduit.Dashboard.Auth.None
    -- Auth.None returns true without inspecting conn.
    -- We simulate a no-op conn check by inspecting the type directly.
    match auth do
      Conduit.Dashboard.Auth.None -> assert_true(true)
      _                           -> assert_true(false)
    end
  end

  fn test_dashboard_auth_token_matches_correct_bearer() do
    let auth  = Conduit.Dashboard.Auth.Token("secret123")
    match auth do
      Conduit.Dashboard.Auth.Token(t) -> assert_eq_str(t, "secret123")
      _                               -> assert_true(false)
    end
  end

  fn test_dashboard_auth_fn_wraps_predicate() do
    let called_key = "auth_fn_" ++ uuid_v4()
    Vault.set(called_key, "called", false)
    let auth = Conduit.Dashboard.Auth.Fn(fn _header ->
      Vault.set(called_key, "called", true)
      true
    end)
    match auth do
      Conduit.Dashboard.Auth.Fn(f) ->
        let result = f("Bearer test")
        assert_eq_bool(result, true)
        assert_eq_bool(Vault.get(called_key, "called") |> unwrap_or(false), true)
      _ -> assert_true(false)
    end
  end

