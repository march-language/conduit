  -- Phase 3: CronOverlap serialisation round-trip
  -- ─────────────────────────────────────────────────────────────

  test "cron_overlap_skip_round_trip" do
    let o = Conduit.CronRegistry.overlap_from_string("skip")
    let s = Conduit.CronRegistry.overlap_to_string(o)
    assert_eq_str(s, "skip")
