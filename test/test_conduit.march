  test "cron_overlap_allow_round_trip" do
    let o = Conduit.CronRegistry.overlap_from_string("allow")
    let s = Conduit.CronRegistry.overlap_to_string(o)
    assert_eq_str(s, "allow")
  end

  test "cron_overlap_replace_round_trip" do
    let o = Conduit.CronRegistry.overlap_from_string("replace")
    let s = Conduit.CronRegistry.overlap_to_string(o)
    assert_eq_str(s, "replace")
  end

  test "cron_overlap_unknown_string_defaults_to_skip" do
    let o = Conduit.CronRegistry.overlap_from_string("nonsense")
    let s = Conduit.CronRegistry.overlap_to_string(o)
    assert_eq_str(s, "skip")
  end

  -- ─────────────────────────────────────────────────────────────
  -- Phase 4: WorkflowContext
  -- ─────────────────────────────────────────────────────────────

  test "workflow_context_new_sets_workflow_id" do
    let wf_id = base64_encode(random_bytes(16))
    let ctx   = Conduit.WorkflowContext.new(wf_id)
    assert_eq_str(ctx.workflow_id, wf_id)
    assert_eq_str(ctx.namespace, "")
    assert_none(ctx.parent_id)
  end

  test "workflow_context_child_adds_namespace" do
    let ctx   = Conduit.WorkflowContext.new(base64_encode(random_bytes(16)))
    let child = Conduit.WorkflowContext.child(ctx, "parallel:0:")
    assert_eq_str(child.namespace, "parallel:0:")
    assert_eq_str(child.workflow_id, ctx.workflow_id)
  end

  test "workflow_context_child_nests_namespace" do
    let ctx    = Conduit.WorkflowContext.new(base64_encode(random_bytes(16)))
    let child1 = Conduit.WorkflowContext.child(ctx, "parallel:0:")
    let child2 = Conduit.WorkflowContext.child(child1, "parallel:1:")
    assert_eq_str(child2.namespace, "parallel:0:parallel:1:")
  end

  test "workflow_context_checkpoint_executes_fn_on_first_call" do
    -- Use a fake storage that always returns None (no prior checkpoint).
    let wf_id    = base64_encode(random_bytes(16))
    let ctx      = Conduit.WorkflowContext.new(wf_id)
    let vault_key_name = "phase4_test_" ++ base64_encode(random_bytes(16))
    let vault_key = Vault.new(vault_key_name)
    Vault.set(vault_key, "call_count", 0)

    let storage = fake_workflow_storage_new(vault_key_name)

    let cp_fn = fn () ->
      let count = Vault.get(vault_key, "call_count") |> unwrap_or(0)
      let _ = Vault.set(vault_key, "call_count", count + 1)
      "\"result_a\""
    let result = Conduit.WorkflowContext.checkpoint(storage, ctx, "step1", cp_fn)

    assert_ok(result)
    match result do
      Err(_)  -> assert_true(false)
      Ok(val) -> assert_eq_str(val, "\"result_a\"")
    end
    let calls = Vault.get(vault_key, "call_count") |> unwrap_or(-1)
    assert_eq_int(calls, 1)
  end

  test "workflow_context_checkpoint_skips_fn_on_replay" do
    -- Pre-populate the checkpoint in the context cache (simulating resumed workflow).
    let wf_id = base64_encode(random_bytes(16))
    let ctx   = Conduit.WorkflowContext.new(wf_id)
    -- Seed the cache directly in Vault (simulates warm_cache having run).
    Vault.set(ctx.checkpoint_key, "step1", "\"cached_value\"")

    let vault_key_name = "phase4_replay_" ++ base64_encode(random_bytes(16))
    let vault_key = Vault.new(vault_key_name)
    Vault.set(vault_key, "fn_called", false)
    let storage = fake_workflow_storage_new(vault_key_name)

    let cp_fn = fn () ->
      let _ = Vault.set(vault_key, "fn_called", true)
      "\"should_not_be_called\""
    let result = Conduit.WorkflowContext.checkpoint(storage, ctx, "step1", cp_fn)

    assert_ok(result)
    match result do
      Err(_)  -> assert_true(false)
      Ok(val) -> assert_eq_str(val, "\"cached_value\"")
    end
    assert_eq_bool(Vault.get(vault_key, "fn_called") |> unwrap_or(true), false)
  end

  test "workflow_context_checkpoint_storage_error" do
    let wf_id   = base64_encode(random_bytes(16))
    let ctx     = Conduit.WorkflowContext.new(wf_id)
    let storage = fake_workflow_storage_with_error("simulated DB error")

    let result = Conduit.WorkflowContext.checkpoint(storage, ctx, "step1", fn () -> "value")
    assert_err(result)
  end

  test "workflow_context_parallel_collects_all_results" do
    let wf_id   = base64_encode(random_bytes(16))
    let ctx     = Conduit.WorkflowContext.new(wf_id)
    let vault_k = "parallel_test_" ++ base64_encode(random_bytes(16))
    let storage = fake_workflow_storage_new(vault_k)

    let items = Cons("a", Cons("b", Cons("c", Nil)))
    let result = Conduit.WorkflowContext.parallel(storage, ctx, items, fn (item, _branch_ctx) ->
      Ok("result_" ++ item))

    assert_ok(result)
    match result do
      Err(_)     -> assert_true(false)
      Ok(results) ->
        assert_eq_int(List.length(results), 3)
        assert_true(List.member(results, "result_a"))
        assert_true(List.member(results, "result_b"))
        assert_true(List.member(results, "result_c"))
    end
  end

  pfn pparallel_error_fn(item : String, _branch_ctx : Conduit.WorkflowContext) : Result(String, WorkflowError) do
    if item == "x" do
      Err(Conduit.Failed("item x failed"))
    else
      Ok("ok_" ++ item)
    end
  end

  test "workflow_context_parallel_propagates_first_error" do
    let wf_id   = base64_encode(random_bytes(16))
    let ctx     = Conduit.WorkflowContext.new(wf_id)
    let vault_k = "parallel_err_" ++ base64_encode(random_bytes(16))
    let storage = fake_workflow_storage_new(vault_k)

    let items = Cons("x", Cons("y", Nil))
    let result = Conduit.WorkflowContext.parallel(storage, ctx, items, pparallel_error_fn)

    assert_err(result)
  end

  -- ─────────────────────────────────────────────────────────────
  -- Phase 4: WorkflowRegistry
  -- ─────────────────────────────────────────────────────────────

  test "workflow_registry_register_and_lookup" do
    let wf_type = "TestWorkflow_" ++ base64_encode(random_bytes(16))
    let config  = Conduit.WorkflowConfig.default()
    Conduit.WorkflowRegistry.register(wf_type, fn _input -> fn _ctx -> Ok("{}"), config)

    let result = Conduit.WorkflowRegistry.lookup(wf_type)
    assert_some(result)
    match result do
      None    -> assert_true(false)
      Some(e) ->
        match e.config.execution_mode do
          Checkpoint -> assert_true(true)
          _                                -> assert_true(false)
        end
    end
  end

  test "workflow_registry_lookup_none_for_unknown" do
    let result = Conduit.WorkflowRegistry.lookup("__no_such_workflow__")
    assert_none(result)
  end

  test "workflow_registry_run_dispatches_to_runner" do
    let wf_type = "RunDispatch_" ++ base64_encode(random_bytes(16))
    let vault_k_name = "wf_run_" ++ base64_encode(random_bytes(16))
    let vault_k = Vault.new(vault_k_name)
    Vault.set(vault_k, "ran", false)

    let inner_fn = fn _ctx ->
      let _ = Vault.set(vault_k, "ran", true)
      Ok("{\"ok\": true}")
    let wf_fn = fn _input -> inner_fn
    Conduit.WorkflowRegistry.register(wf_type, wf_fn, Conduit.WorkflowConfig.default())

    let ctx    = Conduit.WorkflowContext.new(base64_encode(random_bytes(16)))
    let result = Conduit.WorkflowRegistry.run(wf_type, "{}", ctx)
    assert_ok(result)
    assert_eq_bool(Vault.get(vault_k, "ran") |> unwrap_or(false), true)
  end

  test "workflow_registry_run_returns_failed_for_unregistered" do
    let ctx    = Conduit.WorkflowContext.new(base64_encode(random_bytes(16)))
    let result = Conduit.WorkflowRegistry.run("__no_such_wf__", "{}", ctx)
    assert_err(result)
  end

  -- ─────────────────────────────────────────────────────────────
  -- Phase 4: WorkflowConfig and WorkflowError
  -- ─────────────────────────────────────────────────────────────

  test "workflow_config_default_is_checkpoint_mode" do
    let cfg = Conduit.WorkflowConfig.default()
    match cfg.execution_mode do
      Checkpoint -> assert_true(true)
      _                                -> assert_true(false)
    end
    assert_none(cfg.timeout)
  end

  test "workflow_error_failed_carries_message" do
    let e = Conduit.Failed("something broke")
    match e do
      Conduit.Failed(msg) -> assert_eq_str(msg, "something broke")
      _                   -> assert_true(false)
    end
  end

  test "workflow_error_cancelled_carries_reason" do
    let e = Conduit.Cancelled("user request")
    match e do
      Conduit.Cancelled(r) -> assert_eq_str(r, "user request")
      _                    -> assert_true(false)
    end
  end

  test "workflow_error_timed_out_has_no_payload" do
    let e = Conduit.TimedOut
    match e do
      Conduit.TimedOut -> assert_true(true)
      _                -> assert_true(false)
    end
  end

  test "workflow_error_storage_error_carries_message" do
    let e = Conduit.StorageError("db unreachable")
    match e do
      Conduit.StorageError(m) -> assert_eq_str(m, "db unreachable")
      _                       -> assert_true(false)
    end
  end

  -- ─────────────────────────────────────────────────────────────
  -- Phase 4: WorkflowRunner
  -- ─────────────────────────────────────────────────────────────

  test "workflow_runner_job_type_is_correct" do
    assert_eq_str(Conduit.WorkflowRunner.job_type(), "conduit.workflow_runner")
  end

  test "workflow_runner_discards_on_empty_workflow_id" do
    -- A payload with no workflow_id should result in Discard (not Retry).
    let storage = fake_workflow_storage_new("runner_test_" ++ base64_encode(random_bytes(16)))
    let result  = Conduit.WorkflowRunner.execute(storage, "{}")
    assert_err(result)
    match result do
      Err(Conduit.Discard(_)) -> assert_true(true)
      _                            -> assert_true(false)
    end
  end

  test "workflow_runner_discards_on_unknown_workflow_id" do
    -- Payload has a valid workflow_id format but the workflow doesn't exist in storage.
    let vault_k = "runner_unk_" ++ base64_encode(random_bytes(16))
    let storage = fake_workflow_storage_new(vault_k)
    let payload = "{\"workflow_id\": \"" ++ base64_encode(random_bytes(16)) ++ "\"}"
    let result  = Conduit.WorkflowRunner.execute(storage, payload)
    assert_err(result)
    match result do
      Err(Conduit.Discard(_)) -> assert_true(true)
      _                            -> assert_true(false)
    end
  end

  -- ─────────────────────────────────────────────────────────────
  -- Phase 4: Fake workflow storage helpers
  -- ─────────────────────────────────────────────────────────────

  -- A fake storage that supports checkpoint_get/checkpoint_set/workflow_load,
  -- with all other methods delegating to the in-memory job storage.
  -- vault_key is used to isolate state between tests.

  pfn fake_workflow_storage_new(vault_key_name : String) : FakeWorkflowStorage do
    let vault_key = Vault.new(vault_key_name)
    Vault.set(vault_key, "checkpoints", Nil)
    { vault_key: vault_key_name, error: None }
  end

  pfn fake_workflow_storage_with_error(error_msg : String) : FakeWorkflowStorage do
    let key = "fake_err_" ++ base64_encode(random_bytes(16))
    { vault_key: key, error: Some(error_msg) }
  end

  -- ─────────────────────────────────────────────────────────────
  -- Phase 5: Config and NodeInfo
  -- ─────────────────────────────────────────────────────────────

  test "config_default_has_node_fields" do
    let cfg = Conduit.Config.default()
    assert_true(not (String.is_empty(cfg.node_id)))
    assert_eq_int(cfg.heartbeat_interval_ms, 15000)
    assert_eq_int(cfg.stale_node_threshold_ms, 60000)
  end

  test "config_default_generates_unique_node_ids" do
    let cfg1 = Conduit.Config.default()
    let cfg2 = Conduit.Config.default()
    -- Each call to default() generates a fresh base64_encode(random_bytes(16))
    assert_true(cfg1.node_id != cfg2.node_id)
  end

  test "node_info_fields" do
    let now = DateTime.from_timestamp(DateTime.now())
    let node : Conduit.NodeInfo = {
      id: "node-abc",
      hostname: "web-1",
      pid: 42,
      queues: Cons("default", Nil),
      pool_size: 5,
      started_at: now,
      last_seen_at: now,
      status: "running"
    }
    assert_eq_str(node.id, "node-abc")
    assert_eq_str(node.hostname, "web-1")
    assert_eq_int(node.pid, 42)
    assert_eq_int(node.pool_size, 5)
    assert_eq_str(node.status, "running")
  end

  -- ─────────────────────────────────────────────────────────────
  -- Phase 5: Conduit.Node — Vault-based state
  -- ─────────────────────────────────────────────────────────────

  test "node_is_leader_false_by_default" do
    -- Before any election tick, is_leader() should be false.
    -- The Vault entry may not exist yet; default is false.
    let result = Conduit.Node.is_leader()
    assert_eq_bool(result, false)
  end

  test "node_leader_node_id_none_by_default" do
    -- Before any election tick, leader_node_id() is None.
    -- We test with a fresh key to avoid cross-test pollution.
    -- The function reads from Vault("conduit_cluster", "leader_node_id").
    -- Since we haven't run an election yet in this test, it may be None or
    -- a value from a prior test. We just verify the function returns an Option.
    let result = Conduit.Node.leader_node_id()
    -- Just assert this call doesn't crash — value depends on prior test state.
    let _ = result
    assert_true(true)
  end

  test "node_stop_clears_leader_flag" do
    -- Manually set is_leader to true, then call stop() and verify it's cleared.
    let cluster_tbl = Vault.new("conduit_cluster")
    Vault.set(cluster_tbl, "is_leader", true)
    let vault_k  = "stop_test_" ++ base64_encode(random_bytes(16))
    let storage  = fake_workflow_storage_new(vault_k)
    let node_id  = base64_encode(random_bytes(16))
    Conduit.Node.stop(storage, node_id)
    assert_eq_bool(Vault.get(cluster_tbl, "is_leader") |> unwrap_or(true), false)
  end

  -- ─────────────────────────────────────────────────────────────
  -- Phase 5: Node storage operations (via fake storage)
  -- ─────────────────────────────────────────────────────────────

  test "node_register_stores_node_info" do
    let vault_k = "node_reg_" ++ base64_encode(random_bytes(16))
    let storage = fake_workflow_storage_new(vault_k)
    let now     = DateTime.from_timestamp(DateTime.now())
    let node : Conduit.NodeInfo = {
      id: base64_encode(random_bytes(16)),
      hostname: "test-host",
      pid: 1,
      queues: Cons("default", Nil),
      pool_size: 2,
      started_at: now,
      last_seen_at: now,
      status: "running"
    }
    let result = Conduit.Storage.node_register(storage, node)
    assert_ok(result)
    let nodes_result = Conduit.Storage.node_list_active(storage)
    assert_ok(nodes_result)
    match nodes_result do
      Err(_)    -> assert_true(false)
      Ok(nodes) -> assert_eq_int(List.length(nodes), 1)
    end
  end

  test "node_reclaim_jobs_returns_empty_when_no_stale" do
    let vault_k = "reclaim_" ++ base64_encode(random_bytes(16))
    let storage = fake_workflow_storage_new(vault_k)
    let result  = Conduit.Storage.node_reclaim_jobs(storage, 60)
    assert_ok(result)
    match result do
      Err(_)    -> assert_true(false)
      Ok(ids)   -> assert_eq_int(List.length(ids), 0)
    end
  end

  test "node_cleanup_stale_returns_zero_when_no_stale" do
    let vault_k = "cleanup_" ++ base64_encode(random_bytes(16))
    let storage = fake_workflow_storage_new(vault_k)
    let result  = Conduit.Storage.node_cleanup_stale(storage, 60)
    assert_ok(result)
    match result do
      Err(_)  -> assert_true(false)
      Ok(cnt) -> assert_eq_int(cnt, 0)
    end
  end

  test "node_leader_lock_acquired_on_first_call" do
    let vault_k = "leader_lock_" ++ base64_encode(random_bytes(16))
    let storage = fake_workflow_storage_new(vault_k)
    let result  = Conduit.Storage.node_try_leader_lock(storage, 8473625)
    assert_ok(result)
    match result do
      Err(_)     -> assert_true(false)
      Ok(acquired) -> assert_eq_bool(acquired, true)
    end
  end

  test "node_leader_lock_not_acquired_if_held" do
    let vault_k = "leader_lock2_" ++ base64_encode(random_bytes(16))
    let storage = fake_workflow_storage_new(vault_k)
    -- First call acquires
    let _ = Conduit.Storage.node_try_leader_lock(storage, 8473625)
    -- Second call should fail
    let result = Conduit.Storage.node_try_leader_lock(storage, 8473625)
    assert_ok(result)
    match result do
      Err(_)       -> assert_true(false)
      Ok(acquired) -> assert_eq_bool(acquired, false)
    end
  end

  test "node_leader_lock_released_and_reacquired" do
    let vault_k = "leader_lock3_" ++ base64_encode(random_bytes(16))
    let storage = fake_workflow_storage_new(vault_k)
    -- Acquire
    let _ = Conduit.Storage.node_try_leader_lock(storage, 8473625)
    -- Release
    let _ = Conduit.Storage.node_release_leader_lock(storage, 8473625)
    -- Re-acquire should succeed
    let result = Conduit.Storage.node_try_leader_lock(storage, 8473625)
    assert_ok(result)
    match result do
      Err(_)       -> assert_true(false)
      Ok(acquired) -> assert_eq_bool(acquired, true)
    end
  end

  -- ─────────────────────────────────────────────────────────────
  -- Phase 6: Dashboard types
  -- ─────────────────────────────────────────────────────────────

  test "queue_summary_type_fields" do
    let qs : Conduit.Dashboard.QueueSummary = {
      queue: "default",
      pending: 10,
      running: 2,
      failed: 1,
      dead: 0,
      throughput: 500,
      avg_latency: 42
    }
    assert_eq_str(qs.queue, "default")
    assert_eq_int(qs.pending, 10)
    assert_eq_int(qs.running, 2)
    assert_eq_int(qs.failed, 1)
    assert_eq_int(qs.dead, 0)
    assert_eq_int(qs.throughput, 500)
    assert_eq_int(qs.avg_latency, 42)
  end

  -- ─────────────────────────────────────────────────────────────
  -- Phase 6: Auth
  -- ─────────────────────────────────────────────────────────────

  test "dashboard_auth_none_always_allows" do
    let auth = Conduit.Open
    -- Auth.Open returns true without inspecting conn.
    -- We simulate a no-op conn check by inspecting the type directly.
    match auth do
      Open -> assert_true(true)
      _    -> assert_true(false)
    end
  end

  test "dashboard_auth_token_matches_correct_bearer" do
    let auth  = Conduit.Token("secret123")
    match auth do
      Token(t) -> assert_eq_str(t, "secret123")
      _                               -> assert_true(false)
    end
  end

  test "dashboard_auth_fn_wraps_predicate" do
    let called_key = Vault.new("auth_fn_" ++ base64_encode(random_bytes(16)))
    Vault.set(called_key, "called", false)
    let auth_fn = fn _header ->
      let _ = Vault.set(called_key, "called", true)
      true
    let auth = Conduit.Fn(auth_fn)
    match auth do
      Fn(f) ->
        let result = f("Bearer test")
        assert_eq_bool(result, true)
        assert_eq_bool(Vault.get(called_key, "called") |> unwrap_or(false), true)
      _ -> assert_true(false)
    end
  end

  -- ─────────────────────────────────────────────────────────────
  -- Phase 6: Actions via fake storage
  -- ─────────────────────────────────────────────────────────────

  test "dashboard_actions_retry_job_calls_storage" do
    let vault_k = "action_retry_" ++ base64_encode(random_bytes(16))
    let storage = fake_workflow_storage_new(vault_k)
    let job_id  = base64_encode(random_bytes(16))
    let result  = Conduit.Dashboard.Actions.retry_job(storage, job_id)
    assert_ok(result)
    let evs = Vault.get(pfake_tbl(vault_k), "events") |> unwrap_or(Nil)
    assert_true(List.any(evs, fn e -> String.starts_with(e, "job_retry:" ++ job_id)))
  end

  test "dashboard_actions_cancel_job_calls_storage" do
    let vault_k = "action_cancel_" ++ base64_encode(random_bytes(16))
    let storage = fake_workflow_storage_new(vault_k)
    let job_id  = base64_encode(random_bytes(16))
    let result  = Conduit.Dashboard.Actions.cancel_job(storage, job_id)
    assert_ok(result)
    let evs = Vault.get(pfake_tbl(vault_k), "events") |> unwrap_or(Nil)
    assert_true(List.any(evs, fn e -> String.starts_with(e, "job_cancel:" ++ job_id)))
  end

  test "dashboard_actions_delete_job_calls_storage" do
    let vault_k = "action_delete_" ++ base64_encode(random_bytes(16))
    let storage = fake_workflow_storage_new(vault_k)
    let job_id  = base64_encode(random_bytes(16))
    let result  = Conduit.Dashboard.Actions.delete_job(storage, job_id)
    assert_ok(result)
    let evs = Vault.get(pfake_tbl(vault_k), "events") |> unwrap_or(Nil)
    assert_true(List.any(evs, fn e -> String.starts_with(e, "job_delete:" ++ job_id)))
  end

  test "dashboard_actions_retry_dead_letter_not_found" do
    let vault_k = "dl_retry_nf_" ++ base64_encode(random_bytes(16))
    let storage = fake_workflow_storage_new(vault_k)
    -- Fake storage returns None for dead_letter_load, so we get Err.
    let result = Conduit.Dashboard.Actions.retry_dead_letter(storage, "nonexistent")
    assert_err(result)
  end

  test "dashboard_actions_delete_dead_letter_records_event" do
    let vault_k = "dl_delete_" ++ base64_encode(random_bytes(16))
    let storage = fake_workflow_storage_new(vault_k)
    let dl_id   = base64_encode(random_bytes(16))
    let result  = Conduit.Dashboard.Actions.delete_dead_letter(storage, dl_id)
    assert_ok(result)
    let evs = Vault.get(pfake_tbl(vault_k), "events") |> unwrap_or(Nil)
    assert_true(List.any(evs, fn e -> String.starts_with(e, "dl_delete:" ++ dl_id)))
  end

  test "dashboard_actions_trigger_cron_now_not_found" do
    let vault_k = "tc_now_" ++ base64_encode(random_bytes(16))
    let storage = fake_workflow_storage_new(vault_k)
    -- cron_load_by_id returns Ok(None), so we get Err("cron schedule not found").
    let result = Conduit.Dashboard.Actions.trigger_cron_now(storage, "nonexistent")
    assert_err(result)
  end

  test "dashboard_actions_retry_all_dead_letters_empty" do
    let vault_k = "radl_" ++ base64_encode(random_bytes(16))
    let storage = fake_workflow_storage_new(vault_k)
    -- dead_letter_list returns Ok(Nil), so result should be empty.
    let result = Conduit.Dashboard.Actions.retry_all_dead_letters(storage)
    assert_eq_int(List.length(result), 0)
  end

  -- ─────────────────────────────────────────────────────────────
  -- Phase 6: Queries via fake storage
