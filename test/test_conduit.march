  fn test_dashboard_queries_queue_summary_returns_list() do
    let vault_k = "qs_test_" ++ uuid_v4()
    let storage = fake_workflow_storage_new(vault_k)
    -- Seed a summary row in the fake storage
    let qs : Conduit.Dashboard.QueueSummary = {
      queue = "default", pending = 3, running = 1,
      failed = 0, dead = 0, throughput = 10, avg_latency = 50
    }
    Vault.set(vault_k, "queue_summary", Cons(qs, Nil))
    let result = Conduit.Dashboard.Queries.queue_summary(storage)
    assert_eq_int(List.length(result), 1)
    let first = List.head_opt(result) |> unwrap
    assert_eq_str(first.queue, "default")
    assert_eq_int(first.pending, 3)
  end

