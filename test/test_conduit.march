  test "unique_release_records_event" do
    let vault_k = "unique_rel_" ++ base64_encode(random_bytes(16))
    let storage = fake_workflow_storage_new(vault_k)
    let job_id  = base64_encode(random_bytes(16))
    let result  = Conduit.Unique.release(storage, job_id)
    assert_ok(result)
    let evs = Vault.get(pfake_tbl(vault_k), "events") |> unwrap_or(Nil)
