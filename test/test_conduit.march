  -- =========================================================================
  -- Stage 1: Queue control — pause / resume
  -- =========================================================================

  test "queue_control: queue not paused by default" do
    assert_true(Conduit.QueueControl.is_paused("__s1_default__") == false)
  end

  test "queue_control: pause sets flag" do
    let q = "s1_pause_q"
    Conduit.QueueControl.pause(q)
    assert_true(Conduit.QueueControl.is_paused(q))
    Conduit.QueueControl.resume(q)
  end

  test "queue_control: resume clears flag" do
    let q = "s1_resume_q"
    Conduit.QueueControl.pause(q)
    Conduit.QueueControl.resume(q)
    assert_true(Conduit.QueueControl.is_paused(q) == false)
  end

  test "queue_control: pause is per-queue" do
    let qa = "s1_qa"
    let qb = "s1_qb"
    Conduit.QueueControl.pause(qa)
    assert_true(Conduit.QueueControl.is_paused(qa))
    assert_true(Conduit.QueueControl.is_paused(qb) == false)
    Conduit.QueueControl.resume(qa)
  end

  -- =========================================================================
  -- Stage 1: Bulk enqueue
  -- =========================================================================

  test "enqueue_all: empty list returns empty results" do
    let storage = fake_workflow_storage_new("stage1_" ++ base64_encode(random_bytes(16)))
    let results = Conduit.Queue.enqueue_all(storage, Nil)
    assert_eq_int(List.length(results), 0)
  end

  test "enqueue_all: two items returns two results" do
    let storage = fake_workflow_storage_new("stage1_" ++ base64_encode(random_bytes(16)))
    let cfg = Conduit.JobConfig.default()
    let items = Cons(("TypeA", "{}", cfg), Cons(("TypeB", "{}", cfg), Nil))
    let results = Conduit.Queue.enqueue_all(storage, items)
    assert_eq_int(List.length(results), 2)
  end

  test "enqueue_all: all results are Ok" do
    let storage = fake_workflow_storage_new("stage1_" ++ base64_encode(random_bytes(16)))
    let cfg = Conduit.JobConfig.default()
    let items = Cons(("TypeA", "{}", cfg), Cons(("TypeB", "{}", cfg), Nil))
    let results = Conduit.Queue.enqueue_all(storage, items)
    assert_true(List.all(results, fn r ->
      match r do
        Ok(_)  -> true
        Err(_) -> false
      end
    ))
  end

