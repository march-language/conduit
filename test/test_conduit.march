  test "event_store_append_and_load" do
    let vault_k = "es_al_" ++ base64_encode(random_bytes(16))
    let storage = fake_workflow_storage_new(vault_k)
    let wf_id   = base64_encode(random_bytes(16))
    -- Append two events
    let r1 = Conduit.EventStore.append(storage, wf_id, 0, "checkpoint", "{\"name\":\"a\",\"value\":\"1\"}")
    assert_ok(r1)
    let r2 = Conduit.EventStore.append(storage, wf_id, 1, "checkpoint", "{\"name\":\"b\",\"value\":\"2\"}")
    assert_ok(r2)
    -- Load all
    let all = Conduit.EventStore.load_all(storage, wf_id)
    assert_ok(all)
    match all do
      Err(_)    -> assert_true(false)
      Ok(evts)  ->
        assert_eq_int(List.length(evts), 2)
        let first = List.head_opt(evts) |> unwrap
        assert_eq_int(first.sequence, 0)
        assert_eq_str(first.event_type, "checkpoint")
    end
  end

  test "event_store_load_up_to" do
    let vault_k = "es_lu_" ++ base64_encode(random_bytes(16))
    let storage = fake_workflow_storage_new(vault_k)
    let wf_id   = base64_encode(random_bytes(16))
    let _ = Conduit.EventStore.append(storage, wf_id, 0, "checkpoint", "{}")
    let _ = Conduit.EventStore.append(storage, wf_id, 1, "checkpoint", "{}")
    let _ = Conduit.EventStore.append(storage, wf_id, 2, "checkpoint", "{}")
    -- Load up to sequence 1
    let result = Conduit.EventStore.load_up_to(storage, wf_id, 1)
    assert_ok(result)
    match result do
      Err(_)   -> assert_true(false)
      Ok(evts) -> assert_eq_int(List.length(evts), 2)  -- sequences 0 and 1
    end
  end

  test "event_store_count" do
    let vault_k = "es_cnt_" ++ base64_encode(random_bytes(16))
    let storage = fake_workflow_storage_new(vault_k)
    let wf_id   = base64_encode(random_bytes(16))
    let _ = Conduit.EventStore.append(storage, wf_id, 0, "checkpoint", "{}")
    let _ = Conduit.EventStore.append(storage, wf_id, 1, "checkpoint", "{}")
    let result = Conduit.EventStore.count(storage, wf_id)
    assert_ok(result)
