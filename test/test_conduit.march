  -- ─────────────────────────────────────────────────────────────
  -- Phase 8: warm_replay sets Vault state
  -- ─────────────────────────────────────────────────────────────

  test "replay_warm_sets_vault_state" do
    let vault_k = "rw_warm_" ++ base64_encode(random_bytes(16))
    let storage = fake_workflow_storage_new(vault_k)
    let wf_id   = base64_encode(random_bytes(16))
    -- Append 2 events to the fake store
    let _ = Conduit.EventStore.append(storage, wf_id, 0, "checkpoint", "{\"name\":\"s1\",\"value\":\"v1\"}")
    let _ = Conduit.EventStore.append(storage, wf_id, 1, "checkpoint", "{\"name\":\"s2\",\"value\":\"v2\"}")
    -- Warm replay
    let result = Conduit.EventStore.warm_replay(storage, wf_id)
    assert_ok(result)
    -- Check Vault state
    let rk = Conduit.EventStore.replay_key(wf_id)
    let mode = Vault.get(rk, "mode") |> unwrap_or("")
    assert_eq_str(mode, "deterministic_replay")
    let cursor = Vault.get(rk, "cursor") |> unwrap_or(-1)
    assert_eq_int(cursor, 0)
    let event_count = Vault.get(rk, "event_count") |> unwrap_or(-1)
    assert_eq_int(event_count, 2)
  end

  -- ─────────────────────────────────────────────────────────────
  -- Phase 8: Replay checkpoint behavior
  -- ─────────────────────────────────────────────────────────────

  test "replay_checkpoint_first_run_logs_events" do
    -- When no events exist, checkpoint should execute fn AND append an event.
    let vault_k = "rp_fr_" ++ base64_encode(random_bytes(16))
    let storage = fake_workflow_storage_new(vault_k)
    let wf_id   = base64_encode(random_bytes(16))
    let ctx     = Conduit.WorkflowContext.new(wf_id)
    -- Set up replay mode with 0 pre-existing events
    let rk = Conduit.EventStore.replay_key(wf_id)
    Vault.set(rk, "mode", "deterministic_replay")
    Vault.set(rk, "cursor", 0)
    Vault.set(rk, "event_count", 0)
    Vault.set(rk, "next_seq", 0)
    -- Track fn calls
    let call_key = Vault.new("rp_fr_calls_" ++ base64_encode(random_bytes(16)))
    Vault.set(call_key, "count", 0)
    -- Run checkpoint
    let cp_fn = fn () ->
      let c = Vault.get(call_key, "count") |> unwrap_or(0)
      let _ = Vault.set(call_key, "count", c + 1)
      "\"result_a\""
    let result = Conduit.WorkflowContext.checkpoint(storage, ctx, "step1", cp_fn)
    assert_ok(result)
    match result do
      Err(_)  -> assert_true(false)
      Ok(val) -> assert_eq_str(val, "\"result_a\"")
    end
    -- fn was called
    assert_eq_int(Vault.get(call_key, "count") |> unwrap_or(0), 1)
    -- An event was appended
    let cnt = Conduit.EventStore.count(storage, wf_id)
    match cnt do
      Ok(n) -> assert_eq_int(n, 1)
      Err(_) -> assert_true(false)
    end
  end

  test "replay_checkpoint_replay_skips_fn" do
    -- When events exist, checkpoint should return recorded value WITHOUT calling fn.
    let vault_k = "rp_skip_" ++ base64_encode(random_bytes(16))
    let storage = fake_workflow_storage_new(vault_k)
    let wf_id   = base64_encode(random_bytes(16))
    let ctx     = Conduit.WorkflowContext.new(wf_id)
    -- Pre-append an event via storage
    let _ = Conduit.EventStore.append(storage, wf_id, 0, "checkpoint", "{\"name\":\"step1\",\"value\":\"recorded_val\"}")
    -- Warm replay (loads events into Vault)
    let _ = Conduit.EventStore.warm_replay(storage, wf_id)
    -- Track fn calls
    let call_key = Vault.new("rp_skip_calls_" ++ base64_encode(random_bytes(16)))
    Vault.set(call_key, "called", false)
    -- Run checkpoint
    let cp_fn = fn () ->
      let _ = Vault.set(call_key, "called", true)
      "\"should_not_be_used\""
    let result = Conduit.WorkflowContext.checkpoint(storage, ctx, "step1", cp_fn)
    assert_ok(result)
    match result do
      Err(_)  -> assert_true(false)
      Ok(val) -> assert_eq_str(val, "recorded_val")
    end
    -- fn was NOT called
    assert_eq_bool(Vault.get(call_key, "called") |> unwrap_or(true), false)
  end

  test "replay_checkpoint_mixed_replay_and_new" do
    -- 1 event pre-loaded, then a 2nd checkpoint should execute fn.
    let vault_k = "rp_mix_" ++ base64_encode(random_bytes(16))
    let storage = fake_workflow_storage_new(vault_k)
    let wf_id   = base64_encode(random_bytes(16))
    let ctx     = Conduit.WorkflowContext.new(wf_id)
    -- Pre-append 1 event
    let _ = Conduit.EventStore.append(storage, wf_id, 0, "checkpoint", "{\"name\":\"step1\",\"value\":\"val_a\"}")
    let _ = Conduit.EventStore.warm_replay(storage, wf_id)
    -- First checkpoint: should replay from event (skip fn)
    let r1 = Conduit.WorkflowContext.checkpoint(storage, ctx, "step1", fn () -> "\"unused\"")
    assert_ok(r1)
    match r1 do
      Ok(v) -> assert_eq_str(v, "val_a")
      Err(_) -> assert_true(false)
    end
    -- Second checkpoint: no event, should execute fn
    let call_key = Vault.new("rp_mix_fn_" ++ base64_encode(random_bytes(16)))
    Vault.set(call_key, "called", false)
    let cp_fn2 = fn () ->
      let _ = Vault.set(call_key, "called", true)
      "\"val_b\""
    let r2 = Conduit.WorkflowContext.checkpoint(storage, ctx, "step2", cp_fn2)
    assert_ok(r2)
    match r2 do
      Ok(v) -> assert_eq_str(v, "\"val_b\"")
      Err(_) -> assert_true(false)
    end
    assert_eq_bool(Vault.get(call_key, "called") |> unwrap_or(false), true)
  end

  test "replay_cursor_advances" do
    -- After 3 checkpoints, cursor should be 3.
    let vault_k = "rp_cur_" ++ base64_encode(random_bytes(16))
    let storage = fake_workflow_storage_new(vault_k)
    let wf_id   = base64_encode(random_bytes(16))
    let ctx     = Conduit.WorkflowContext.new(wf_id)
    -- Pre-append 3 events
    let _ = Conduit.EventStore.append(storage, wf_id, 0, "checkpoint", "{\"name\":\"a\",\"value\":\"1\"}")
    let _ = Conduit.EventStore.append(storage, wf_id, 1, "checkpoint", "{\"name\":\"b\",\"value\":\"2\"}")
    let _ = Conduit.EventStore.append(storage, wf_id, 2, "checkpoint", "{\"name\":\"c\",\"value\":\"3\"}")
    let _ = Conduit.EventStore.warm_replay(storage, wf_id)
    -- Run 3 checkpoints
    let _ = Conduit.WorkflowContext.checkpoint(storage, ctx, "a", fn () -> "x")
    let _ = Conduit.WorkflowContext.checkpoint(storage, ctx, "b", fn () -> "x")
    let _ = Conduit.WorkflowContext.checkpoint(storage, ctx, "c", fn () -> "x")
    -- Cursor should be 3
    let rk = Conduit.EventStore.replay_key(wf_id)
    let cursor = Vault.get(rk, "cursor") |> unwrap_or(-1)
    assert_eq_int(cursor, 3)
  end

  test "replay_preserves_order" do
    -- Events should be replayed in sequence order: "first", "second", "third"
    let vault_k = "rp_ord_" ++ base64_encode(random_bytes(16))
    let storage = fake_workflow_storage_new(vault_k)
    let wf_id   = base64_encode(random_bytes(16))
    let ctx     = Conduit.WorkflowContext.new(wf_id)
    let _ = Conduit.EventStore.append(storage, wf_id, 0, "checkpoint", "{\"name\":\"s1\",\"value\":\"first\"}")
    let _ = Conduit.EventStore.append(storage, wf_id, 1, "checkpoint", "{\"name\":\"s2\",\"value\":\"second\"}")
    let _ = Conduit.EventStore.append(storage, wf_id, 2, "checkpoint", "{\"name\":\"s3\",\"value\":\"third\"}")
    let _ = Conduit.EventStore.warm_replay(storage, wf_id)
    let r1 = Conduit.WorkflowContext.checkpoint(storage, ctx, "s1", fn () -> "x")
    let r2 = Conduit.WorkflowContext.checkpoint(storage, ctx, "s2", fn () -> "x")
    let r3 = Conduit.WorkflowContext.checkpoint(storage, ctx, "s3", fn () -> "x")
    match r1 do Ok(v) -> assert_eq_str(v, "first") | Err(_) -> assert_true(false) end
    match r2 do Ok(v) -> assert_eq_str(v, "second") | Err(_) -> assert_true(false) end
    match r3 do Ok(v) -> assert_eq_str(v, "third") | Err(_) -> assert_true(false) end
  end

  test "point_in_time_replay" do
    -- load_up_to(1) should return sequences 0 and 1 only.
    let vault_k = "pit_" ++ base64_encode(random_bytes(16))
    let storage = fake_workflow_storage_new(vault_k)
    let wf_id   = base64_encode(random_bytes(16))
    let _ = Conduit.EventStore.append(storage, wf_id, 0, "checkpoint", "{}")
    let _ = Conduit.EventStore.append(storage, wf_id, 1, "checkpoint", "{}")
    let _ = Conduit.EventStore.append(storage, wf_id, 2, "checkpoint", "{}")
    -- warm_replay_to loads only first 2 events (up to sequence 1)
    let result = Conduit.EventStore.warm_replay_to(storage, wf_id, 1)
    assert_ok(result)
    let rk = Conduit.EventStore.replay_key(wf_id)
    let event_count = Vault.get(rk, "event_count") |> unwrap_or(-1)
    assert_eq_int(event_count, 2)
  end

  test "replay_with_parallel" do
    -- Parallel branches should log events with namespaced names.
    let vault_k = "rp_par_" ++ base64_encode(random_bytes(16))
    let storage = fake_workflow_storage_new(vault_k)
    let wf_id   = base64_encode(random_bytes(16))
    let ctx     = Conduit.WorkflowContext.new(wf_id)
    -- Set replay mode with 0 events (first run)
    let rk = Conduit.EventStore.replay_key(wf_id)
    Vault.set(rk, "mode", "deterministic_replay")
    Vault.set(rk, "cursor", 0)
    Vault.set(rk, "event_count", 0)
    Vault.set(rk, "next_seq", 0)
    -- Execute 2 checkpoints in parallel sub-contexts
    let branch0 = Conduit.WorkflowContext.child(ctx, "parallel:0:")
    let branch1 = Conduit.WorkflowContext.child(ctx, "parallel:1:")
    let _ = Conduit.WorkflowContext.checkpoint(storage, branch0, "step", fn () -> "\"r0\"")
    let _ = Conduit.WorkflowContext.checkpoint(storage, branch1, "step", fn () -> "\"r1\"")
    -- Should have 2 events logged
    let cnt = Conduit.EventStore.count(storage, wf_id)
    match cnt do
      Ok(n) -> assert_eq_int(n, 2)
      Err(_) -> assert_true(false)
    end
    -- The events should have different names (namespaced)
    let all = Conduit.EventStore.load_all(storage, wf_id)
    match all do
      Ok(evts) ->
        let first = List.head_opt(evts) |> unwrap
        assert_true(String.contains(first.payload, "parallel:0:step"))
      Err(_) -> assert_true(false)
    end
  end

  -- ─────────────────────────────────────────────────────────────
  -- Bug-fix regression tests
  -- ─────────────────────────────────────────────────────────────

  -- Backoff: Fibonacci is now iterative (no stack overflow for large attempts)
  test "backoff_fibonacci_large_attempt_is_capped" do
    -- fib(40) * 1000 would be enormous; after the cap it should equal 24h.
    let delay = Conduit.Backoff.delay(Conduit.Backoff.fibonacci, 40)
    assert_eq_int(delay, 86400000)  -- 24h cap
  end

  -- Backoff: Exponential is capped at 24h
  test "backoff_exponential_large_attempt_is_capped" do
    let delay = Conduit.Backoff.delay(Conduit.Backoff.exponential, 30)
    assert_eq_int(delay, 86400000)  -- 24h cap
  end

  -- Backoff: Fibonacci produces correct sequence for small n
  test "backoff_fibonacci_sequence" do
    -- fib(1)=1, fib(2)=1, fib(3)=2, fib(4)=3, fib(5)=5
    assert_eq_int(Conduit.Backoff.delay(Conduit.Backoff.fibonacci, 1), 1000)
    assert_eq_int(Conduit.Backoff.delay(Conduit.Backoff.fibonacci, 2), 1000)
    assert_eq_int(Conduit.Backoff.delay(Conduit.Backoff.fibonacci, 3), 2000)
    assert_eq_int(Conduit.Backoff.delay(Conduit.Backoff.fibonacci, 4), 3000)
    assert_eq_int(Conduit.Backoff.delay(Conduit.Backoff.fibonacci, 5), 5000)
  end

  -- CronRegistry.all() returns registered entries via Vault.keys
  test "cron_registry_all_returns_registered_entries" do
    let cron_a = "AllTestA_" ++ base64_encode(random_bytes(16))
    let cron_b = "AllTestB_" ++ base64_encode(random_bytes(16))
    Conduit.CronRegistry.register(cron_a, Conduit.CronConfig.default(), fn _ -> Ok(()))
    Conduit.CronRegistry.register(cron_b, Conduit.CronConfig.default(), fn _ -> Ok(()))
    let all = Conduit.CronRegistry.all()
    -- Both should appear in the result
    let found_a = List.any(all, fn e -> e.cron_type == cron_a)
    let found_b = List.any(all, fn e -> e.cron_type == cron_b)
    assert_true(found_a)
    assert_true(found_b)
  end

  -- WorkflowRunner: pparse_workflow_id now uses Json.parse, not string splitting
  test "workflow_runner_parse_id_with_compact_json" do
    -- Old string-split code required space after colon: "workflow_id": "..."
    -- New Json.parse code handles compact JSON without spaces.
    let vault_k = "wr_parse_" ++ base64_encode(random_bytes(16))
    let storage = fake_workflow_storage_new(vault_k)
    -- Compact JSON (no space after colon, no space after key)
    let payload = "{\"workflow_id\":\"" ++ base64_encode(random_bytes(16)) ++ "\"}"
    let result  = Conduit.WorkflowRunner.execute(storage, payload)
    -- Storage returns None for workflow_load → Discard (not empty-id Discard)
    -- Both result in Err(Discard) but the message should not contain "missing"
    match result do
      Err(Conduit.Discard(msg)) ->
        -- Confirm we got past the empty-id check (id was parsed correctly)
        assert_true(not (String.contains(msg, "missing workflow_id")))
      _ -> assert_true(false)
    end
  end

