  -- cron_parser: pmatches works (was broken by Expr(e) pattern-match bug)
  test "cron_parser_matches_works" do
    -- The old code used `match expr do Expr(e) ->` which is invalid for a record
    -- type.  This test exercises the matches/2 path end-to-end.
    let expr_result = Conduit.CronParser.parse("* * * * *")
    assert_ok(expr_result)
    match expr_result do
      Err(_)   -> assert_true(false)
      Ok(expr) ->
        let any_dt = DateTime.from_timestamp(DateTime.now())
        -- "* * * * *" matches every minute — should always be true
        assert_true(Conduit.CronParser.matches(expr, any_dt))
    end
  end

  -- cron_parser: Expr(e) bug would make specific patterns fail
  test "cron_parser_matches_specific_minute" do
    -- "0 * * * *" matches only minute=0; at minute 30 it should be false.
    let expr_result = Conduit.CronParser.parse("0 * * * *")
    assert_ok(expr_result)
    match expr_result do
      Err(_)   -> assert_true(false)
      Ok(expr) ->
        -- Find a :00 minute datetime and a :30 minute datetime.
        let next_00 = Conduit.CronParser.next_run("0 * * * *", DateTime.from_timestamp(DateTime.now()))
        match next_00 do
          Err(_)   -> assert_true(false)
          Ok(at00) ->
            assert_true(Conduit.CronParser.matches(expr, at00))
            -- Advance 30 minutes — should NOT match "0 * * * *"
            let at30 = DateTime.from_timestamp(DateTime.to_timestamp(at00) + (30 * 60))
            assert_true(not (Conduit.CronParser.matches(expr, at30)))
        end
    end
  end

  -- ─────────────────────────────────────────────────────────────
  -- Phase 8: Deterministic workflow application tests
  -- (moved here from DeterministicAppTest to use FakeWorkflowStorage
  --  and avoid a second impl Conduit.Storage block)
  -- ─────────────────────────────────────────────────────────────

  pfn run_payment_workflow(storage : FakeWorkflowStorage, wf_id : String, call_tracker_key : String) : Result(String, WorkflowError) do
    let ctx = Conduit.WorkflowContext.new(wf_id)
    -- Resolve the call-tracker name to a Vault table handle (Vault.set/get
    -- require a handle, not a name; Vault.new is idempotent per name).
    let tracker = Vault.new(call_tracker_key)
    -- Step 1: Validate order
    let validate_fn = fn () ->
      let c = Vault.get(tracker, "validate_calls") |> unwrap_or(0)
      let _ = Vault.set(tracker, "validate_calls", c + 1)
      "\"order_valid\""
    let r1 = Conduit.WorkflowContext.checkpoint(storage, ctx, "validate_order", validate_fn)
    match r1 do
      Err(e) -> Err(e)
      Ok(v1) ->
        -- Step 2: Charge card
        let charge_fn = fn () ->
          let c = Vault.get(tracker, "charge_calls") |> unwrap_or(0)
          let _ = Vault.set(tracker, "charge_calls", c + 1)
          "\"charge_ch_abc123\""
        let r2 = Conduit.WorkflowContext.checkpoint(storage, ctx, "charge_card", charge_fn)
        match r2 do
          Err(e) -> Err(e)
          Ok(v2) ->
            -- Step 3: Send confirmation
            let confirm_fn = fn () ->
              let c = Vault.get(tracker, "confirm_calls") |> unwrap_or(0)
              let _ = Vault.set(tracker, "confirm_calls", c + 1)
              "\"email_sent\""
            let r3 = Conduit.WorkflowContext.checkpoint(storage, ctx, "send_confirmation", confirm_fn)
            match r3 do
              Err(e) -> Err(e)
              Ok(v3) ->
                Ok("{\"order\":\"" ++ v1 ++ "\",\"charge\":\"" ++ v2 ++ "\",\"confirm\":\"" ++ v3 ++ "\"}")
            end
        end
    end
  end

  test "first_run_executes_all_fns_and_logs_events" do
    let vault_k  = "det_app_" ++ base64_encode(random_bytes(16))
    let storage  = fake_workflow_storage_new(vault_k)
    let wf_id    = base64_encode(random_bytes(16))
    let call_key = "calls_first_" ++ base64_encode(random_bytes(16))
    let call_tbl = Vault.new(call_key)
    Vault.set(call_tbl, "validate_calls", 0)
    Vault.set(call_tbl, "charge_calls", 0)
    Vault.set(call_tbl, "confirm_calls", 0)
    -- Set up replay mode with 0 events (first execution)
    let rk = Conduit.EventStore.replay_key(wf_id)
    Vault.set(rk, "mode", "deterministic_replay")
    Vault.set(rk, "cursor", 0)
    Vault.set(rk, "event_count", 0)
    Vault.set(rk, "next_seq", 0)
    let result = run_payment_workflow(storage, wf_id, call_key)
    assert_ok(result)
    -- All 3 fns were called
    assert_eq_int(Vault.get(call_tbl, "validate_calls") |> unwrap_or(0), 1)
    assert_eq_int(Vault.get(call_tbl, "charge_calls") |> unwrap_or(0), 1)
    assert_eq_int(Vault.get(call_tbl, "confirm_calls") |> unwrap_or(0), 1)
    -- 3 events were logged
    let cnt = Conduit.EventStore.count(storage, wf_id)
    match cnt do
      Ok(n) -> assert_eq_int(n, 3)
      Err(_) -> assert_true(false)
    end
    -- Events are in correct order
    let events = Conduit.EventStore.load_all(storage, wf_id)
    match events do
      Ok(evts) ->
        assert_eq_int(List.length(evts), 3)
        let e0 = List.nth_opt(evts, 0) |> unwrap
        let e1 = List.nth_opt(evts, 1) |> unwrap
        let e2 = List.nth_opt(evts, 2) |> unwrap
        assert_eq_int(e0.sequence, 0)
        assert_eq_int(e1.sequence, 1)
        assert_eq_int(e2.sequence, 2)
        assert_true(String.contains(e0.payload, "validate_order"))
        assert_true(String.contains(e1.payload, "charge_card"))
        assert_true(String.contains(e2.payload, "send_confirmation"))
      Err(_) -> assert_true(false)
    end
  end

  test "replay_skips_all_fns_and_returns_recorded_values" do
    let vault_k  = "det_app_" ++ base64_encode(random_bytes(16))
    let storage  = fake_workflow_storage_new(vault_k)
    let wf_id    = base64_encode(random_bytes(16))
    -- Pre-populate 3 events (simulating a previous first run)
    let _ = Conduit.EventStore.append(storage, wf_id, 0, "checkpoint",
      "{\"name\":\"validate_order\",\"value\":\"order_valid\",\"duration_ms\":5}")
    let _ = Conduit.EventStore.append(storage, wf_id, 1, "checkpoint",
      "{\"name\":\"charge_card\",\"value\":\"charge_ch_abc123\",\"duration_ms\":100}")
    let _ = Conduit.EventStore.append(storage, wf_id, 2, "checkpoint",
      "{\"name\":\"send_confirmation\",\"value\":\"email_sent\",\"duration_ms\":10}")
    -- Warm replay
    let _ = Conduit.EventStore.warm_replay(storage, wf_id)
    -- Track calls
    let call_key = "calls_replay_" ++ base64_encode(random_bytes(16))
    let call_tbl = Vault.new(call_key)
    Vault.set(call_tbl, "validate_calls", 0)
    Vault.set(call_tbl, "charge_calls", 0)
    Vault.set(call_tbl, "confirm_calls", 0)
    let result = run_payment_workflow(storage, wf_id, call_key)
    assert_ok(result)
    -- NO fns were called (all replayed from events)
    assert_eq_int(Vault.get(call_tbl, "validate_calls") |> unwrap_or(-1), 0)
    assert_eq_int(Vault.get(call_tbl, "charge_calls") |> unwrap_or(-1), 0)
    assert_eq_int(Vault.get(call_tbl, "confirm_calls") |> unwrap_or(-1), 0)
    -- Values are correct (from recorded events)
    match result do
      Ok(output) ->
        assert_true(String.contains(output, "order_valid"))
        assert_true(String.contains(output, "charge_ch_abc123"))
        assert_true(String.contains(output, "email_sent"))
      Err(_) -> assert_true(false)
    end
  end

  test "point_in_time_replay_partial_events" do
    let vault_k  = "det_app_" ++ base64_encode(random_bytes(16))
    let storage  = fake_workflow_storage_new(vault_k)
    let wf_id    = base64_encode(random_bytes(16))
    -- Pre-populate 3 events
    let _ = Conduit.EventStore.append(storage, wf_id, 0, "checkpoint",
      "{\"name\":\"validate_order\",\"value\":\"order_valid\",\"duration_ms\":5}")
    let _ = Conduit.EventStore.append(storage, wf_id, 1, "checkpoint",
      "{\"name\":\"charge_card\",\"value\":\"charge_ch_abc123\",\"duration_ms\":100}")
    let _ = Conduit.EventStore.append(storage, wf_id, 2, "checkpoint",
      "{\"name\":\"send_confirmation\",\"value\":\"email_sent\",\"duration_ms\":10}")
    -- Warm replay to sequence 1 only (first 2 events: 0 and 1)
    let _ = Conduit.EventStore.warm_replay_to(storage, wf_id, 1)
    let call_key = "calls_pit_" ++ base64_encode(random_bytes(16))
    let call_tbl = Vault.new(call_key)
    Vault.set(call_tbl, "validate_calls", 0)
    Vault.set(call_tbl, "charge_calls", 0)
    Vault.set(call_tbl, "confirm_calls", 0)
    let result = run_payment_workflow(storage, wf_id, call_key)
    assert_ok(result)
    -- First 2 fns NOT called (replayed), 3rd fn IS called (no event)
    assert_eq_int(Vault.get(call_tbl, "validate_calls") |> unwrap_or(-1), 0)
    assert_eq_int(Vault.get(call_tbl, "charge_calls") |> unwrap_or(-1), 0)
    assert_eq_int(Vault.get(call_tbl, "confirm_calls") |> unwrap_or(-1), 1)
  end

  test "event_history_queryable" do
    let vault_k = "det_app_" ++ base64_encode(random_bytes(16))
    let storage = fake_workflow_storage_new(vault_k)
    let wf_id   = base64_encode(random_bytes(16))
    -- Run the workflow in first-execution mode
    let rk = Conduit.EventStore.replay_key(wf_id)
    Vault.set(rk, "mode", "deterministic_replay")
    Vault.set(rk, "cursor", 0)
    Vault.set(rk, "event_count", 0)
    Vault.set(rk, "next_seq", 0)
    let call_key = "calls_hist_" ++ base64_encode(random_bytes(16))
    let call_tbl = Vault.new(call_key)
    Vault.set(call_tbl, "validate_calls", 0)
    Vault.set(call_tbl, "charge_calls", 0)
    Vault.set(call_tbl, "confirm_calls", 0)
    let _ = run_payment_workflow(storage, wf_id, call_key)
    -- Query event history
    let history = Conduit.EventStore.load_all(storage, wf_id)
    match history do
      Ok(evts) ->
        assert_eq_int(List.length(evts), 3)
        -- All events are checkpoint type
        assert_true(List.all(evts, fn e -> e.event_type == "checkpoint"))
        -- Sequences are 0, 1, 2
        let seqs = List.map(evts, fn e -> e.sequence)
        assert_true(List.member(seqs, 0))
        assert_true(List.member(seqs, 1))
        assert_true(List.member(seqs, 2))
      Err(_) -> assert_true(false)
    end
  end

