  end

  -- Local wrappers that supply the empty message string required by
  -- the Test module's 3-argument assert signatures.  This avoids
  -- touching every call site in the test file.
  pfn assert_eq_int(a : Int, b : Int) : () do Test.assert_eq_int(a, b, "") end
  pfn assert_eq_str(a : String, b : String) : () do Test.assert_eq_str(a, b, "") end
  pfn assert_eq_bool(a : Bool, b : Bool) : () do Test.assert_eq_bool(a, b, "") end
  pfn assert_true(c : Bool) : () do Test.assert_true(c, "") end
  pfn assert_ok(r) : () do let _ = Test.assert_ok(r, "") end
  pfn assert_err(r) : () do let _ = Test.assert_err(r, "") end
  pfn assert_none(o) : () do Test.assert_none(o, "") end
  pfn assert_some(o) : () do let _ = Test.assert_some(o, "") end

  -- Return (or create) a VaultTable for the given vault_key string.
  -- Ensures idempotency: calling with the same name returns the same table.
  pfn pfake_tbl(vault_key : String) do
    match Vault.whereis(vault_key) do
      Some(tbl) -> tbl
      None      -> Vault.new(vault_key)
    end
  end

  -- ─────────────────────────────────────────────────────────────
  -- Fake in-memory storage for testing
  -- ─────────────────────────────────────────────────────────────

  -- A minimal fake storage implementation for unit tests.
  -- Uses a mutable Vault cell to track inserted rows and lifecycle events.
  pfn setup_fake_storage() do
    let key_name = "test_storage_" ++ base64_encode(random_bytes(16))
    let key = Vault.new(key_name)
    Vault.set(key, "jobs", Nil)
    Vault.set(key, "events", Nil)
    key
  end

  pfn fake_enqueue(key, job : Conduit.JobRow) : Result(String, String) do
    let jobs = Vault.get(key, "jobs") |> unwrap_or(Nil)
    Vault.set(key, "jobs", Cons(job, jobs))
    Ok(job.id)
  end

  pfn fake_mark_running(key, job_id : String, _worker_id : String) : Result((), String) do
    let ev = Cons("running:" ++ job_id, Vault.get(key, "events") |> unwrap_or(Nil))
    Vault.set(key, "events", ev)
    Ok(())
  end

  pfn fake_mark_completed(key, job_id : String) : Result((), String) do
    let ev = Cons("completed:" ++ job_id, Vault.get(key, "events") |> unwrap_or(Nil))
    Vault.set(key, "events", ev)
    Ok(())
  end

  pfn fake_mark_failed(key, job_id : String, msg : String) : Result((), String) do
    let ev = Cons("failed:" ++ job_id ++ ":" ++ msg, Vault.get(key, "events") |> unwrap_or(Nil))
    Vault.set(key, "events", ev)
    Ok(())
  end

  pfn events_contain(key, prefix : String) : Bool do
    let evs = Vault.get(key, "events") |> unwrap_or(Nil)
    List.any(evs, fn e -> String.starts_with(e, prefix))
  end

  pfn jobs_in_store(key) : List(Conduit.JobRow) do
    Vault.get(key, "jobs") |> unwrap_or(Nil)
  end

  -- ─────────────────────────────────────────────────────────────
  -- Backoff tests
  -- ─────────────────────────────────────────────────────────────

  test "backoff_linear" do
    let d1 = Conduit.Backoff.delay(Conduit.Backoff.linear_strat, 1)
    let d2 = Conduit.Backoff.delay(Conduit.Backoff.linear_strat, 2)
    let d3 = Conduit.Backoff.delay(Conduit.Backoff.linear_strat, 3)
    assert_eq_int(int_div(d1, 1000), 5)
    assert_eq_int(int_div(d2, 1000), 10)
    assert_eq_int(int_div(d3, 1000), 15)
  end

  test "backoff_exponential" do
    let d1 = Conduit.Backoff.delay(Conduit.Backoff.exponential, 1)
    let d2 = Conduit.Backoff.delay(Conduit.Backoff.exponential, 2)
    let d3 = Conduit.Backoff.delay(Conduit.Backoff.exponential, 3)
    assert_eq_int(int_div(d1, 1000), 1)
    assert_eq_int(int_div(d2, 1000), 2)
    assert_eq_int(int_div(d3, 1000), 4)
  end

  test "backoff_fibonacci" do
    let d1 = Conduit.Backoff.delay(Conduit.Backoff.fibonacci, 1)
    let d2 = Conduit.Backoff.delay(Conduit.Backoff.fibonacci, 2)
    let d3 = Conduit.Backoff.delay(Conduit.Backoff.fibonacci, 5)
    assert_eq_int(int_div(d1, 1000), 1)
    assert_eq_int(int_div(d2, 1000), 1)
    assert_eq_int(int_div(d3, 1000), 5)
  end

  test "backoff_custom" do
    let f : Int -> Int = fn n -> n * 100000
    let strat : Conduit.Backoff = Conduit.Backoff.custom(f)
    let d = Conduit.Backoff.delay(strat, 3)
    assert_eq_int(int_div(d, 1000), 300)
  end

  -- ─────────────────────────────────────────────────────────────
  -- Schema validation tests
  -- ─────────────────────────────────────────────────────────────

  test "schema_none_always_passes" do
    let schema = Conduit.Schema.none()
    let result = Conduit.Schema.validate(schema, "any value")
    assert_ok(result)
  end

  test "schema_build_valid" do
    let schema = Conduit.Schema.build(fn s ->
      if String.is_empty(s) do Err("must not be empty") else Ok(()) end)
    assert_ok(Conduit.Schema.validate(schema, "hello"))
  end

  test "schema_build_invalid" do
    let schema = Conduit.Schema.build(fn s ->
      if String.is_empty(s) do Err("must not be empty") else Ok(()) end)
    assert_err(Conduit.Schema.validate(schema, ""))
  end

  -- ─────────────────────────────────────────────────────────────
  -- JobConfig defaults test
  -- ─────────────────────────────────────────────────────────────

  test "job_config_defaults" do
    let cfg = Conduit.JobConfig.default()
    assert_eq_str(cfg.queue, "default")
    assert_eq_int(cfg.max_attempts, 3)
    assert_eq_int(cfg.priority, 0)
    assert_none(cfg.dead_letter_queue)
    assert_none(cfg.discard_after)
  end

  -- ─────────────────────────────────────────────────────────────
  -- Queue.enqueue builds correct row
  -- ─────────────────────────────────────────────────────────────

  test "queue_enqueue_builds_row" do
    let key     = setup_fake_storage()
    -- Wrap fake_enqueue as a storage value by calling directly.
    -- In a real test we'd use an impl; here we test Queue logic by
    -- inspecting what would be passed to the storage.
    let config  = { Conduit.JobConfig.default() with queue: "test_queue", priority: 5 }
    let payload = "{\"name\": \"World\"}"
    let id      = base64_encode(random_bytes(16))

    -- Build the row manually as Queue.enqueue would
    let now = DateTime.from_timestamp(DateTime.now())
    let row : Conduit.JobRow = {
      id: id,
      queue: config.queue,
      job_type: "GreetingJob",
      payload: payload,
      status: "pending",
      attempt: 0,
      max_attempts: config.max_attempts,
      priority: config.priority,
      backoff: "exponential",
      dead_letter_queue: None,
      inserted_at: now,
      scheduled_at: now,
      run_at: now,
      started_at: None,
      completed_at: None,
      heartbeat_at: None,
      worker_id: None,
      unique_key: None,
      errors: Nil,
      tags: config.tags
    }
    fake_enqueue(key, row)
    let stored = jobs_in_store(key)
    assert_eq_int(length(stored), 1)
    let stored_job = head(stored)
    assert_eq_str(stored_job.queue, "test_queue")
    assert_eq_str(stored_job.job_type, "GreetingJob")
    assert_eq_str(stored_job.status, "pending")
    assert_eq_int(stored_job.priority, 5)
    assert_eq_int(stored_job.attempt, 0)
  end

  -- ─────────────────────────────────────────────────────────────
  -- Queue performer registry
  -- ─────────────────────────────────────────────────────────────

  test "dispatch_to_registered_performer" do
    let job_type = "TestDispatchJob_" ++ base64_encode(random_bytes(16))  -- unique to avoid cross-test pollution
    Conduit.Queue.register_performer(job_type, fn _payload -> Ok(()), Conduit.JobConfig.default())
    let result = Conduit.Queue.dispatch(job_type, "{}")
    assert_ok(result)
  end

  test "dispatch_unknown_job_type_discards" do
    let result = Conduit.Queue.dispatch("__no_such_job__", "{}")
    assert_err(result)
  end

  test "dispatch_forwards_retry_error" do
    let job_type = "RetryJob_" ++ base64_encode(random_bytes(16))
    let pk = "perf_" ++ base64_encode(random_bytes(8))
    let pk_tbl = Vault.new(pk)
    Vault.set(pk_tbl, "p", fn _ -> Err(Conduit.Retry("transient")))
    let perf = Vault.get(pk_tbl, "p") |> unwrap
    Conduit.Queue.register_performer(job_type, perf, Conduit.JobConfig.default())
    let result = Conduit.Queue.dispatch(job_type, "{}")
    assert_err(result)
  end

  -- ─────────────────────────────────────────────────────────────
  -- Worker result handling
  -- ─────────────────────────────────────────────────────────────

  pfn sample_job_row(job_type : String) : Conduit.JobRow do
    let now = DateTime.from_timestamp(DateTime.now())
    {
      id: base64_encode(random_bytes(16)),
      queue: "default",
      job_type: job_type,
      payload: "{}",
      status: "running",
      attempt: 1,
      max_attempts: 3,
      priority: 0,
      backoff: "exponential",
      dead_letter_queue: None,
      inserted_at: now,
      scheduled_at: now,
      run_at: now,
      started_at: Some(now),
      completed_at: None,
      heartbeat_at: Some(now),
      worker_id: Some("worker-1"),
      unique_key: None,
      errors: Nil,
      tags: Nil
    }
  end

  test "worker_marks_completed_on_ok" do
    let key      = setup_fake_storage()
    let job_type = "OkJob_" ++ base64_encode(random_bytes(16))
    let job      = sample_job_row(job_type)

    -- Register a performer that always succeeds
    Conduit.Queue.register_performer(job_type, fn _ -> Ok(()), Conduit.JobConfig.default())

    -- Bind job.id early so Perceus tracks it as a separate local.
    -- Workaround for march Perceus bug: field projection on a record used both
    -- inside a match branch and after the match can RC-underflow.
    let job_id = job.id

    -- Simulate worker handle_result with Ok
    fake_mark_running(key, job_id, "w1")
    let result = Conduit.Queue.dispatch(job.job_type, job.payload)
    match result do
      Ok(_)  -> fake_mark_completed(key, job_id)
      Err(_) -> fake_mark_failed(key, job_id, "unexpected error")
    end

    assert_true(events_contain(key, "completed:" ++ job_id))
  end

  test "worker_marks_failed_on_retry_error" do
    let key      = setup_fake_storage()
    let job_type = "FailJob_" ++ base64_encode(random_bytes(16))
    let job      = sample_job_row(job_type)
    let pk       = "perf_" ++ base64_encode(random_bytes(8))
    let pk_tbl   = Vault.new(pk)
    Vault.set(pk_tbl, "p", fn _ -> Err(Conduit.Retry("temporary outage")))
    let perf = Vault.get(pk_tbl, "p") |> unwrap
    Conduit.Queue.register_performer(job_type, perf, Conduit.JobConfig.default())

    -- Bind job.id early so Perceus tracks it as a separate local.
    -- Workaround for march Perceus bug: field projection on a record used both
    -- inside a match branch and after the match can RC-underflow.
    let job_id = job.id

    fake_mark_running(key, job_id, "w1")
    let result = Conduit.Queue.dispatch(job.job_type, job.payload)
    match result do
      Ok(_)  -> fake_mark_completed(key, job_id)
      Err(_) -> fake_mark_failed(key, job_id, "retry")
    end

    assert_true(events_contain(key, "failed:" ++ job_id))
  end

  test "worker_discard_does_not_schedule_retry" do
    let key      = setup_fake_storage()
    let job_type = "DiscardJob_" ++ base64_encode(random_bytes(16))
    let job      = sample_job_row(job_type)
    let pk       = "perf_" ++ base64_encode(random_bytes(8))
    let pk_tbl   = Vault.new(pk)
    Vault.set(pk_tbl, "p", fn _ -> Err(Conduit.Discard("not found")))
    let perf = Vault.get(pk_tbl, "p") |> unwrap
    Conduit.Queue.register_performer(job_type, perf, Conduit.JobConfig.default())

    fake_mark_running(key, job.id, "w1")
    let result = Conduit.Queue.dispatch(job.job_type, job.payload)
    assert_err(result)
  end

  test "worker_snooze_result" do
    let job_type = "SnoozingJob_" ++ base64_encode(random_bytes(16))
    let pk       = "perf_" ++ base64_encode(random_bytes(8))
    let pk_tbl   = Vault.new(pk)
    Vault.set(pk_tbl, "p", fn _ -> Err(Conduit.Snooze(600000)))
    let perf = Vault.get(pk_tbl, "p") |> unwrap
    Conduit.Queue.register_performer(job_type, perf, Conduit.JobConfig.default())
    let result = Conduit.Queue.dispatch(job_type, "{}")
    assert_err(result)
  end

  -- ─────────────────────────────────────────────────────────────
  -- ConduitError variants
  -- ─────────────────────────────────────────────────────────────

  test "conduit_error_retry_carries_message" do
    let e = Conduit.Retry("service down")
    match e do
      Conduit.Retry(msg) -> assert_eq_str(msg, "service down")
      _                       -> assert_true(false)
    end
  end

  test "conduit_error_discard_carries_message" do
    let e = Conduit.Discard("user not found")
    match e do
      Conduit.Discard(msg) -> assert_eq_str(msg, "user not found")
      _                         -> assert_true(false)
    end
  end

  test "conduit_error_snooze_carries_duration" do
    let dur = 300000
    let e   = Conduit.Snooze(dur)
    match e do
      Conduit.Snooze(d) -> assert_eq_int(int_div(d, 1000), 300)
      _                      -> assert_true(false)
    end
  end

  -- ─────────────────────────────────────────────────────────────
  -- Phase 2: Backoff delay computation
  -- ─────────────────────────────────────────────────────────────

  test "backoff_delay_increases_with_attempt" do
    let d1 = int_div(Conduit.Backoff.delay(Conduit.Backoff.exponential, 1), 1000)
    let d2 = int_div(Conduit.Backoff.delay(Conduit.Backoff.exponential, 2), 1000)
    let d3 = int_div(Conduit.Backoff.delay(Conduit.Backoff.exponential, 3), 1000)
    assert_true(d1 < d2)
    assert_true(d2 < d3)
  end

  test "backoff_linear_delay_increases_linearly" do
    let d1 = int_div(Conduit.Backoff.delay(Conduit.Backoff.linear_strat, 1), 1000)
    let d2 = int_div(Conduit.Backoff.delay(Conduit.Backoff.linear_strat, 2), 1000)
    let d3 = int_div(Conduit.Backoff.delay(Conduit.Backoff.linear_strat, 3), 1000)
    assert_eq_int(d2 - d1, d3 - d2)  -- constant step
  end

  test "custom_backoff_uses_provided_function" do
    let f2 : Int -> Int = fn attempt -> attempt * 7000
    let strat  : Conduit.Backoff = Conduit.Backoff.custom(f2)
    let delay4 = Conduit.Backoff.delay(strat, 4)
    assert_eq_int(int_div(delay4, 1000), 28)
  end

  test "jitter_is_non_negative" do
    -- Jitter = Random.int(0, 1000) ms — verify the range is valid.
    let jitter = Random.int(0, 1000)
    assert_true(jitter >= 0)
    assert_true(jitter <= 1000)
  end

  -- ─────────────────────────────────────────────────────────────
  -- Phase 2: Registry stores and returns config
  -- ─────────────────────────────────────────────────────────────

  test "lookup_config_returns_registered_config" do
    let job_type = "ConfigJob_" ++ base64_encode(random_bytes(16))
    let cfg      = { Conduit.JobConfig.default() with max_attempts: 7, queue: "priority" }
    Conduit.Queue.register_performer(job_type, fn _ -> Ok(()), cfg)
    let result = Conduit.Queue.lookup_config(job_type)
    assert_some(result)
    match result do
      None    -> assert_true(false)
      Some(c) ->
        assert_eq_int(c.max_attempts, 7)
        assert_eq_str(c.queue, "priority")
    end
  end

  test "lookup_config_returns_none_for_unknown" do
    let result = Conduit.Queue.lookup_config("__unknown_job_type__")
    assert_none(result)
  end

  -- ─────────────────────────────────────────────────────────────
  -- Phase 2: DeadLetter.from_job
  -- ─────────────────────────────────────────────────────────────

  test "dead_letter_from_job_builds_correct_record" do
    let now = DateTime.from_timestamp(DateTime.now())
    let job : Conduit.JobRow = {
      id: "job-123",
      queue: "default",
      job_type: "SomeJob",
      payload: "{\"x\": 1}",
      status: "running",
      attempt: 3,
      max_attempts: 3,
      priority: 0,
      backoff: "exponential",
      dead_letter_queue: Some("dlq"),
      inserted_at: now,
      scheduled_at: now,
      run_at: now,
      started_at: Some(now),
      completed_at: None,
      heartbeat_at: Some(now),
      worker_id: Some("w1"),
      unique_key: None,
      errors: Cons("err1", Nil),
      tags: Nil
    }
    let dl = Conduit.DeadLetter.from_job(job, "final error")
    assert_eq_str(dl.job_id,   "job-123")
    assert_eq_str(dl.queue,    "default")
    assert_eq_str(dl.job_type, "SomeJob")
    assert_eq_int(dl.attempts, 3)
    assert_eq_bool(dl.reviewed, false)
    assert_eq_int(dl.retry_count, 0)
    -- errors list should include both pre-existing error and final error
    assert_true(List.length(dl.errors) == 2)
  end

  test "dead_letter_to_job_info_matches_job" do
    let now = DateTime.from_timestamp(DateTime.now())
    let job : Conduit.JobRow = {
      id: "job-456",
      queue: "media",
      job_type: "ProcessVideo",
      payload: "{}",
      status: "running",
      attempt: 2,
      max_attempts: 5,
      priority: 10,
      backoff: "linear",
      dead_letter_queue: None,
      inserted_at: now,
      scheduled_at: now,
      run_at: now,
      started_at: Some(now),
      completed_at: None,
      heartbeat_at: None,
      worker_id: None,
      unique_key: None,
      errors: Nil,
      tags: Cons("video", Nil)
    }
    let info = Conduit.DeadLetter.to_job_info(job)
    assert_eq_str(info.id,       "job-456")
    assert_eq_str(info.queue,    "media")
    assert_eq_int(info.attempt,  2)
    assert_eq_int(info.max_attempts, 5)
  end

  -- ─────────────────────────────────────────────────────────────
  -- Phase 2: Fake storage — schedule_retry and dead_letter tracking
  -- ─────────────────────────────────────────────────────────────

  pfn fake_schedule_retry(key : String, job_id : String, _error : String, _run_at : DateTime) : Result((), String) do
    let ev = Cons("retry:" ++ job_id, Vault.get(key, "events") |> unwrap_or(Nil))
    Vault.set(key, "events", ev)
    Ok(())
  end

  pfn fake_move_to_dead_letter(key : String, dl : Conduit.DeadLetter) : Result((), String) do
    let dls = Vault.get(key, "dead_letters") |> unwrap_or(Nil)
    Vault.set(key, "dead_letters", Cons(dl, dls))
    let ev  = Cons("dead:" ++ dl.job_id, Vault.get(key, "events") |> unwrap_or(Nil))
    Vault.set(key, "events", ev)
    Ok(())
  end

  pfn dead_letters_in_store(key : String) : List(Conduit.DeadLetter) do
    Vault.get(key, "dead_letters") |> unwrap_or(Nil)
  end

  test "retry_with_remaining_attempts_schedules_retry" do
    let key      = setup_fake_storage()
    let job_type = "RetryRemaining_" ++ base64_encode(random_bytes(16))
    let job      = sample_job_row(job_type)  -- attempt=1, max_attempts:3
    let config   = Conduit.JobConfig.default()

    -- Bind job.id early so Perceus tracks it as a separate local.
    -- Workaround for march Perceus bug: field projection on a record used both
    -- inside an if branch and after the if can RC-underflow.
    let job_id = job.id

    -- Simulate: attempt 1 failed, 2 remaining → should schedule_retry
    let next_attempt = job.attempt  -- 1 (already the post-run value in our sample)
    if next_attempt < config.max_attempts do
      let run_at = DateTime.add(DateTime.from_timestamp(DateTime.now()), Conduit.Backoff.delay(config.backoff, next_attempt))
      let _ = fake_schedule_retry(key, job_id, "transient", run_at)
      ()
    else
      ()
    end

    assert_true(events_contain(key, "retry:" ++ job_id))
  end

  test "retry_after_exhausting_attempts_dead_letters" do
    let key      = setup_fake_storage()
    let job_type = "RetryExhausted_" ++ base64_encode(random_bytes(16))
    let now      = DateTime.from_timestamp(DateTime.now())
    -- A job already at max_attempts
    let job : Conduit.JobRow = {
      id: base64_encode(random_bytes(16)),
      queue: "default",
      job_type: job_type,
      payload: "{}",
      status: "running",
      attempt: 3,
      max_attempts: 3,
      priority: 0,
      backoff: "exponential",
      dead_letter_queue: None,
      inserted_at: now,
      scheduled_at: now,
      run_at: now,
      started_at: Some(now),
      completed_at: None,
      heartbeat_at: Some(now),
      worker_id: Some("w1"),
      unique_key: None,
      errors: Nil,
      tags: Nil
    }
    let config = Conduit.JobConfig.default()

    -- Bind job fields early so Perceus tracks them as separate locals.
    -- Workaround for march Perceus bug: field projection on a record used both
    -- inside an if branch and after the if can RC-underflow.
    let job_id      = job.id
    let job_attempt = job.attempt

    -- Simulate: attempt == max_attempts → dead-letter
    if job_attempt >= config.max_attempts do
      let dl = Conduit.DeadLetter.from_job(job, "exhausted retries")
      let _ = fake_move_to_dead_letter(key, dl)
      ()
    else
      ()
    end

    assert_true(events_contain(key, "dead:" ++ job_id))
    assert_eq_int(length(dead_letters_in_store(key)), 1)
  end

  test "discard_with_dlq_moves_to_dead_letters" do
    let key      = setup_fake_storage()
    let job_type = "DiscardDLQ_" ++ base64_encode(random_bytes(16))
    let now      = DateTime.from_timestamp(DateTime.now())
    let job : Conduit.JobRow = {
      id: base64_encode(random_bytes(16)),
      queue: "default",
      job_type: job_type,
      payload: "{}",
      status: "running",
      attempt: 1,
      max_attempts: 3,
      priority: 0,
      backoff: "exponential",
      dead_letter_queue: Some("my_dlq"),
      inserted_at: now,
      scheduled_at: now,
      run_at: now,
      started_at: Some(now),
      completed_at: None,
      heartbeat_at: None,
      worker_id: None,
      unique_key: None,
      errors: Nil,
      tags: Nil
    }

    -- DLQ is configured, so Discard routes to dead_letters
    let dl = Conduit.DeadLetter.from_job(job, "discarded: not found")
    fake_move_to_dead_letter(key, dl)

    assert_eq_int(length(dead_letters_in_store(key)), 1)
    assert_eq_str((head(dead_letters_in_store(key))).job_id, job.id)
  end

  test "on_dead_letter_callback_fires" do
    -- Verify the callback receives a JobInfo with correct fields.
    let callback_fired = Vault.new("test_dlq_callback_" ++ base64_encode(random_bytes(16)))
    Vault.set(callback_fired, "fired", false)
    Vault.set(callback_fired, "job_type", "")

    let callback = fn (info : Conduit.JobInfo) ->
      let _ = Vault.set(callback_fired, "fired", true)
      Vault.set(callback_fired, "job_type", info.job_type)

    let now = DateTime.from_timestamp(DateTime.now())
    let job : Conduit.JobRow = {
      id: base64_encode(random_bytes(16)),
      queue: "default",
      job_type: "CallbackJob",
      payload: "{}",
      status: "running",
      attempt: 3,
      max_attempts: 3,
      priority: 0,
      backoff: "exponential",
      dead_letter_queue: Some("dlq"),
      inserted_at: now,
      scheduled_at: now,
      run_at: now,
      started_at: Some(now),
      completed_at: None,
      heartbeat_at: None,
      worker_id: None,
      unique_key: None,
      errors: Nil,
      tags: Nil
    }
    let info = Conduit.DeadLetter.to_job_info(job)
    callback(info)

    assert_eq_bool(Vault.get(callback_fired, "fired") |> unwrap_or(false), true)
    assert_eq_str(Vault.get(callback_fired, "job_type") |> unwrap_or(""), "CallbackJob")
  end

  -- ─────────────────────────────────────────────────────────────
  -- Phase 3: CronParser — expression parsing and next_run
  -- ─────────────────────────────────────────────────────────────

  test "cron_parser_next_run_returns_future_datetime" do
    -- "0 * * * *" fires at the top of each hour.
    -- Whatever `from` is, next_run must be after `from`.
    let from   = DateTime.from_timestamp(DateTime.now())
    let result = Conduit.CronParser.next_run("0 * * * *", from)
    assert_ok(result)
    match result do
      Err(_)   -> assert_true(false)
      Ok(next) ->
        let from_ts = DateTime.to_timestamp(from)
        let next_ts = DateTime.to_timestamp(next)
        assert_true(next_ts > from_ts)
    end
  end

  test "cron_parser_wildcard_matches_every_minute" do
    -- "* * * * *" should fire every minute; next_run is at most 60s away.
    let from   = DateTime.from_timestamp(DateTime.now())
    let result = Conduit.CronParser.next_run("* * * * *", from)
    assert_ok(result)
    match result do
      Err(_)   -> assert_true(false)
      Ok(next) ->
        let diff = DateTime.to_timestamp(next) - DateTime.to_timestamp(from)
        assert_true(diff <= 60)
    end
  end

  test "cron_parser_exact_minute_field" do
    -- "5 * * * *" — fires at minute 5 of every hour.
    -- next_run minute component should be 5.
    let from   = DateTime.from_timestamp(DateTime.now())
    let result = Conduit.CronParser.next_run("5 * * * *", from)
    assert_ok(result)
    match result do
      Err(_)   -> assert_true(false)
      Ok(next) ->
        let min_str = DateTime.format(next, "%M")
        assert_eq_str(min_str, "05")
    end
  end

  test "cron_parser_step_field" do
    -- "*/15 * * * *" — fires every 15 minutes (0, 15, 30, 45).
    let from   = DateTime.from_timestamp(DateTime.now())
    let result = Conduit.CronParser.next_run("*/15 * * * *", from)
    assert_ok(result)
    match result do
      Err(_)   -> assert_true(false)
      Ok(next) ->
        let min = DateTime.format(next, "%M") |> String.to_int |> Result.unwrap_or(-1)
        let valid = min == 0 || min == 15 || min == 30 || min == 45
        assert_true(valid)
    end
  end

  test "cron_parser_range_field" do
    -- "0-5 * * * *" — fires at minutes 0 through 5 inclusive.
    let from   = DateTime.from_timestamp(DateTime.now())
    let result = Conduit.CronParser.next_run("0-5 * * * *", from)
    assert_ok(result)
    match result do
      Err(_)   -> assert_true(false)
      Ok(next) ->
        let min = DateTime.format(next, "%M") |> String.to_int |> Result.unwrap_or(-1)
        assert_true(min >= 0 && min <= 5)
    end
  end

  test "cron_parser_list_field" do
    -- "1,31 * * * *" — fires at minute 1 and 31.
    let from   = DateTime.from_timestamp(DateTime.now())
    let result = Conduit.CronParser.next_run("1,31 * * * *", from)
    assert_ok(result)
    match result do
      Err(_)   -> assert_true(false)
      Ok(next) ->
        let min = DateTime.format(next, "%M") |> String.to_int |> Result.unwrap_or(-1)
        assert_true(min == 1 || min == 31)
    end
  end

  test "cron_parser_returns_err_for_wrong_field_count" do
    let result = Conduit.CronParser.next_run("* * * *", DateTime.from_timestamp(DateTime.now()))  -- only 4 fields
    assert_err(result)
  end

  test "cron_parser_returns_err_for_invalid_value" do
    let result = Conduit.CronParser.next_run("60 * * * *", DateTime.from_timestamp(DateTime.now()))  -- minute 60 out of range
    assert_err(result)
  end

  test "cron_parser_returns_err_for_impossible_expression" do
    -- Feb 30 never exists; the search should exhaust the 1-year bound.
    let result = Conduit.CronParser.next_run("0 0 30 2 *", DateTime.from_timestamp(DateTime.now()))
    assert_err(result)
  end

  test "cron_parser_matches_true" do
    -- Build a DateTime known to match "0 12 * * *" (noon, any day).
    -- We'll parse the expr and check that a noon DateTime matches it.
    let expr_result = Conduit.CronParser.parse("0 12 * * *")
    assert_ok(expr_result)
    match expr_result do
      Err(_)    -> assert_true(false)
      Ok(expr)  ->
        -- Find the next noon time and verify it matches.
        let next_result = Conduit.CronParser.next_run("0 12 * * *", DateTime.from_timestamp(DateTime.now()))
        match next_result do
          Err(_)   -> assert_true(false)
          Ok(next) -> assert_true(Conduit.CronParser.matches(expr, next))
        end
    end
  end

  test "cron_parser_matches_false" do
    -- A DateTime at minute 0 does NOT match "30 * * * *".
    let expr_result = Conduit.CronParser.parse("30 * * * *")
    assert_ok(expr_result)
    match expr_result do
      Err(_)   -> assert_true(false)
      Ok(expr) ->
        -- Find next :30 tick and verify next :00 does NOT match.
        let next30_result = Conduit.CronParser.next_run("30 * * * *", DateTime.from_timestamp(DateTime.now()))
        match next30_result do
          Err(_)    -> assert_true(false)
          Ok(next30) ->
            -- Advance 30 more minutes to reach the next :00 tick.
            let ts_00 = DateTime.to_timestamp(next30) + (30 * 60)
            let dt_00 = DateTime.from_timestamp(ts_00)
            assert_true(not (Conduit.CronParser.matches(expr, dt_00)))
        end
    end
  end

  -- ─────────────────────────────────────────────────────────────
  -- Phase 3: CronRegistry — register, lookup, fire
  -- ─────────────────────────────────────────────────────────────

  test "cron_registry_register_and_lookup" do
    let cron_type = "TestCron_" ++ base64_encode(random_bytes(16))
    let config    = Conduit.CronConfig.default()
    Conduit.CronRegistry.register(cron_type, config, fn _payload -> Ok(()))
    let result = Conduit.CronRegistry.lookup(cron_type)
    assert_some(result)
    match result do
      None    -> assert_true(false)
      Some(e) -> assert_eq_str(e.config.schedule, "* * * * *")
    end
  end

  test "cron_registry_lookup_returns_none_for_unknown" do
    let result = Conduit.CronRegistry.lookup("__no_such_cron__")
    assert_none(result)
  end

  test "cron_registry_fire_calls_performer" do
    let cron_type = "FireCron_" ++ base64_encode(random_bytes(16))
    let vault_key_name = "cron_fire_" ++ base64_encode(random_bytes(16))
    let vault_key = Vault.new(vault_key_name)
    Vault.set(vault_key, "fired", false)

    Conduit.CronRegistry.register(cron_type, Conduit.CronConfig.default(), fn _payload ->
      Ok(Vault.set(vault_key, "fired", true)))
    let result = Conduit.CronRegistry.fire(cron_type, "{}")
    assert_ok(result)
    assert_eq_bool(Vault.get(vault_key, "fired") |> unwrap_or(false), true)
  end

  test "cron_registry_fire_returns_discard_for_unknown" do
    let result = Conduit.CronRegistry.fire("__no_such_cron__", "{}")
    assert_err(result)
  end

