mod ConduitTest do
  use Test
  use Conduit

  -- ─────────────────────────────────────────────────────────────
  -- Fake in-memory workflow storage for Phase 4+ tests
  -- ─────────────────────────────────────────────────────────────

  type FakeWorkflowStorage = { error : Option(String), vault_key : String }

  impl Storage(FakeWorkflowStorage) do
    -- Job methods — unused in Phase 4 tests, return stubs.
    fn enqueue(_self, job) : Result(String, String) do Ok(job.id) end
    fn fetch_next(_self, _queue : String) do Ok(None) end
    fn mark_running(_self, _id : String, _wid : String) : Result((), String) do Ok(()) end
    fn mark_completed(_self, _id : String) : Result((), String) do Ok(()) end
    fn heartbeat(_self, _id : String) : Result((), String) do Ok(()) end
    fn schedule_retry(_self, _id : String, _msg : String, _at : DateTime) : Result((), String) do Ok(()) end
    fn discard(_self, _id : String, _msg : String) : Result((), String) do Ok(()) end
    fn move_to_dead_letter(_self, _dl) : Result((), String) do Ok(()) end
    fn rescue_stale(_self, _secs : Int) : Result(List(String), String) do Ok(Nil) end

    -- Cron stubs.
    fn cron_upsert(_self, _s) : Result((), String) do Ok(()) end
    fn cron_load_due(_self) do Ok(Nil) end
    fn cron_load_by_id(_self, _id : String) do Ok(None) end
    fn cron_mark_fired(_self, _id : String, _jid : String, _next : Option(DateTime)) : Result((), String) do Ok(()) end
    fn cron_job_active(_self, _id : String) : Result(Bool, String) do Ok(false) end
    fn cron_cancel_job(_self, _id : String) : Result((), String) do Ok(()) end
    fn cron_delete(_self, _id : String) : Result((), String) do Ok(()) end
    fn cron_advisory_lock(_self, _id : Int) : Result(Bool, String) do Ok(true) end
    fn cron_advisory_unlock(_self, _id : Int) : Result((), String) do Ok(()) end

    -- Workflow methods.
    fn workflow_insert(_self, row) : Result(String, String) do Ok(row.id) end

    fn workflow_load(self : FakeWorkflowStorage, _wf_id : String) do
      match self.error do
        Some(e) -> Err(e)
        None    -> Ok(None)
      end
    end

    fn workflow_update_status(_self, _id : String, _status : String, _out : Option(String), _err : Option(String)) : Result((), String) do Ok(()) end
    fn workflow_cancel(_self, _id : String, _reason : String) : Result((), String) do Ok(()) end

    fn checkpoint_get(self : FakeWorkflowStorage, _wf_id : String, _name : String) : Result(Option(String), String) do
      match self.error do
        Some(e) -> Err(e)
        None    -> Ok(None)
      end
    end

    fn checkpoint_set(self : FakeWorkflowStorage, wf_id : String, name : String, value : String, _dur : Int) : Result((), String) do
      match self.error do
        Some(e) -> Err(e)
        None    ->
          let checkpoints = Vault.get(pfake_tbl(self.vault_key), "checkpoints") |> unwrap_or(Nil)
          let _ = Vault.set(pfake_tbl(self.vault_key), "checkpoints", Cons((wf_id, name, value), checkpoints))
          Ok(())
      end
    end

    fn checkpoint_load_all(_self, _wf_id : String) do Ok(Nil) end

    fn signal_insert(_self, _sig) : Result(Int, String) do Ok(1) end

    fn signal_peek(_self, _wf_id : String, _type : String) do Ok(None) end
    fn signal_mark_delivered(_self, _id : Int) : Result((), String) do Ok(()) end

    -- Node / cluster stubs (Phase 5).
    fn node_register(self : FakeWorkflowStorage, node) : Result((), String) do
      let nodes = Vault.get(pfake_tbl(self.vault_key), "nodes") |> unwrap_or(Nil)
      Vault.set(pfake_tbl(self.vault_key), "nodes", Cons(node, nodes))
      Ok(())
    end

    fn node_heartbeat(_self, _id : String) : Result((), String) do Ok(()) end
    fn node_deregister(_self, _id : String) : Result((), String) do Ok(()) end

    fn node_list_active(self : FakeWorkflowStorage) do
      Ok(Vault.get(pfake_tbl(self.vault_key), "nodes") |> unwrap_or(Nil))
    end

    fn node_reclaim_jobs(_self, _threshold_s : Int) : Result(List(String), String) do Ok(Nil) end
    fn node_cleanup_stale(_self, _threshold_s : Int) : Result(Int, String) do Ok(0) end

    fn node_try_leader_lock(self : FakeWorkflowStorage, _lock_id : Int) : Result(Bool, String) do
      let held = Vault.get(pfake_tbl(self.vault_key), "leader_lock") |> unwrap_or(false)
      if held do
        Ok(false)
      else
        Vault.set(pfake_tbl(self.vault_key), "leader_lock", true)
        Ok(true)
      end
    end

    fn node_release_leader_lock(self : FakeWorkflowStorage, _lock_id : Int) : Result((), String) do
      Vault.set(pfake_tbl(self.vault_key), "leader_lock", false)
      Ok(())
    end

    -- Dashboard storage stubs.
    fn dashboard_queue_summary(self : FakeWorkflowStorage) do
      Ok(Vault.get(pfake_tbl(self.vault_key), "queue_summary") |> unwrap_or(Nil))
    end

    fn dashboard_jobs_list(self : FakeWorkflowStorage, _queue : String, _status : String, _page : Int) do
      Ok(Vault.get(pfake_tbl(self.vault_key), "jobs") |> unwrap_or(Nil))
    end

    fn dead_letter_list(_self : FakeWorkflowStorage, _page : Int) do
      Ok(Nil)
    end

    fn dead_letter_load(_self : FakeWorkflowStorage, _id : String) do
      Ok(None)
    end

    fn job_retry(self : FakeWorkflowStorage, job_id : String) : Result((), String) do
      let evs = Vault.get(pfake_tbl(self.vault_key), "events") |> unwrap_or(Nil)
      Vault.set(pfake_tbl(self.vault_key), "events", Cons("job_retry:" ++ job_id, evs))
      Ok(())
    end

    fn job_cancel(self : FakeWorkflowStorage, job_id : String, reason : String) : Result((), String) do
      let evs = Vault.get(pfake_tbl(self.vault_key), "events") |> unwrap_or(Nil)
      Vault.set(pfake_tbl(self.vault_key), "events", Cons("job_cancel:" ++ job_id ++ ":" ++ reason, evs))
      Ok(())
    end

    fn job_delete(self : FakeWorkflowStorage, job_id : String) : Result((), String) do
      let evs = Vault.get(pfake_tbl(self.vault_key), "events") |> unwrap_or(Nil)
      Vault.set(pfake_tbl(self.vault_key), "events", Cons("job_delete:" ++ job_id, evs))
      Ok(())
    end

    fn dead_letter_delete(self : FakeWorkflowStorage, dl_id : String) : Result((), String) do
      let evs = Vault.get(pfake_tbl(self.vault_key), "events") |> unwrap_or(Nil)
      Vault.set(pfake_tbl(self.vault_key), "events", Cons("dl_delete:" ++ dl_id, evs))
      Ok(())
    end

    fn notify_subscribe(_self : FakeWorkflowStorage, _channel : String) : Result((), String) do
      Ok(())
    end

    -- Rate limiting & unique job stubs.
    fn rate_limit_acquire(self : FakeWorkflowStorage, key : String, _rate : Int) : Result(Bool, String) do
      let blocked = Vault.get(pfake_tbl(self.vault_key), "rl_blocked:" ++ key) |> unwrap_or(false)
      if blocked do Ok(false) else Ok(true) end
    end

    fn unique_check(self : FakeWorkflowStorage, unique_key : String) : Result(Bool, String) do
      let exists = Vault.get(pfake_tbl(self.vault_key), "unique:" ++ unique_key) |> unwrap_or(false)
      Ok(exists)
    end

    fn unique_release(self : FakeWorkflowStorage, job_id : String) : Result((), String) do
      let evs = Vault.get(pfake_tbl(self.vault_key), "events") |> unwrap_or(Nil)
      Vault.set(pfake_tbl(self.vault_key), "events", Cons("unique_release:" ++ job_id, evs))
      Ok(())
    end

    -- Event store stubs.
    fn event_append(self : FakeWorkflowStorage, workflow_id : String, sequence : Int, event_type : String, payload : String) : Result(Int, String) do
      let key = "events:" ++ workflow_id
      let events = Vault.get(pfake_tbl(self.vault_key), key) |> unwrap_or(Nil)
      let evt = {
        id: List.length(events) + 1,
        workflow_id: workflow_id,
        sequence: sequence,
        event_type: event_type,
        payload: payload,
        recorded_at: DateTime.from_timestamp(DateTime.now())
      }
      Vault.set(pfake_tbl(self.vault_key), key, List.append(events, Cons(evt, Nil)))
      Ok(evt.id)
    end

    fn event_load_all(self : FakeWorkflowStorage, workflow_id : String) do
      let key = "events:" ++ workflow_id
      Ok(Vault.get(pfake_tbl(self.vault_key), key) |> unwrap_or(Nil))
    end

    fn event_load_up_to(self : FakeWorkflowStorage, workflow_id : String, max_seq : Int) do
      let key = "events:" ++ workflow_id
      let all = Vault.get(pfake_tbl(self.vault_key), key) |> unwrap_or(Nil)
      Ok(List.filter(all, fn e -> e.sequence <= max_seq))
    end

    fn event_count(self : FakeWorkflowStorage, workflow_id : String) : Result(Int, String) do
      let key = "events:" ++ workflow_id
      Ok(List.length(Vault.get(pfake_tbl(self.vault_key), key) |> unwrap_or(Nil)))
    end

    fn dashboard_job_by_id(_self : FakeWorkflowStorage, _id : String) do
      Ok(None)
    end

    fn dashboard_crons_list(_self : FakeWorkflowStorage) do
      Ok(Nil)
    end

    fn dashboard_workflows_list(_self : FakeWorkflowStorage, _status : String, _page : Int) do
      Ok(Nil)
    end

    fn dead_letter_list_all(_self : FakeWorkflowStorage) do
      Ok(Nil)
    end

    fn dead_letter_delete_all(_self : FakeWorkflowStorage) : Result(Int, String) do
      Ok(0)
    end

    fn workflow_list_all(_self : FakeWorkflowStorage) do
      Ok(Nil)
    end

    fn workflow_status_get(_self : FakeWorkflowStorage, _id : String) : Result(Option(String), String) do
      Ok(None)
    end

    fn mark_snoozed(_self : FakeWorkflowStorage, _id : String, _wake_at : DateTime) : Result((), String) do
      Ok(())
    end

    fn prune_jobs(_self : FakeWorkflowStorage, _cutoff_s : Int, _batch_size : Int) : Result(Int, String) do
      Ok(0)
    end

    fn prune_dead_letters(_self : FakeWorkflowStorage, _cutoff_s : Int, _batch_size : Int) : Result(Int, String) do
      Ok(0)
    end

    fn prune_workflows(_self : FakeWorkflowStorage, _cutoff_s : Int, _batch_size : Int) : Result(Int, String) do
      Ok(0)
