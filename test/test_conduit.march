    let vault_k = "dl_test_" ++ base64_encode(random_bytes(16))
    let storage = fake_workflow_storage_new(vault_k)
    let result  = Conduit.Dashboard.Queries.dead_letters(storage, 1)
    assert_eq_int(List.length(result), 0)
