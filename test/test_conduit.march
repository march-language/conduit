  -- ─────────────────────────────────────────────────────────────
  -- Phase 7: Rate limiting types
  -- ─────────────────────────────────────────────────────────────

  test "rate_limit_type_fields" do
    let rl : Conduit.RateLimit = {
      max_per_second: 10,
      per_key: None,
      backend: Conduit.RateLimiterBackend.StorageBacked
    }
    assert_eq_int(rl.max_per_second, 10)
    assert_none(rl.per_key)
  end

  test "rate_limit_with_per_key" do
    let pk : Conduit.PerKeyRateLimit = {
      key_fn: fn payload -> "user_123",
      limit: 2
    }
    let rl : Conduit.RateLimit = {
      max_per_second: 10,
      per_key: Some(pk),
      backend: Conduit.RateLimiterBackend.StorageBacked
    }
    assert_eq_int(rl.max_per_second, 10)
    assert_some(rl.per_key)
    match rl.per_key do
      None     -> assert_true(false)
      Some(pk2) ->
        assert_eq_int(pk2.limit, 2)
        assert_eq_str(pk2.key_fn("{}"), "user_123")
    end
  end

  test "job_config_default_has_no_rate_limit" do
    let cfg = Conduit.JobConfig.default()
    assert_none(cfg.rate_limit)
    assert_none(cfg.on_dead_letter)
    match cfg.on_conflict do
      Ignore -> assert_true(true)
      _      -> assert_true(false)
    end
  end

  test "job_config_with_rate_limit" do
    let rl : Conduit.RateLimit = { max_per_second: 5, per_key: None, backend: Conduit.RateLimiterBackend.StorageBacked }
    let cfg = { Conduit.JobConfig.default() with rate_limit: Some(rl) }
    assert_some(cfg.rate_limit)
    match cfg.rate_limit do
      None     -> assert_true(false)
      Some(r)  -> assert_eq_int(r.max_per_second, 5)
    end
  end

  -- ─────────────────────────────────────────────────────────────
  -- Phase 7: Unique jobs
  -- ─────────────────────────────────────────────────────────────

  test "unique_fingerprint_deterministic" do
    let fp1 = Conduit.Unique.fingerprint("TestJob", "default", "{\"id\":1}", Nil, Conduit.UniqueScope.PerQueue)
    let fp2 = Conduit.Unique.fingerprint("TestJob", "default", "{\"id\":1}", Nil, Conduit.UniqueScope.PerQueue)
    assert_eq_str(fp1, fp2)
  end

  test "unique_fingerprint_differs_by_job_type" do
    let fp1 = Conduit.Unique.fingerprint("JobA", "default", "{}", Nil, Conduit.UniqueScope.PerQueue)
    let fp2 = Conduit.Unique.fingerprint("JobB", "default", "{}", Nil, Conduit.UniqueScope.PerQueue)
    assert_true(fp1 != fp2)
  end

  test "unique_fingerprint_differs_by_payload" do
    let fp1 = Conduit.Unique.fingerprint("Job", "default", "{\"id\":1}", Nil, Conduit.UniqueScope.PerQueue)
    let fp2 = Conduit.Unique.fingerprint("Job", "default", "{\"id\":2}", Nil, Conduit.UniqueScope.PerQueue)
    assert_true(fp1 != fp2)
  end

  test "unique_fingerprint_with_by_fields" do
    let fp1 = Conduit.Unique.fingerprint("Job", "default", "{\"user_id\":1,\"other\":\"a\"}", Cons("user_id", Nil), Conduit.UniqueScope.PerQueue)
    let fp2 = Conduit.Unique.fingerprint("Job", "default", "{\"user_id\":1,\"other\":\"b\"}", Cons("user_id", Nil), Conduit.UniqueScope.PerQueue)
    -- Same user_id → same fingerprint (only user_id is in `by`)
    assert_eq_str(fp1, fp2)
  end

  test "unique_fingerprint_per_queue_vs_global" do
    -- Same job+payload but different queues: PerQueue → different fingerprints.
    let fp_q1 = Conduit.Unique.fingerprint("Job", "default",  "{}", Nil, Conduit.UniqueScope.PerQueue)
    let fp_q2 = Conduit.Unique.fingerprint("Job", "critical", "{}", Nil, Conduit.UniqueScope.PerQueue)
    assert_true(fp_q1 != fp_q2)
    -- Global scope → same fingerprint regardless of queue.
    let fp_g1 = Conduit.Unique.fingerprint("Job", "default",  "{}", Nil, Conduit.UniqueScope.Global)
    let fp_g2 = Conduit.Unique.fingerprint("Job", "critical", "{}", Nil, Conduit.UniqueScope.Global)
    assert_eq_str(fp_g1, fp_g2)
  end

  test "unique_conflict_ignore_variant" do
    match Conduit.UniqueConflict.Ignore do
      Ignore -> assert_true(true)
      _      -> assert_true(false)
    end
  end

  test "unique_conflict_replace_variant" do
    let _ = Conduit.UniqueConflict.Replace
    assert_true(true)
  end

  test "unique_conflict_raise_variant" do
    match Conduit.UniqueConflict.Raise do
      Raise -> assert_true(true)
      _                            -> assert_true(false)
    end
  end

  test "unique_check_no_conflict_in_fake_storage" do
    let vault_k = "unique_nc_" ++ base64_encode(random_bytes(16))
    let storage = fake_workflow_storage_new(vault_k)
    let result  = Conduit.Unique.conflicts(storage, "some_key")
    assert_ok(result)
    match result do
      Err(_)    -> assert_true(false)
      Ok(found) -> assert_eq_bool(found, false)
    end
  end

  test "unique_check_conflict_in_fake_storage" do
    let vault_k = "unique_cf_" ++ base64_encode(random_bytes(16))
    let storage = fake_workflow_storage_new(vault_k)
    -- Mark a key as existing.
    Vault.set(pfake_tbl(vault_k), "unique:my_key", true)
    let result = Conduit.Unique.conflicts(storage, "my_key")
    assert_ok(result)
    match result do
      Err(_)    -> assert_true(false)
      Ok(found) -> assert_eq_bool(found, true)
    end
