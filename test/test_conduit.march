  -- ─────────────────────────────────────────────────────────────
  -- Phase 7: Rate limiter
  -- ─────────────────────────────────────────────────────────────

  test "rate_limiter_acquire_allowed_by_default" do
    let vault_k = "rl_acq_" ++ base64_encode(random_bytes(16))
    let storage = fake_workflow_storage_new(vault_k)
    let rl : Conduit.RateLimit = { max_per_second: 10, per_key: None, backend: Conduit.RateLimiterBackend.StorageBacked }
    let result = Conduit.RateLimiter.acquire(storage, "TestJob", rl, "{}")
    assert_ok(result)
    match result do
      Err(_)      -> assert_true(false)
      Ok(allowed) -> assert_eq_bool(allowed, true)
    end
  end

  test "rate_limiter_acquire_blocked_when_flagged" do
    let vault_k = "rl_blk_" ++ base64_encode(random_bytes(16))
    let storage = fake_workflow_storage_new(vault_k)
    -- Block the global key.
    Vault.set(pfake_tbl(vault_k), "rl_blocked:conduit_rl:TestJob", true)
    let rl : Conduit.RateLimit = { max_per_second: 10, per_key: None, backend: Conduit.RateLimiterBackend.StorageBacked }
    let result = Conduit.RateLimiter.acquire(storage, "TestJob", rl, "{}")
    assert_ok(result)
    match result do
      Err(_)      -> assert_true(false)
      Ok(allowed) -> assert_eq_bool(allowed, false)
    end
  end

  test "rate_limiter_snooze_duration_positive" do
    let ms = Conduit.RateLimiter.snooze_duration(10)
    -- Should be at least 100ms (1000/10) and at most ~200ms (100 + 100 jitter)
    assert_true(ms >= 100)
    assert_true(ms <= 300)
  end

  test "rate_limiter_snooze_duration_zero_rate" do
    let ms = Conduit.RateLimiter.snooze_duration(0)
    -- With rate 0, base is 1000ms plus up to 100ms jitter
    assert_true(ms >= 1000)
    assert_true(ms <= 1200)
  end

  -- ─────────────────────────────────────────────────────────────
  -- Phase 7: Priority ordering
  -- ─────────────────────────────────────────────────────────────

  test "priority_ordering_in_job_config" do
    -- Priority is just an Int field on JobConfig; higher values run first.
    -- The ORDER BY in fetch_next is `priority DESC, run_at ASC`.
    let low  = { Conduit.JobConfig.default() with priority: 0 }
    let high = { Conduit.JobConfig.default() with priority: 100 }
    assert_eq_int(low.priority, 0)
    assert_eq_int(high.priority, 100)
    assert_true(high.priority > low.priority)
  end

  test "on_dead_letter_callback_in_config" do
    let fired_key = Vault.new("odl_" ++ base64_encode(random_bytes(16)))
    Vault.set(fired_key, "fired", false)
    let cb = fn (_info : Conduit.JobInfo) -> Vault.set(fired_key, "fired", true)
    let cfg = { Conduit.JobConfig.default() with on_dead_letter: Some(cb) }
    assert_some(cfg.on_dead_letter)
    match cfg.on_dead_letter do
      None    -> assert_true(false)
      Some(f) ->
        let dummy_info : Conduit.JobInfo = {
          id: "x", queue: "q", job_type: "t",
          attempt: 1, max_attempts: 3, tags: Nil,
          inserted_at: DateTime.from_timestamp(DateTime.now()), errors: Nil
        }
        f(dummy_info)
        assert_eq_bool(Vault.get(fired_key, "fired") |> unwrap_or(false), true)
    end
  end

