mod Conduit.Dashboard.Router do
  doc """
  HTTP request handler for the Conduit Dashboard.

  Can be used in two ways:

  1. Embedded in a Bastion app:
       forward "/conduit", Conduit.Dashboard.Router,
         storage: storage, auth: MyApp.AdminAuth

  2. Standalone (via Conduit.Dashboard.start_standalone/3):
       HttpServer.plug(fn conn -> handle(storage, auth, "/conduit", conn) end)

  Routes:
    GET  /                          — overview
    GET  /queues                    — queue list
    GET  /queues/:queue             — queue detail  (?status=&page=)
    GET  /jobs/:id                  — job detail
    POST /jobs/:id/retry            — retry job
    POST /jobs/:id/cancel           — cancel job
    POST /jobs/:id/delete           — delete job
    GET  /workflows                 — workflow list  (?status=&page=)
    GET  /workflows/:id             — workflow detail
    POST /workflows/:id/cancel      — cancel workflow
    GET  /crons                     — cron list
    POST /crons/:id/trigger         — trigger now
    POST /crons/:id/pause           — pause
    POST /crons/:id/resume          — resume
    POST /crons/:id/delete          — delete cron
    GET  /dead-letters              — dead letters  (?page=)
    POST /dead-letters/:id/retry    — retry one
    POST /dead-letters/:id/delete   — delete one
    POST /dead-letters/retry-all    — retry all
    POST /dead-letters/delete-all   — delete all
    GET  /nodes                     — cluster nodes
    GET  /api/summary               — JSON summary for polling
  """
  fn handle(storage : s, auth, base_path : String, conn : Conn) do
    if Conduit.Dashboard.Auth.check(auth, conn) do
      let method   : Atom         = HttpServer.method(conn)
      let segments : List(String) = HttpServer.path_info(conn)
      -- Defence-in-depth CSRF check: state-changing requests must originate
      -- from the same host.  The dashboard's primary auth (Bearer token in
      -- Authorization header) is not vulnerable to classic CSRF, but operators
      -- often deploy behind an SSO proxy that injects credentials via cookies,
      -- which restores the risk.  Reject POST/PUT/DELETE/PATCH whose Origin
      -- (preferred) or Referer header does not match the request Host.
      if pis_state_changing(method) do
        if pcheck_same_origin(conn) do
          pdispatch(storage, base_path, method, segments, conn)
        else
          conn |> HttpServer.text(403, "Forbidden: cross-origin request blocked")
        end
      else
        pdispatch(storage, base_path, method, segments, conn)
      end
    else
      conn
      |> HttpServer.put_resp_header("www-authenticate", "Bearer realm=\"Conduit Dashboard\"")
      |> HttpServer.text(401, "Unauthorized")
    end
  end

  -- POST/PUT/DELETE/PATCH are mutations and must pass the same-origin check.
  -- GET/HEAD/OPTIONS are reads and exempt.
  pfn pis_state_changing(method : Atom) : Bool do
    match method do
      :post   -> true
      :put    -> true
      :delete -> true
      :patch  -> true
      _       -> false
    end
  end

  -- Returns true if the request's Origin (or, as a fallback, Referer) header
  -- targets the same host as the request itself.  Returns false if neither
  -- header is present or if the host does not match.
  --
  -- This is intentionally strict: requests with no Origin AND no Referer are
  -- rejected, because that combination is a hallmark of forged form posts.
  pfn pcheck_same_origin(conn) : Bool do
    let host    = HttpServer.get_req_header(conn, "host")    |> unwrap_or("")
    let origin  = HttpServer.get_req_header(conn, "origin")  |> unwrap_or("")
    let referer = HttpServer.get_req_header(conn, "referer") |> unwrap_or("")
    if String.is_empty(host) do
      false
    else
      if !String.is_empty(origin) do
        porigin_host_matches(origin, host)
      else
        if !String.is_empty(referer) do
          porigin_host_matches(referer, host)
        else
          false
        end
      end
    end
  end

  -- Parse the host out of an Origin or Referer URL and compare to the
  -- expected host.  Conservatively returns false on parse failure.
  pfn porigin_host_matches(url : String, expected_host : String) : Bool do
    -- Strip scheme: take the part after "://".
    let after_scheme = match String.split(url, "://") do
      Cons(_, Cons(rest, _)) -> rest
      _                      -> ""
    end
    if String.is_empty(after_scheme) do
      false
    else
      -- Take the host portion (up to the first "/", "?", or "#").
      let host_part = match String.split(after_scheme, "/") do
        Cons(h, _) -> h
        Nil        -> after_scheme
      end
      host_part == expected_host
    end
  end

  -- Inject any `?flash=<kind>&code=<code>` flash banner into the rendered HTML.
  -- Inserted right after the opening <main> so it appears above the page H1.
  pfn pinject_flash(html : String, qs : String) : String do
    let kind = pquery_param(qs, "flash")
    let code = pquery_param(qs, "code")
    let banner = Conduit.Dashboard.Html.flash_from_query(kind, code)
    if String.is_empty(banner) do
      html
    else
      String.replace(html, "<main class=\"main-content\">", "<main class=\"main-content\">" ++ banner)
    end
  end

  -- Render a successful redirect after an action, with a flash code preserved
  -- in the query string so the destination page can show a confirmation banner.
  pfn predirect_flash(conn, path : String, code : String) do
    conn |> HttpServer.redirect(path ++ "?flash=success&code=" ++ code)
  end

  -- Render an error response after an action.  Encodes a generic error flash
  -- (without leaking server details into URLs) and redirects to `path`.
  pfn predirect_error(conn, path : String) do
    conn |> HttpServer.redirect(path ++ "?flash=error&code=action_failed")
  end

  -- Render a 200 OK with the page HTML, injecting any active flash banner.
  pfn psend_html_with_flash(conn, html : String) do
    let qs = HttpServer.query_string(conn)
    conn |> HttpServer.html(200, pinject_flash(html, qs))
  end

  pfn pdispatch(storage : s, base_path : String, method : Atom, segments : List(String), conn : Conn) do
    match segments do

      -- Overview
      Nil ->
        if method == :get do
          let summary = Conduit.Dashboard.Queries.queue_summary(storage)
          let nodes   = Conduit.Dashboard.Queries.nodes(storage)
          let leader  = Conduit.cluster_leader()
          let html    = Conduit.Dashboard.Pages.Overview.render(base_path, summary, nodes, leader)
          psend_html_with_flash(conn, html)
        else
          conn |> HttpServer.text(405, "Method Not Allowed")
        end

      -- Queue list or queue detail
      Cons("queues", rest) ->
        match rest do
          Nil ->
            if method == :get do
              let summary = Conduit.Dashboard.Queries.queue_summary(storage)
              let html    = Conduit.Dashboard.Pages.Queues.render_list(base_path, summary)
              psend_html_with_flash(conn, html)
            else
              conn |> HttpServer.text(405, "Method Not Allowed")
            end
          Cons(queue, Nil) ->
            if method == :get do
              let qs      = HttpServer.query_string(conn)
              let status_filter = pquery_param(qs, "status")
              let page    = pparse_page(qs)
              let jobs    = Conduit.Dashboard.Queries.jobs_list(storage, queue, status_filter, page)
              let html    = Conduit.Dashboard.Pages.Queues.render_detail(base_path, queue, status_filter, jobs, page)
              psend_html_with_flash(conn, html)
            else
              conn |> HttpServer.text(405, "Method Not Allowed")
            end
          _ ->
            conn |> HttpServer.text(404, "Not found")
        end

      -- Job routes
      Cons("jobs", rest) ->
        match rest do
          Cons(job_id, Nil) ->
            if method == :get do
              match Conduit.Dashboard.Queries.job_by_id(storage, job_id) do
                None      -> conn |> HttpServer.text(404, "Job not found")
                Some(job) ->
                  let html = Conduit.Dashboard.Pages.Jobs.render(base_path, job)
                  psend_html_with_flash(conn, html)
              end
            else
              conn |> HttpServer.text(405, "Method Not Allowed")
            end
          Cons(job_id, Cons("retry", Nil)) ->
            if method == :post do
              match Conduit.Dashboard.Actions.retry_job(storage, job_id) do
                Ok(_)  -> predirect_flash(conn, base_path ++ "/jobs/" ++ job_id, "job_retried")
                Err(e) ->
                  let _ = Logger.warn("conduit_dashboard: retry_job " ++ job_id ++ " failed: " ++ e)
                  predirect_error(conn, base_path ++ "/jobs/" ++ job_id)
              end
            else
              conn |> HttpServer.text(405, "Method Not Allowed")
            end
          Cons(job_id, Cons("cancel", Nil)) ->
            if method == :post do
              match Conduit.Dashboard.Actions.cancel_job(storage, job_id) do
                Ok(_)  -> predirect_flash(conn, base_path ++ "/jobs/" ++ job_id, "job_cancelled")
                Err(e) ->
                  let _ = Logger.warn("conduit_dashboard: cancel_job " ++ job_id ++ " failed: " ++ e)
                  predirect_error(conn, base_path ++ "/jobs/" ++ job_id)
              end
            else
              conn |> HttpServer.text(405, "Method Not Allowed")
            end
          Cons(job_id, Cons("delete", Nil)) ->
            if method == :post do
              match Conduit.Dashboard.Actions.delete_job(storage, job_id) do
                Ok(_) ->
                  let queue = pextract_queue_from_referer(conn)
                  predirect_flash(conn, base_path ++ "/queues/" ++ queue, "job_deleted")
                Err(e) ->
                  let _ = Logger.warn("conduit_dashboard: delete_job " ++ job_id ++ " failed: " ++ e)
                  predirect_error(conn, base_path ++ "/queues/default")
              end
            else
              conn |> HttpServer.text(405, "Method Not Allowed")
            end
          _ ->
            conn |> HttpServer.text(404, "Not found")
        end

      -- Workflow routes
      Cons("workflows", rest) ->
        match rest do
          Nil ->
            if method == :get do
              let qs      = HttpServer.query_string(conn)
              let status_filter = pquery_param(qs, "status")
              let page    = pparse_page(qs)
              let wfs     = Conduit.Dashboard.Queries.workflows(storage, status_filter, page)
              let html    = Conduit.Dashboard.Pages.Workflows.render_list(base_path, wfs, status_filter, page)
              psend_html_with_flash(conn, html)
            else
              conn |> HttpServer.text(405, "Method Not Allowed")
            end
          Cons(wf_id, Nil) ->
            if method == :get do
              match Conduit.Dashboard.Queries.workflow_by_id(storage, wf_id) do
                None     -> conn |> HttpServer.text(404, "Workflow not found")
                Some(wf) ->
                  let cps     = Conduit.Dashboard.Queries.workflow_checkpoints(storage, wf_id)
                  let signals = Nil    -- Phase 6: signal list query deferred
                  let html    = Conduit.Dashboard.Pages.Workflows.render_detail(base_path, wf, cps, signals)
                  psend_html_with_flash(conn, html)
              end
            else
              conn |> HttpServer.text(405, "Method Not Allowed")
            end
          Cons(wf_id, Cons("cancel", Nil)) ->
            if method == :post do
              match Conduit.Dashboard.Actions.cancel_workflow(storage, wf_id) do
                Ok(_)  -> predirect_flash(conn, base_path ++ "/workflows/" ++ wf_id, "workflow_cancelled")
                Err(e) ->
                  let _ = Logger.warn("conduit_dashboard: cancel_workflow " ++ wf_id ++ " failed: " ++ e)
                  predirect_error(conn, base_path ++ "/workflows/" ++ wf_id)
              end
            else
              conn |> HttpServer.text(405, "Method Not Allowed")
            end
          _ ->
            conn |> HttpServer.text(404, "Not found")
        end

      -- Cron routes
      Cons("crons", rest) ->
        match rest do
          Nil ->
            if method == :get do
              let crons = Conduit.Dashboard.Queries.crons(storage)
              let html  = Conduit.Dashboard.Pages.Crons.render(base_path, crons)
              psend_html_with_flash(conn, html)
            else
              conn |> HttpServer.text(405, "Method Not Allowed")
            end
          Cons(cron_id, Cons("trigger", Nil)) ->
            if method == :post do
              match Conduit.Dashboard.Actions.trigger_cron_now(storage, cron_id) do
                Ok(_)  -> predirect_flash(conn, base_path ++ "/crons", "cron_triggered")
                Err(e) ->
                  let _ = Logger.warn("conduit_dashboard: trigger_cron " ++ cron_id ++ " failed: " ++ e)
                  predirect_error(conn, base_path ++ "/crons")
              end
            else
              conn |> HttpServer.text(405, "Method Not Allowed")
            end
          Cons(cron_id, Cons("pause", Nil)) ->
            if method == :post do
              match Conduit.Dashboard.Actions.pause_cron(storage, cron_id) do
                Ok(_)  -> predirect_flash(conn, base_path ++ "/crons", "cron_paused")
                Err(e) ->
                  let _ = Logger.warn("conduit_dashboard: pause_cron " ++ cron_id ++ " failed: " ++ e)
                  predirect_error(conn, base_path ++ "/crons")
              end
            else
              conn |> HttpServer.text(405, "Method Not Allowed")
            end
          Cons(cron_id, Cons("resume", Nil)) ->
            if method == :post do
              match Conduit.Dashboard.Actions.resume_cron(storage, cron_id) do
                Ok(_)  -> predirect_flash(conn, base_path ++ "/crons", "cron_resumed")
                Err(e) ->
                  let _ = Logger.warn("conduit_dashboard: resume_cron " ++ cron_id ++ " failed: " ++ e)
                  predirect_error(conn, base_path ++ "/crons")
              end
            else
              conn |> HttpServer.text(405, "Method Not Allowed")
            end
          Cons(cron_id, Cons("delete", Nil)) ->
            if method == :post do
              match Conduit.Dashboard.Actions.delete_cron(storage, cron_id) do
                Ok(_)  -> predirect_flash(conn, base_path ++ "/crons", "cron_deleted")
                Err(e) ->
                  let _ = Logger.warn("conduit_dashboard: delete_cron " ++ cron_id ++ " failed: " ++ e)
                  predirect_error(conn, base_path ++ "/crons")
              end
            else
              conn |> HttpServer.text(405, "Method Not Allowed")
            end
          _ ->
            conn |> HttpServer.text(404, "Not found")
        end

      -- Dead letter routes
      Cons("dead-letters", rest) ->
        match rest do
          Nil ->
            if method == :get do
              let qs   = HttpServer.query_string(conn)
              let page = pparse_page(qs)
              let dls  = Conduit.Dashboard.Queries.dead_letters(storage, page)
              let html = Conduit.Dashboard.Pages.DeadLetters.render(base_path, dls, page)
              psend_html_with_flash(conn, html)
            else
              conn |> HttpServer.text(405, "Method Not Allowed")
            end
          Cons("retry-all", Nil) ->
            if method == :post do
              let _ = Conduit.Dashboard.Actions.retry_all_dead_letters(storage)
              predirect_flash(conn, base_path ++ "/dead-letters", "dl_all_retried")
            else
              conn |> HttpServer.text(405, "Method Not Allowed")
            end
          Cons("delete-all", Nil) ->
            if method == :post do
              let _ = Conduit.Dashboard.Actions.delete_all_dead_letters(storage)
              predirect_flash(conn, base_path ++ "/dead-letters", "dl_all_deleted")
            else
              conn |> HttpServer.text(405, "Method Not Allowed")
            end
          Cons(dl_id, Cons("retry", Nil)) ->
            if method == :post do
              match Conduit.Dashboard.Actions.retry_dead_letter(storage, dl_id) do
                Ok(_)  -> predirect_flash(conn, base_path ++ "/dead-letters", "dl_retried")
                Err(e) ->
                  let _ = Logger.warn("conduit_dashboard: retry_dead_letter " ++ dl_id ++ " failed: " ++ e)
                  predirect_error(conn, base_path ++ "/dead-letters")
              end
            else
              conn |> HttpServer.text(405, "Method Not Allowed")
            end
          Cons(dl_id, Cons("delete", Nil)) ->
            if method == :post do
              match Conduit.Dashboard.Actions.delete_dead_letter(storage, dl_id) do
                Ok(_)  -> predirect_flash(conn, base_path ++ "/dead-letters", "dl_deleted")
                Err(e) ->
                  let _ = Logger.warn("conduit_dashboard: delete_dead_letter " ++ dl_id ++ " failed: " ++ e)
                  predirect_error(conn, base_path ++ "/dead-letters")
              end
            else
              conn |> HttpServer.text(405, "Method Not Allowed")
            end
          _ ->
            conn |> HttpServer.text(404, "Not found")
        end

      -- Nodes
      Cons("nodes", Nil) ->
        if method == :get do
          let nodes  = Conduit.Dashboard.Queries.nodes(storage)
          let leader = Conduit.cluster_leader()
          let html   = Conduit.Dashboard.Pages.Nodes.render(base_path, nodes, leader)
          psend_html_with_flash(conn, html)
        else
          conn |> HttpServer.text(405, "Method Not Allowed")
        end

      -- JSON summary API endpoint (for polling-based real-time updates)
      Cons("api", Cons("summary", Nil)) ->
        if method == :get do
          let summary = Conduit.Dashboard.Queries.queue_summary(storage)
          let json    = psummary_to_json(summary)
          conn
          |> HttpServer.put_resp_header("content-type", "application/json")
          |> HttpServer.text(200, json)
        else
          conn |> HttpServer.text(405, "Method Not Allowed")
        end

      -- 404 fallback
      _ ->
        conn |> HttpServer.text(404, "Not found")
    end
  end

  -- Parse the ?page= query param, defaulting to 1. Returns a plain Int
  -- via explicit match to avoid polymorphic boxing of the result.
  pfn pparse_page(qs : String) : Int do
    match String.to_int(pquery_param(qs, "page")) do
      Ok(n)  -> n
      Err(_) -> 1
    end
  end

  -- Parse a single query parameter value by name from a raw query string.
  -- e.g. "status=pending&page=2" |> pquery_param("page") -> "2"
  pfn pquery_param(qs : String, key : String) : String do
    if String.is_empty(qs) do
      ""
    else
      let pairs = String.split(qs, "&")
      let found = List.find(pairs, fn pair -> ppair_matches_key(pair, key))
      match found do
        None      -> ""
        Some(pair) ->
          let parts = String.split(pair, "=")
          match parts do
            Cons(_, Cons(v, _)) -> v
            _                   -> ""
          end
      end
    end
  end

  -- Try to extract the originating queue from the Referer header (best-effort).
  -- The Referer is attacker-controlled, so the candidate queue name must be
  -- validated before being concatenated into a redirect URL.  Anything
  -- containing characters outside [A-Za-z0-9_-] is rejected and we fall back
  -- to "default", preventing path traversal, scheme injection, and quote
  -- breakouts via a forged Referer header.
  pfn pextract_queue_from_referer(conn) : String do
    let referer = HttpServer.get_req_header(conn, "referer") |> unwrap_or("")
    if String.contains(referer, "/queues/") do
      let parts = String.split(referer, "/queues/")
      let candidate = match parts do
        Cons(_, Cons(rest, _)) ->
          -- Strip everything after the queue segment: "/", "?", or "#".
          let after_slash = match String.split(rest, "/") do
            Cons(h, _) -> h
            Nil        -> rest
          end
          let after_q = match String.split(after_slash, "?") do
            Cons(h, _) -> h
            Nil        -> after_slash
          end
          match String.split(after_q, "#") do
            Cons(h, _) -> h
            Nil        -> after_q
          end
        _ -> ""
      end
      if pis_safe_queue_name(candidate) do candidate else "default" end
    else
      "default"
    end
  end

  -- True if `s` matches /^[A-Za-z0-9_-]+$/ — the queue naming convention used
  -- elsewhere in the codebase.  Used to validate Referer-derived queue names
  -- before they are concatenated into a redirect URL.
  pfn pis_safe_queue_name(s : String) : Bool do
    if String.is_empty(s) do
      false
    else
      Regex.matches("^[A-Za-z0-9_-]+$", s)
    end
  end

  pfn ppair_matches_key(pair : String, key : String) : Bool do
    let parts = String.split(pair, "=")
    match parts do
      Cons(k, _) -> k == key
      Nil        -> false
    end
  end

  pfn psummary_to_json(summary : List(Conduit.Dashboard.QueueSummary)) : String do
    let items = List.map(summary, fn s -> psummary_item_to_json(s))
    "[" ++ String.join(items, ",") ++ "]"
  end

  -- Build one JSON object for a queue summary row.
  --
  -- Queue names are user-supplied strings and may contain double quotes or
  -- backslashes.  Use pjson_escape (not Html.escape — HTML entities are not
  -- valid JSON escapes and would corrupt the output).
  pfn psummary_item_to_json(s : Conduit.Dashboard.QueueSummary) : String do
    "{\"queue\":\"" ++ pjson_escape(s.queue) ++ "\""
    ++ ",\"pending\":"    ++ int_to_string(s.pending)
    ++ ",\"running\":"    ++ int_to_string(s.running)
    ++ ",\"failed\":"     ++ int_to_string(s.failed)
    ++ ",\"dead\":"       ++ int_to_string(s.dead)
    ++ ",\"throughput\":" ++ int_to_string(s.throughput)
    ++ "}"
  end

  -- Escape a string for embedding inside a JSON double-quoted string value.
  pfn pjson_escape(s : String) : String do
    s
    |> String.replace("\\", "\\\\")
    |> String.replace("\"", "\\\"")
    |> String.replace("\n", "\\n")
    |> String.replace("\r", "\\r")
  end
end
