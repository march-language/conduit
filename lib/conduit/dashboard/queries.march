-- Conduit.Dashboard.Queries — read-only data layer for the dashboard.
--
-- All functions return safe defaults (Nil / None) on storage errors rather than
-- propagating exceptions, so dashboard pages degrade gracefully when the DB is
-- under pressure.
mod Conduit.Dashboard.Queries do

  doc "Load per-queue aggregate stats for the overview page."
  fn queue_summary(storage) : List(Conduit.Dashboard.QueueSummary) do
    match Conduit.Storage.dashboard_queue_summary(storage) do
      Ok(rows) -> rows
      Err(e)   ->
        Logger.warn("conduit_dashboard: queue_summary failed: " ++ e)
        Nil
    end
  end

  doc "Load a paginated list of jobs (queue + optional status filter, 1-based page)."
  fn jobs_list(storage, queue : String, status_filter : String, page : Int) : List(Conduit.JobRow) do
    match Conduit.Storage.dashboard_jobs_list(storage, queue, status_filter, page) do
      Ok(rows) -> rows
      Err(e)   ->
        Logger.warn("conduit_dashboard: jobs_list failed: " ++ e)
        Nil
    end
  end

  doc "Load a paginated list of dead letters (1-based page)."
  fn dead_letters(storage, page : Int) : List(Conduit.DeadLetter) do
    match Conduit.Storage.dead_letter_list(storage, page) do
      Ok(rows) -> rows
      Err(e)   ->
        Logger.warn("conduit_dashboard: dead_letters failed: " ++ e)
        Nil
    end
  end

  doc "Load all active cluster nodes."
  fn nodes(storage) : List(Conduit.NodeInfo) do
    match Conduit.Storage.node_list_active(storage) do
      Ok(ns) -> ns
      Err(e) ->
        Logger.warn("conduit_dashboard: nodes failed: " ++ e)
        Nil
    end
  end

  doc """
  Load all cron schedules (enabled and disabled) for the crons page.

  Uses `dashboard_crons_list` which returns every schedule regardless of
  whether it is currently due.  The old `cron_load_due` call only returned
  schedules past their next_run_at, which meant disabled and future crons were
  invisible to the dashboard.
  """
  fn crons(storage) : List(Conduit.CronSchedule) do
    match Conduit.Storage.dashboard_crons_list(storage) do
      Ok(rows) -> rows
      Err(e)   ->
        Logger.warn("conduit_dashboard: crons failed: " ++ e)
        Nil
    end
  end

  doc """
  Load a single job by id.

  Uses the dedicated `dashboard_job_by_id` storage method for an O(1) lookup
  by primary key.  The previous implementation loaded all jobs on page 1 and
  did a linear scan in memory — both slow and incomplete (missed jobs on later
  pages).
  """
  fn job_by_id(storage, job_id : String) : Option(Conduit.JobRow) do
    match Conduit.Storage.dashboard_job_by_id(storage, job_id) do
      Ok(opt) -> opt
      Err(e)  ->
        Logger.warn("conduit_dashboard: job_by_id failed: " ++ e)
        None
    end
  end

  doc """
  Load a paginated list of workflows with optional status filter (1-based page).

  Passes the page parameter to the storage layer so the DB applies the LIMIT /
  OFFSET, rather than loading all workflows into memory and ignoring pagination.
  """
  fn workflows(storage, status_filter : String, page : Int) : List(Conduit.WorkflowRow) do
    match Conduit.Storage.dashboard_workflows_list(storage, status_filter, page) do
      Ok(rows) -> rows
      Err(e)   ->
        Logger.warn("conduit_dashboard: workflow_list failed: " ++ e)
        Nil
    end
  end

  doc "Load workflow detail by id."
  fn workflow_by_id(storage, wf_id : String) : Option(Conduit.WorkflowRow) do
    match Conduit.Storage.workflow_load(storage, wf_id) do
      Ok(opt) -> opt
      Err(e)  ->
        Logger.warn("conduit_dashboard: workflow_by_id failed: " ++ e)
        None
    end
  end

  doc "Load all checkpoints for a workflow."
  fn workflow_checkpoints(storage, wf_id : String) : List(Conduit.WorkflowCheckpoint) do
    match Conduit.Storage.checkpoint_load_all(storage, wf_id) do
      Ok(cps) -> cps
      Err(e)  ->
        Logger.warn("conduit_dashboard: checkpoints failed: " ++ e)
        Nil
    end
  end
end
