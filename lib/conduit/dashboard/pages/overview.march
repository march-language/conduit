mod Conduit.Dashboard.Pages.Overview do
  needs IO.Clock

  doc "The queue-summary table (the content of the Queue Summary panel)."
  fn summary_fragment(summary : List(Conduit.Dashboard.QueueSummary)) : String do
    let summary_rows = List.map(summary, fn s ->
      Cons(
        Html.escape(s.queue),
        Cons(
          int_to_string(s.pending),
          Cons(
            int_to_string(s.running),
            Cons(
              int_to_string(s.failed),
              Cons(
                int_to_string(s.dead),
                Cons(
                  int_to_string(s.throughput),
                  Cons(
                    int_to_string(s.avg_latency),
                    Nil
                  )
                )
              )
            )
          )
        )
      )
    )

    let summary_headers = Cons("Queue", Cons("Pending", Cons("Running", Cons("Failed", Cons("Dead", Cons("Throughput (24h)", Cons("Avg Latency (ms)", Nil)))))))

    Conduit.Dashboard.Html.table_with_empty(summary_headers, summary_rows, "No queues yet — enqueue a job to see one here.")
  end

  doc "The cluster summary (the content of the Cluster panel)."
  fn cluster_fragment(nodes : List(Conduit.NodeInfo), leader : Option(String)) : String do
    let leader_id = Option.unwrap_or(leader, "none")
    let node_count = List.length(nodes)
    "<p style=\"font-size:14px;color:#555;\">Active Nodes: <strong>" ++ int_to_string(node_count) ++ "</strong> &nbsp;&nbsp; Leader: <strong>" ++ Html.escape(leader_id) ++ "</strong></p>"
  end

  doc """
  Renders the overview page with the data inline (one round trip; the page is only
  as fast as its slowest storage call). Prefer `render_shell`, which paints at once
  and loads each panel separately.
  """
  fn render(base_path : String, summary : List(Conduit.Dashboard.QueueSummary), nodes : List(Conduit.NodeInfo), leader : Option(String)) : String do
    let poll_script = "<script>setInterval(function(){ fetch(window.location.href).then(function(r){ if(r.ok) window.location.reload() }) }, 5000)</script>"

    let content = "<h1>Overview</h1><div class=\"section\"><h2>Queue Summary</h2>" ++ summary_fragment(summary) ++ "</div><div class=\"section\"><h2>Cluster</h2>" ++ cluster_fragment(nodes, leader) ++ "</div>" ++ poll_script

    Conduit.Dashboard.Html.page_with_nav("Overview", base_path, "overview", content)
  end

  doc """
  The overview page as an instant shell: each panel is an empty placeholder that
  the page's script fills from `<base_path>/fragments/<name>` — so a slow or failing
  storage call delays/blanks only its own panel (with an error message), never the
  whole page, and the panels refresh in place every 5s instead of reloading.
  """
  fn render_shell(base_path : String) : String do
    let script = "<script>(function(){var panels=['summary','cluster'];function load(n){var el=document.getElementById('panel-'+n);fetch('" ++ base_path ++ "/fragments/'+n,{credentials:'same-origin'}).then(function(r){if(!r.ok)throw new Error(r.status);return r.text()}).then(function(h){el.innerHTML=h}).catch(function(){el.innerHTML='<p style=\"color:#b00;font-size:14px;\">Could not load this panel. It will retry.</p>'})}function all(){panels.forEach(load)}all();setInterval(all,5000)})()</script>"

    let content = "<h1>Overview</h1><div class=\"section\"><h2>Queue Summary</h2><div id=\"panel-summary\"><p style=\"color:#777;font-size:14px;\">Loading…</p></div></div><div class=\"section\"><h2>Cluster</h2><div id=\"panel-cluster\"><p style=\"color:#777;font-size:14px;\">Loading…</p></div></div>" ++ script

    Conduit.Dashboard.Html.page_with_nav("Overview", base_path, "overview", content)
  end
end
