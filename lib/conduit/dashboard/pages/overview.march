mod Conduit.Dashboard.Pages.Overview do
  needs IO.Clock

  pfn psummary_row(s : Conduit.Dashboard.QueueSummary) : List(IOList) do
    [
      ~H"""${s.queue}""",
      IOList.from_string(int_to_string(s.pending)),
      IOList.from_string(int_to_string(s.running)),
      IOList.from_string(int_to_string(s.failed)),
      IOList.from_string(int_to_string(s.dead)),
      IOList.from_string(int_to_string(s.throughput)),
      IOList.from_string(int_to_string(s.avg_latency))
    ]
  end

  doc "The queue-summary table (the content of the Queue Summary panel), as an IOList."
  fn summary_fragment_io(summary : List(Conduit.Dashboard.QueueSummary)) : IOList do
    let headers = ["Queue", "Pending", "Running", "Failed", "Dead", "Throughput (24h)", "Avg Latency (ms)"]
    Conduit.Dashboard.Html.table_with_empty_io(headers, List.map(summary, fn s -> psummary_row(s)), "No queues yet — enqueue a job to see one here.")
  end

  doc "The queue-summary table (the content of the Queue Summary panel)."
  fn summary_fragment(summary : List(Conduit.Dashboard.QueueSummary)) : String do
    IOList.to_string(summary_fragment_io(summary))
  end

  doc "The cluster summary (the content of the Cluster panel), as an IOList."
  fn cluster_fragment_io(nodes : List(Conduit.NodeInfo), leader : Option(String)) : IOList do
    let leader_id = Option.unwrap_or(leader, "none")
    let node_count = int_to_string(List.length(nodes))
    ~H"""<p style="font-size:14px;color:#555;">Active Nodes: <strong>${node_count}</strong> &nbsp;&nbsp; Leader: <strong>${leader_id}</strong></p>"""
  end

  doc "The cluster summary (the content of the Cluster panel)."
  fn cluster_fragment(nodes : List(Conduit.NodeInfo), leader : Option(String)) : String do
    IOList.to_string(cluster_fragment_io(nodes, leader))
  end

  doc """
  Renders the overview page with the data inline (one round trip; the page is only
  as fast as its slowest storage call). Prefer `render_shell`, which paints at once
  and loads each panel separately.
  """
  fn render(base_path : String, summary : List(Conduit.Dashboard.QueueSummary), nodes : List(Conduit.NodeInfo), leader : Option(String)) : String do
    let content = ~H"""<h1>Overview</h1><div class="section"><h2>Queue Summary</h2>${summary_fragment_io(summary)}</div><div class="section"><h2>Cluster</h2>${cluster_fragment_io(nodes, leader)}</div>"""
    IOList.to_string(Conduit.Dashboard.Html.page_io("Overview", base_path, "overview", content))
  end

  doc """
  The overview page as an instant shell: each panel is an empty placeholder that
  dashboard.js (a same-origin file, so strict CSPs allow it) fills from
  `<base_path>/fragments/<name>` — so a slow or failing storage call delays/blanks
  only its own panel (with an error message), never the whole page, and the panels
  refresh in place every 5s instead of reloading.
  """
  fn render_shell(base_path : String) : String do
    let content = ~H"""<h1>Overview</h1><div class="section"><h2>Queue Summary</h2><div id="panel-summary"><p style="color:#777;font-size:14px;">Loading&hellip;</p></div></div><div class="section"><h2>Cluster</h2><div id="panel-cluster"><p style="color:#777;font-size:14px;">Loading&hellip;</p></div></div>"""
    IOList.to_string(Conduit.Dashboard.Html.page_io("Overview", base_path, "overview", content))
  end
end
