-- Conduit.Dashboard.Actions — write operations invoked by the dashboard UI.
--
-- All actions delegate to the Conduit public API or directly to storage.
-- The router calls these after verifying auth; they return Result so the router
-- can render an error page on failure.
mod Conduit.Dashboard.Actions do

  doc "Retry a job: reset to pending with attempt = 0."
  fn retry_job(storage : s, job_id : String) : Result((), String) do
    Conduit.Storage.job_retry(storage, job_id)
  end

  doc "Cancel a job: set status = dead."
  fn cancel_job(storage : s, job_id : String) : Result((), String) do
    Conduit.Storage.job_cancel(storage, job_id, "admin_cancel")
  end

  doc "Hard-delete a job row."
  fn delete_job(storage : s, job_id : String) : Result((), String) do
    Conduit.Storage.job_delete(storage, job_id)
  end

  doc """
  Retry a dead letter: re-enqueue the original job with a fresh attempt count
  and delete the dead letter entry.

  Uses the original job's queue from the dead letter row.  Re-enqueues using
  the performer's registered config if available (for correct backoff, DLQ, etc.);
  falls back to safe defaults for jobs whose performer is no longer registered.

  Returns the new job id on success.
  """
  fn retry_dead_letter(storage : s, dl_id : String) : Result(String, String) do
    match Conduit.Storage.dead_letter_load(storage, dl_id) do
      Err(e)     -> Err(e)
      Ok(None)   -> Err("dead letter not found: " ++ dl_id)
      Ok(Some(dl)) ->
        let base_config = Conduit.Queue.lookup_config(dl.job_type)
          |> Option.unwrap_or({
              queue             = dl.queue,
              max_attempts      = 3,
              timeout           = 30000,
              backoff           = Conduit.Backoff.exponential,
              dead_letter_queue = None,
              unique_for        = None,
              on_conflict       = Conduit.UniqueConflict.Ignore,
              rate_limit        = None,
              on_dead_letter    = None,
              priority          = 0,
              tags              = Nil,
              discard_after     = None
            })
        let job_config = { base_config with queue = dl.queue }
        match Conduit.Queue.enqueue(storage, dl.job_type, dl.payload, job_config) do
          Err(e)       -> Err(e)
          Ok(new_id) ->
            match Conduit.Storage.dead_letter_delete(storage, dl_id) do
              Err(e) ->
                Logger.warn("conduit_dashboard: retry_dead_letter: could not delete DL " ++ dl_id ++ ": " ++ e)
                Ok(new_id)    -- job was re-enqueued; deletion failure is non-fatal
              Ok(_) -> Ok(new_id)
            end
        end
    end
  end

  doc "Delete a dead letter entry."
  fn delete_dead_letter(storage, dl_id : String) : Result((), String) do
    Conduit.Storage.dead_letter_delete(storage, dl_id)
  end

  doc """
  Retry all dead letters in the table.

  Loads all dead letter rows via `dead_letter_list_all` (which fetches every
  page, not just page 1) and re-enqueues each one.  Returns the list of newly
  enqueued job ids.  Errors per entry are logged and skipped so one bad row
  does not abort the rest.
  """
  fn retry_all_dead_letters(storage : s) : List(String) do
    let dls = match Conduit.Storage.dead_letter_list_all(storage) do
      Ok(rows) -> rows
      Err(e)   ->
        Logger.warn("conduit_dashboard: retry_all: load failed: " ++ e)
        Nil
    end
    List.filter_map(dls, fn dl -> pretry_one_dl(storage, dl))
  end

  doc """
  Delete all dead letters in the table.

  Returns the count of deleted rows on success.  Errors are propagated to the
  caller so the router can render an appropriate error page.
  """
  fn delete_all_dead_letters(storage : s) : Result(Int, String) do
    Conduit.Storage.dead_letter_delete_all(storage)
  end

  pfn pretry_one_dl(storage : s, dl : Conduit.DeadLetter) : Option(String) do
    match retry_dead_letter(storage, dl.id) do
      Ok(new_id) -> Some(new_id)
      Err(e) ->
        let _ = Logger.warn("conduit_dashboard: retry_all: skipping " ++ dl.id ++ ": " ++ e)
        None
    end
  end

  doc "Trigger a cron job immediately (bypasses the schedule)."
  fn trigger_cron_now(storage : s, cron_id : String) : Result(String, String) do
    match Conduit.Storage.cron_load_by_id(storage, cron_id) do
      Err(e)       -> Err(e)
      Ok(None)     -> Err("cron schedule not found: " ++ cron_id)
      Ok(Some(sched)) ->
        let base_config = Conduit.Queue.lookup_config(sched.job_type)
          |> Option.unwrap_or(Conduit.JobConfig.default())
        let job_config = { base_config with queue = sched.queue }
        Conduit.Queue.enqueue(storage, sched.job_type, sched.payload, job_config)
    end
  end

  doc "Pause a cron schedule (set enabled = false)."
  fn pause_cron(storage : s, cron_id : String) : Result((), String) do
    Conduit.pause_cron(storage, cron_id)
  end

  doc "Resume a paused cron schedule (set enabled = true)."
  fn resume_cron(storage : s, cron_id : String) : Result((), String) do
    Conduit.resume_cron(storage, cron_id)
  end

  doc "Permanently delete a cron schedule."
  fn delete_cron(storage : s, cron_id : String) : Result((), String) do
    Conduit.cancel_cron(storage, cron_id)
  end

  doc "Cancel a running workflow."
  fn cancel_workflow(storage : s, wf_id : String) : Result((), String) do
    Conduit.cancel_workflow(wf_id, "cancelled_by_admin", storage)
  end
end
