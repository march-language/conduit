mod Conduit.Queue do
  ptype Entry = {
    performer : String -> Result((), Conduit.ConduitError),
    config    : Conduit.JobConfig
  }

  fn enqueue(storage, job_type : String, payload : String, config : Conduit.JobConfig) : Result(String, String) do
    let id  = uuid_v4()
    let now = DateTime.now()
    let unique_key = punique_key(job_type, config.queue, payload, config)
    match punique_guard(storage, unique_key, config) do
      Err(e) -> Err(e)
      Ok(existing_id) ->
        match existing_id do
          Some(eid) -> Ok(eid)
          None ->
            let row : Conduit.JobRow = {
              id                = id,
              queue             = config.queue,
              job_type          = job_type,
              payload           = payload,
              status            = "pending",
              attempt           = 0,
              max_attempts      = config.max_attempts,
              priority          = config.priority,
              backoff           = pbackoff_name(config.backoff),
              dead_letter_queue = config.dead_letter_queue,
              inserted_at       = now,
              scheduled_at      = now,
              run_at            = now,
              started_at        = None,
              completed_at      = None,
              heartbeat_at      = None,
              worker_id         = None,
              unique_key        = unique_key,
              errors            = Nil,
              tags              = config.tags
            }
            Conduit.Storage.enqueue(storage, row)
        end
    end
  end

  fn enqueue_in(storage, job_type : String, payload : String, delay : Int, config : Conduit.JobConfig) : Result(String, String) do
    let id     = uuid_v4()
    let now    = DateTime.now()
    let run_at = DateTime.add(now, delay)
    let unique_key = punique_key(job_type, config.queue, payload, config)
    match punique_guard(storage, unique_key, config) do
      Err(e) -> Err(e)
      Ok(existing_id) ->
        match existing_id do
          Some(eid) -> Ok(eid)
          None ->
            let row : Conduit.JobRow = {
              id                = id,
              queue             = config.queue,
              job_type          = job_type,
              payload           = payload,
              status            = "pending",
              attempt           = 0,
              max_attempts      = config.max_attempts,
              priority          = config.priority,
              backoff           = pbackoff_name(config.backoff),
              dead_letter_queue = config.dead_letter_queue,
              inserted_at       = now,
              scheduled_at      = now,
              run_at            = run_at,
              started_at        = None,
              completed_at      = None,
              heartbeat_at      = None,
              worker_id         = None,
              unique_key        = unique_key,
              errors            = Nil,
              tags              = config.tags
            }
            Conduit.Storage.enqueue(storage, row)
        end
    end
  end

  fn register_performer(job_type : String, performer : String -> Result((), Conduit.ConduitError), config : Conduit.JobConfig) : () do
    Vault.set(registry_key(), job_type, { performer = performer, config = config })
  end

  fn dispatch(job_type : String, payload : String) : Result((), Conduit.ConduitError) do
    match Vault.get(registry_key(), job_type) do
      None    ->
        Err(Conduit.ConduitError.Discard("No performer registered for job type: " ++ job_type))
      Some(e) ->
        e.performer(payload)
    end
  end

  fn lookup_config(job_type : String) : Option(Conduit.JobConfig) do
    match Vault.get(registry_key(), job_type) do
      None    -> None
      Some(e) -> Some(e.config)
    end
  end

  pfn pbackoff_name(b : Conduit.Backoff) : String do
    match b do
      Linear      -> "linear"
      Exponential -> "exponential"
      Fibonacci   -> "fibonacci"
      Custom(_)   -> "custom"
    end
  end

  pfn punique_key(job_type : String, queue : String, payload : String, config : Conduit.JobConfig) : Option(String) do
    match config.unique_for do
      None     -> None
      Some(uc) -> Some(Conduit.Unique.fingerprint(job_type, queue, payload, uc.fields, uc.scope))
    end
  end

  pfn punique_guard(storage, unique_key : Option(String), config : Conduit.JobConfig) : Result(Option(String), String) do
    match unique_key do
      None     -> Ok(None)
      Some(uk) ->
        match Conduit.Unique.conflicts(storage, uk) do
          Err(e)    -> Err(e)
          Ok(false) -> Ok(None)
          Ok(true)  ->
            match config.on_conflict do
              Ignore  -> Ok(Some("existing"))
              Raise   -> Err("unique constraint violated for key: " ++ uk)
              Replace -> Ok(None)
            end
        end
    end
  end

  pfn registry_key() : String do
    "conduit_performer_registry"
  end
end
