mod Conduit.WorkflowRunner do
  doc "The job_type constant (public so callers can use it in tests)."
  fn job_type() : String do
    "conduit.workflow_runner"
  end

  doc """
  Execute a workflow by id. This is called by the registered performer.

  Delegates to prun after loading and validating the workflow row.
  """
  fn execute(storage : s, payload : String) do
    Logger.debug("workflow_runner: execute payload=" ++ payload)
    let workflow_id = pparse_workflow_id(payload)
    Logger.debug("workflow_runner: execute workflow_id=" ++ workflow_id)
    if String.is_empty(workflow_id) do
      Err(Conduit.ConduitError.Discard("workflow_runner: missing workflow_id in payload: " ++ payload))
    else
      match Conduit.Storage.workflow_load(storage, workflow_id) do
        Err(e)      -> Err(Conduit.ConduitError.Retry("workflow_runner: storage error: " ++ e))
        Ok(None)    -> Err(Conduit.ConduitError.Discard("workflow_runner: workflow not found: " ++ workflow_id))
        Ok(Some(row)) ->
          Logger.debug("workflow_runner: loaded row status=" ++ row.status)
          -- Already in a terminal state — nothing to do.
          if pis_terminal(row.status) do
            Ok(())
          else
            prun(storage, workflow_id, row)
          end
      end
    end
  end

  doc """
  Enqueue a workflow_runner job for the given workflow_id.
  Called immediately after inserting a new workflow row.
  """
  fn enqueue(storage : s, workflow_id : String, config : Conduit.WorkflowConfig) : Result(String, String) do
    -- Use the registered config for the workflow runner performer (which carries
    -- the queue, priority, etc. set at startup).  Fall back to safe defaults if
    -- the performer has not been registered yet (e.g. during testing).
    let base_config = Conduit.Queue.lookup_config(job_type())
      |> Option.unwrap_or(Conduit.JobConfig.default())
    let job_config = { base_config with
      max_attempts  = 3,
      timeout       = 30000,
      backoff       = Conduit.Backoff.exponential,
      tags          = config.tags,
      discard_after = None
    }
    let payload = "{\"workflow_id\":\"" ++ workflow_id ++ "\"}"
    Conduit.Queue.enqueue(storage, job_type(), payload, job_config)
  end

  -- ─────────────────────────────────────────────────────────────
  -- Private: execution
  -- ─────────────────────────────────────────────────────────────

  pfn prun(storage : s, workflow_id : String, row : Conduit.WorkflowRow) do
    Logger.debug("workflow_runner: prun workflow_id=" ++ workflow_id ++ " wf_type=" ++ row.workflow_type)
    -- Check timeout.
    let timed_out = match row.timeout_at do
      None    -> false
      Some(t) -> DateTime.now() >= DateTime.to_timestamp(t)
    end
    if timed_out do
      let _ = pmark_status(storage, workflow_id, "timed_out", None, Some("Workflow exceeded timeout"))
      Ok(())
    else
      -- Build context and warm checkpoint cache.
      Logger.debug("workflow_runner: prun: building context")
      let ctx = Conduit.WorkflowContext.new(workflow_id)
      Logger.debug("workflow_runner: prun: warming cache")
      match Conduit.WorkflowContext.warm_cache(storage, ctx) do
        Err(e) -> Err(Conduit.ConduitError.Retry("workflow_runner: cache warm failed: " ++ e))
        Ok(_) ->
          -- If DeterministicReplay mode, warm the event replay cache.
          Logger.debug("workflow_runner: prun: looking up wf_config")
          let wf_config = match Conduit.WorkflowRegistry.lookup_config(row.workflow_type) do
            None    -> Conduit.WorkflowConfig.default()
            Some(c) -> c
          end
          Logger.debug("workflow_runner: prun: warming replay")
          let replay_warm_result = match wf_config.execution_mode do
            DeterministicReplay ->
              Conduit.EventStore.warm_replay(storage, workflow_id)
            _ -> Ok(())
          end
          match replay_warm_result do
            Err(e) -> Err(Conduit.ConduitError.Retry("workflow_runner: event warm failed: " ++ e))
            Ok(_) ->
              Logger.debug("workflow_runner: prun: calling WorkflowRegistry.run")
              -- Look up and run the registered workflow.
              match Conduit.WorkflowRegistry.run(row.workflow_type, row.input, ctx) do
                Ok(output_json) ->
                  let _ = pmark_status(storage, workflow_id, "completed", Some(output_json), None)
                  Ok(())
                Err(WorkflowError.Failed(msg)) ->
                  let _ = pmark_status(storage, workflow_id, "failed", None, Some(msg))
                  Err(Conduit.ConduitError.Discard("workflow failed: " ++ msg))
                Err(WorkflowError.Cancelled(msg)) ->
                  let _ = pmark_status(storage, workflow_id, "cancelled", None, Some(msg))
                  Ok(())
                Err(WorkflowError.TimedOut) ->
                  let _ = pmark_status(storage, workflow_id, "timed_out", None, Some("Timed out during execution"))
                  Ok(())
                Err(WorkflowError.StorageError(msg)) ->
                  -- Transient — let the job retry via normal backoff.
                  Err(Conduit.ConduitError.Retry("workflow_runner: storage error: " ++ msg))
              end
          end
      end
    end
  end

  pfn pmark_status(storage : s, workflow_id : String, status : String, output : Option(String), error : Option(String)) : () do
    match Conduit.Storage.workflow_update_status(storage, workflow_id, status, output, error) do
      Ok(_)   -> ()
      Err(e)  -> Logger.error("workflow_runner: failed to mark " ++ workflow_id ++ " as " ++ status ++ ": " ++ e)
    end
  end

  pfn pis_terminal(status : String) : Bool do
    status == "completed" || status == "failed" || status == "cancelled" || status == "timed_out"
  end

  -- Extract the workflow_id string from the job payload JSON.
  --
  -- Payload format: {"workflow_id":"<uuid>"}
  --
  -- Uses Json.parse + Json.get for correctness — the ad-hoc string-split
  -- approach fails on payloads with escaped characters, extra whitespace,
  -- or reordered keys.  Returns "" on any parse or type error so the caller
  -- can return a Discard error.
  pfn pparse_workflow_id(payload : String) : String do
    match Json.parse(payload) do
      Err(_)   -> ""
      Ok(json) ->
        match Json.get(json, "workflow_id") do
          None           -> ""
          Some(Json.Str(id)) -> id
          Some(_)        -> ""
        end
    end
  end
end
