    fn job_retry(self : Store, id : String) : Result((), String) do
      pexec(self, "UPDATE conduit_jobs SET status = 'pending', attempt = 0, run_at = $2, worker_id = NULL, completed_at = NULL WHERE id = $1",
        [ParamText(id), ParamText(int_to_string(DateTime.now()))])
    end

    fn job_cancel(self : Store, id : String, reason : String) : Result((), String) do
      pexec(self, "UPDATE conduit_jobs SET status = 'dead', completed_at = $2, errors = (COALESCE(errors,'[]')::jsonb || jsonb_build_array($3::text))::text WHERE id = $1",
        [ParamText(id), ParamText(int_to_string(DateTime.now())), ParamText(reason)])
    end

