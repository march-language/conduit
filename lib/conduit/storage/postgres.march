      pexec(self, "DELETE FROM conduit_dead_letters WHERE id = $1", [ParamText(id)])
    end

    -- LISTEN/NOTIFY needs a dedicated long-lived connection; with connection-
    -- per-operation a LISTEN would be dropped on close. The dashboard falls back
    -- to polling, so this is a no-op until T0.3 provides a pinned connection.
    fn notify_subscribe(_self, _channel) : Result((), String) do Ok(()) end

    -- ── Rate limiting & unique jobs ──────────────────────────────

    -- Atomic token bucket: refill `rate` tokens/sec up to capacity `rate`, then
    -- consume one. The DO UPDATE only fires (and RETURNS a row) when at least
    -- one token is available after refill, so "row returned" == acquired.
    fn rate_limit_acquire(self : Store, key : String, rate : Int) : Result(Bool, String) do
      let now = int_to_string(DateTime.now())
      let sql = "INSERT INTO conduit_rate_limit_buckets AS b (key, tokens, last_refill) VALUES ($1, $2::decimal - 1, $3) ON CONFLICT (key) DO UPDATE SET tokens = LEAST($2::decimal, b.tokens + $2::decimal * GREATEST($3 - b.last_refill, 0)) - 1, last_refill = $3 WHERE LEAST($2::decimal, b.tokens + $2::decimal * GREATEST($3 - b.last_refill, 0)) >= 1 RETURNING b.tokens"
      pwith_conn(self, fn conn ->
        match Db.exec(conn, sql, [ParamText(key), ParamText(int_to_string(rate)), ParamText(now)]) do
          Err(e)  -> Err("rate_limit_acquire: " ++ e)
          Ok(res) ->
            match res.rows do
              Nil -> Ok(false)
              _   -> Ok(true)
            end
        end)
    end

    fn unique_check(self : Store, unique_key : String) : Result(Bool, String) do
      pwith_conn(self, fn conn ->
        match Db.exec(conn, "SELECT 1 FROM conduit_jobs WHERE unique_key = $1 AND status NOT IN ('completed','dead') LIMIT 1", [ParamText(unique_key)]) do
          Err(e)  -> Err("unique_check: " ++ e)
          Ok(res) ->
            match res.rows do
              Nil -> Ok(false)
              _   -> Ok(true)
            end
        end)
    end

    fn unique_release(self : Store, job_id : String) : Result((), String) do
      pexec(self, "UPDATE conduit_jobs SET unique_key = NULL WHERE id = $1", [ParamText(job_id)])
    end

    -- ── Event store ──────────────────────────────────────────────

    fn event_append(self : Store, workflow_id : String, sequence : Int, event_type : String, payload : String) : Result(Int, String) do
      let sql = "INSERT INTO conduit_workflow_events (workflow_id, sequence, event_type, payload, recorded_at) VALUES ($1, $2, $3, $4, $5) RETURNING id"
      pwith_conn(self, fn conn ->
        match Db.exec(conn, sql, [ParamText(workflow_id), ptxt_int(sequence), ParamText(event_type), ParamText(payload), ParamText(int_to_string(DateTime.now()))]) do
          Err(e)  -> Err("event_append: " ++ e)
          Ok(res) ->
            match res.rows do
              Cons(row, _) -> Ok(preq_int(pcell(row, 0)))
              Nil          -> Err("event_append: no id returned")
            end
        end)
    end

    fn event_load_all(self : Store, workflow_id : String) : Result(List(Conduit.WorkflowEvent), String) do
      pwith_conn(self, fn conn ->
        match Db.exec(conn, "SELECT " ++ pev_cols() ++ " FROM conduit_workflow_events WHERE workflow_id = $1 ORDER BY sequence ASC", [ParamText(workflow_id)]) do
          Err(e)  -> Err("event_load_all: " ++ e)
          Ok(res) -> Ok(List.map(res.rows, fn row -> pdecode_event(row)))
        end)
    end

    fn event_load_up_to(self : Store, workflow_id : String, max_seq : Int) : Result(List(Conduit.WorkflowEvent), String) do
      pwith_conn(self, fn conn ->
        match Db.exec(conn, "SELECT " ++ pev_cols() ++ " FROM conduit_workflow_events WHERE workflow_id = $1 AND sequence <= $2 ORDER BY sequence ASC", [ParamText(workflow_id), ptxt_int(max_seq)]) do
          Err(e)  -> Err("event_load_up_to: " ++ e)
          Ok(res) -> Ok(List.map(res.rows, fn row -> pdecode_event(row)))
        end)
    end

    fn event_count(self : Store, workflow_id : String) : Result(Int, String) do
      pwith_conn(self, fn conn ->
        match Db.exec(conn, "SELECT COUNT(*)::bigint FROM conduit_workflow_events WHERE workflow_id = $1", [ParamText(workflow_id)]) do
          Err(e)  -> Err("event_count: " ++ e)
          Ok(res) ->
            match res.rows do
              Cons(row, _) -> Ok(preq_int(pcell(row, 0)))
              Nil          -> Ok(0)
            end
        end)
    end

    -- ── Pruning / retention ────────────────────────────────────────────────

    -- Delete up to batch_size completed jobs older than cutoff_s (epoch seconds).
    fn prune_jobs(self : Store, cutoff_s : Int, batch_size : Int) : Result(Int, String) do
      let sql = "WITH del AS (DELETE FROM conduit_jobs WHERE id IN (SELECT id FROM conduit_jobs WHERE status = 'completed' AND completed_at < $1 LIMIT $2) RETURNING id) SELECT COUNT(*) FROM del"
      pwith_conn(self, fn conn ->
        match Db.exec(conn, sql, [ParamText(int_to_string(cutoff_s)), ParamText(int_to_string(batch_size))]) do
          Err(e)  -> Err("prune_jobs: " ++ e)
          Ok(res) ->
            match res.rows do
              Cons(row, _) -> Ok(preq_int(pcell(row, 0)))
              Nil          -> Ok(0)
            end
        end)
    end

    -- Delete up to batch_size dead-letter rows older than cutoff_s.
    -- Also hard-deletes the associated conduit_jobs row (which has status 'dead')
    -- to keep the jobs table tidy.
    fn prune_dead_letters(self : Store, cutoff_s : Int, batch_size : Int) : Result(Int, String) do
      let sql = "WITH to_prune AS (SELECT id, job_id FROM conduit_dead_letters WHERE discarded_at < $1 LIMIT $2), del_jobs AS (DELETE FROM conduit_jobs WHERE id IN (SELECT job_id FROM to_prune)), del_dl AS (DELETE FROM conduit_dead_letters WHERE id IN (SELECT id FROM to_prune) RETURNING id) SELECT COUNT(*) FROM del_dl"
      pwith_conn(self, fn conn ->
        match Db.exec(conn, sql, [ParamText(int_to_string(cutoff_s)), ParamText(int_to_string(batch_size))]) do
          Err(e)  -> Err("prune_dead_letters: " ++ e)
          Ok(res) ->
            match res.rows do
              Cons(row, _) -> Ok(preq_int(pcell(row, 0)))
              Nil          -> Ok(0)
            end
        end)
    end

    -- Delete up to batch_size terminal workflows older than cutoff_s, cascading
    -- to their checkpoints, signals, and events (no FK ON DELETE CASCADE in the
    -- schema, so child rows are deleted explicitly inside a CTE).
    -- The NOT EXISTS guard prevents FK violations: only prune a workflow if none
    -- of its children are still active (parent_id self-reference on conduit_workflows).
    fn prune_workflows(self : Store, cutoff_s : Int, batch_size : Int) : Result(Int, String) do
      let sql = "WITH to_prune AS (SELECT w.id FROM conduit_workflows w WHERE w.status IN ('completed','failed','cancelled','timed_out') AND w.completed_at < $1 AND NOT EXISTS (SELECT 1 FROM conduit_workflows c WHERE c.parent_id = w.id AND NOT (c.status IN ('completed','failed','cancelled','timed_out') AND c.completed_at < $1)) LIMIT $2), del_events AS (DELETE FROM conduit_workflow_events WHERE workflow_id IN (SELECT id FROM to_prune)), del_checkpoints AS (DELETE FROM conduit_checkpoints WHERE workflow_id IN (SELECT id FROM to_prune)), del_signals AS (DELETE FROM conduit_workflow_signals WHERE workflow_id IN (SELECT id FROM to_prune)), del_wf AS (DELETE FROM conduit_workflows WHERE id IN (SELECT id FROM to_prune) RETURNING id) SELECT COUNT(*) FROM del_wf"
      pwith_conn(self, fn conn ->
        match Db.exec(conn, sql, [ParamText(int_to_string(cutoff_s)), ParamText(int_to_string(batch_size))]) do
          Err(e)  -> Err("prune_workflows: " ++ e)
          Ok(res) ->
            match res.rows do
              Cons(row, _) -> Ok(preq_int(pcell(row, 0)))
              Nil          -> Ok(0)
            end
        end)
    end
  end
end
