          Err(e)  -> Err("dashboard_job_by_id: " ++ e)
          Ok(res) ->
            match res.rows do
              Nil          -> Ok(None)
              Cons(row, _) -> Ok(Some(pdecode_job(row)))
            end
        end)
    end

    fn dashboard_crons_list(self : Store) : Result(List(Conduit.CronSchedule), String) do
      pwith_conn(self, fn conn ->
        match Db.exec(conn, "SELECT " ++ pcron_cols() ++ " FROM conduit_cron_schedules ORDER BY id ASC", Nil) do
