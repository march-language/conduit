    fn workflow_status_get(self : Store, id : String) : Result(Option(String), String) do
      pwith_conn(self, fn conn ->
        match Db.exec(conn, "SELECT status FROM conduit_workflows WHERE id = $1", [ParamText(id)]) do
          Err(e)  -> Err("workflow_status_get: " ++ e)
          Ok(res) ->
            match res.rows do
              Nil          -> Ok(None)
              Cons(row, _) -> Ok(Some(preq_str(pcell(row, 0))))
            end
        end)
    end

    -- output/error are COALESCEd: passing None keeps the existing value.
    -- completed_at is set whenever the status leaves 'running'; error_at when
    -- an error is provided.
    fn workflow_update_status(self : Store, id : String, status : String, output, error) : Result((), String) do
      let now = ParamText(int_to_string(DateTime.now()))
      pexec(self, "UPDATE conduit_workflows SET status = $2, output = COALESCE($3, output), error = COALESCE($4, error), completed_at = CASE WHEN $2 <> 'running' THEN $5 ELSE completed_at END, error_at = CASE WHEN $4 IS NOT NULL THEN $5 ELSE error_at END WHERE id = $1",
        [ParamText(id), ParamText(status), popt_txt(output), popt_txt(error), now])
    end

    fn workflow_cancel(self : Store, id : String, reason : String) : Result((), String) do
      let now = ParamText(int_to_string(DateTime.now()))
      pexec(self, "UPDATE conduit_workflows SET status = 'cancelled', error = $2, error_at = $3, completed_at = $3 WHERE id = $1 AND status = 'running'",
        [ParamText(id), ParamText(reason), now])
    end

    -- ── Checkpoints ──────────────────────────────────────────────

    fn checkpoint_get(self : Store, workflow_id : String, name : String) : Result(Option(String), String) do
      pwith_conn(self, fn conn ->
        match Db.exec(conn, "SELECT value FROM conduit_checkpoints WHERE workflow_id = $1 AND name = $2", [ParamText(workflow_id), ParamText(name)]) do
          Err(e)  -> Err("checkpoint_get: " ++ e)
          Ok(res) ->
            match res.rows do
              Nil          -> Ok(None)
              Cons(row, _) -> Ok(Some(preq_str(pcell(row, 0))))
            end
        end)
    end

    -- First-write-wins (ON CONFLICT DO NOTHING): a checkpoint is immutable once
    -- recorded, which keeps replay deterministic under concurrent resumes.
    fn checkpoint_set(self : Store, workflow_id : String, name : String, value : String, dur_ms : Int) : Result((), String) do
      pexec(self, "INSERT INTO conduit_checkpoints (workflow_id, name, value, created_at, duration_ms) VALUES ($1, $2, $3, $4, $5) ON CONFLICT (workflow_id, name) DO NOTHING",
        [ParamText(workflow_id), ParamText(name), ParamText(value), ParamText(int_to_string(DateTime.now())), ptxt_int(dur_ms)])
    end

    fn checkpoint_load_all(self : Store, workflow_id : String) : Result(List(Conduit.WorkflowCheckpoint), String) do
      pwith_conn(self, fn conn ->
        match Db.exec(conn, "SELECT " ++ pcp_cols() ++ " FROM conduit_checkpoints WHERE workflow_id = $1 ORDER BY id ASC", [ParamText(workflow_id)]) do
          Err(e)  -> Err("checkpoint_load_all: " ++ e)
          Ok(res) -> Ok(List.map(res.rows, fn row -> pdecode_checkpoint(row)))
        end)
    end

    -- ── Signals ──────────────────────────────────────────────────

    fn signal_insert(self : Store, signal_row) : Result(Int, String) do
      let sql = "INSERT INTO conduit_workflow_signals (workflow_id, signal_type, payload, status, sent_at, delivered_at, expires_at, sent_by) VALUES ($1,$2,$3,$4,$5,$6,$7,$8) RETURNING id"
      let params = [
        ParamText(signal_row.workflow_id),
        ParamText(signal_row.signal_type),
        ParamText(signal_row.payload),
        ParamText(signal_row.status),
        ptxt_ts(signal_row.sent_at),
        popt_ts(signal_row.delivered_at),
        popt_ts(signal_row.expires_at),
        popt_txt(signal_row.sent_by)
      ]
      pwith_conn(self, fn conn ->
        match Db.exec(conn, sql, params) do
          Err(e)  -> Err("signal_insert: " ++ e)
          Ok(res) ->
            match res.rows do
              Cons(row, _) -> Ok(preq_int(pcell(row, 0)))
              Nil          -> Err("signal_insert: no id returned")
            end
        end)
    end

    fn signal_peek(self : Store, workflow_id : String, signal_type : String) : Result(Option(Conduit.WorkflowSignal), String) do
      pwith_conn(self, fn conn ->
        match Db.exec(conn, "SELECT " ++ psig_cols() ++ " FROM conduit_workflow_signals WHERE workflow_id = $1 AND signal_type = $2 AND status = 'pending' ORDER BY sent_at ASC LIMIT 1", [ParamText(workflow_id), ParamText(signal_type)]) do
          Err(e)  -> Err("signal_peek: " ++ e)
          Ok(res) ->
            match res.rows do
              Nil          -> Ok(None)
              Cons(row, _) -> Ok(Some(pdecode_signal(row)))
            end
        end)
    end

    fn signal_mark_delivered(self : Store, id : Int) : Result((), String) do
      pexec(self, "UPDATE conduit_workflow_signals SET status = 'delivered', delivered_at = $2 WHERE id = $1",
        [ptxt_int(id), ParamText(int_to_string(DateTime.now()))])
    end

    -- ── Dashboard queries ────────────────────────────────────────

    fn dashboard_queue_summary(self : Store) : Result(List(Conduit.Dashboard.QueueSummary), String) do
      let day_ago = DateTime.now() - 86400
      let sql = "SELECT queue, COUNT(*) FILTER (WHERE status = 'pending')::bigint, COUNT(*) FILTER (WHERE status = 'running')::bigint, COUNT(*) FILTER (WHERE status IN ('pending','snoozed') AND attempt > 0)::bigint, COUNT(*) FILTER (WHERE status = 'dead')::bigint, COUNT(*) FILTER (WHERE status = 'completed' AND completed_at >= $1)::bigint, (COALESCE(AVG(completed_at - started_at) FILTER (WHERE status = 'completed'), 0) * 1000)::bigint FROM conduit_jobs GROUP BY queue ORDER BY queue"
      pwith_conn(self, fn conn ->
        match Db.exec(conn, sql, [ParamText(int_to_string(day_ago))]) do
          Err(e)  -> Err("dashboard_queue_summary: " ++ e)
          Ok(res) -> Ok(List.map(res.rows, fn row -> pdecode_queue_summary(row)))
        end)
    end

    -- queue / status filters: empty string means "any".
    fn dashboard_jobs_list(self : Store, queue : String, status : String, page : Int) : Result(List(Conduit.JobRow), String) do
      let sql = "SELECT " ++ pjob_cols() ++ " FROM conduit_jobs WHERE ($1 = '' OR queue = $1) AND ($2 = '' OR status = $2) ORDER BY inserted_at DESC LIMIT $3 OFFSET $4"
      pwith_conn(self, fn conn ->
        match Db.exec(conn, sql, [ParamText(queue), ParamText(status), ptxt_int(ppage_size()), ptxt_int(page * ppage_size())]) do
          Err(e)  -> Err("dashboard_jobs_list: " ++ e)
          Ok(res) -> Ok(List.map(res.rows, fn row -> pdecode_job(row)))
        end)
    end

