    fn job_delete(_self, _a) do pnot_impl("job_delete") end
    fn dead_letter_delete(_self, _a) do pnot_impl("dead_letter_delete") end
    fn notify_subscribe(_self, _a) do pnot_impl("notify_subscribe") end

    -- ── Rate limiting & unique jobs (not yet implemented) ────────
    fn rate_limit_acquire(_self, _a, _b) do pnot_impl("rate_limit_acquire") end
    fn unique_check(_self, _a) do pnot_impl("unique_check") end
    fn unique_release(_self, _a) do pnot_impl("unique_release") end

    -- ── Event store (not yet implemented) ────────────────────────
    fn event_append(_self, _a, _b, _c, _d) do pnot_impl("event_append") end
    fn event_load_all(_self, _a) do pnot_impl("event_load_all") end
    fn event_load_up_to(_self, _a, _b) do pnot_impl("event_load_up_to") end
    fn event_count(_self, _a) do pnot_impl("event_count") end
  end
end
