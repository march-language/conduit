-- Conduit.Storage.Postgres — Postgres-backed implementation of Conduit.Storage.
--
-- Uses the depot Pool actor for connection management and executes all
-- operations as parameterized SQL queries via the March runtime's
-- `exec_prepared` and `simple_query` builtins.
--
-- Schema conventions used by this implementation:
--   • Timestamps are stored as BIGINT epoch-milliseconds.
--   • JSON lists (errors, tags, queues) are stored as JSONB.
--   • All other values are TEXT or INTEGER.
--
-- Usage:
--   match Conduit.Storage.Postgres.start({
--     host = "localhost", port = 5432,
--     user = "myapp", password = Some("secret"), database = "myapp_dev",
--     pool_min = 5, pool_max = 20
--   }) do
--     Ok(pg) -> Conduit.API.start(pg, conduit_config)
--     Err(e) -> Logger.error("postgres connection failed: " ++ e)
--   end

mod Conduit.Storage.Postgres do

  -- Connection configuration for the Postgres storage backend.
  type Config = {
    host     : String,
    port     : Int,
    user     : String,
    password : Option(String),
    database : String,
    pool_min : Int,
    pool_max : Int
  }

  -- The storage handle: wraps a depot connection pool Pid.
  type PG = { pool : Pid }

  doc "Start a Postgres storage backend with explicit connection parameters."
  fn start(cfg : Config) : Result(PG, String) do
    let conn_cfg = Connection.full_config(cfg.host, cfg.port, cfg.user, cfg.database, cfg.password)
    let pool_cfg = { Pool.default_pool_config(conn_cfg) with
                     min_size = cfg.pool_min,
                     max_size = cfg.pool_max }
    let pool = Pool.start(pool_cfg)
    Ok({ pool = pool })
  end

  doc "Convenience config targeting localhost:5432 with no password."
  fn default_config(user : String, database : String) : Config do
    { host = "localhost", port = 5432, user = user,
      password = None, database = database,
      pool_min = 5, pool_max = 20 }
  end

  -- ── Private helpers ──────────────────────────────────────────────────────

  -- Direct wrappers around Query module functions.  These exist so that
  -- pexec / pexec_simple can capture a LOCAL function value rather than
  -- the external Query.exec_prepared / Query.simple_query globals — the
  -- march compiler requires a global accessor to be defined in the same
  -- compilation unit when a function is stored in a closure.
  pfn pdo_exec_prepared(conn, sql, params) do
    Query.exec_prepared(conn, sql, params)
  end

  pfn pdo_simple_query(conn, sql) do
    Query.simple_query(conn, sql)
  end

  -- Execute a parameterized query, flattening the double-Result from with_conn.
  pfn pexec(pg, sql, params) do
    match Pool.with_conn(pg.pool, fn conn -> pdo_exec_prepared(conn, sql, params)) do
      Ok(Ok(result)) -> Ok(result)
      Ok(Err(e))     -> Err(e)
      Err(e)         -> Err(e)
    end
  end

  -- Execute a non-parameterized query (for LISTEN and advisory operations).
  pfn pexec_simple(pg, sql) do
    match Pool.with_conn(pg.pool, fn conn -> pdo_simple_query(conn, sql)) do
      Ok(Ok(result)) -> Ok(result)
      Ok(Err(e))     -> Err(e)
      Err(e)         -> Err(e)
    end
  end

  -- Execute a mutation; discard rows, return Ok(()).
  pfn pmutate(pg, sql, params) do
    match pexec(pg, sql, params) do
      Err(e) -> Err(e)
      Ok(_)  -> Ok(())
    end
  end

  -- Return the first row of a QueryResult, or None.
  pfn pfirst_row(result) do
    match result.rows do
      Nil          -> None
      Cons(row, _) -> Some(row)
    end
  end

  -- Apply f to every row and collect the results.
  pfn pmap_rows(rows, f) do
    List.map(rows, f)
  end

  -- Run a query, map all rows through f.
  pfn pall_rows(pg, sql, params, f) do
    match pexec(pg, sql, params) do
      Err(e)     -> Err(e)
      Ok(result) -> Ok(pmap_rows(result.rows, f))
    end
  end

  -- Run a query, return Some(f(row)) for the first row or None.
  pfn pone_row(pg, sql, params, f) do
    match pexec(pg, sql, params) do
      Err(e)     -> Err(e)
      Ok(result) ->
        match pfirst_row(result) do
          None      -> Ok(None)
          Some(row) -> Ok(Some(f(row)))
        end
    end
  end

  -- ── Column access ────────────────────────────────────────────────────────

  -- Get the nth element (0-based) from a list, returning Option.
  pfn pnth(lst, idx) do
    match lst do
      Nil          -> None
      Cons(h, t)   ->
        if idx == 0 do Some(h) else pnth(t, idx - 1) end
    end
  end

  -- Get a cell (Option(String)) from a row (List(Option(String))).
  pfn pget(row, idx) do
    match pnth(row, idx) do
      None       -> None      -- out of bounds
      Some(cell) -> cell      -- may be None (NULL) or Some(str)
    end
  end

  -- Get a string value from a row; default "" on NULL or missing.
  pfn pstr(row, idx) do
    match pget(row, idx) do
      None    -> ""
      Some(s) -> s
    end
  end

  -- Get an integer value from a row; default 0 on NULL or parse failure.
  pfn pint(row, idx) do
    unwrap_or(string_to_int(pstr(row, idx)), 0)
  end

  -- Get a boolean value. Postgres returns "t"/"f" for BOOLEAN columns.
  pfn pbool(row, idx) do
    let s = pstr(row, idx)
    s == "t" || s == "true" || s == "1"
  end

  -- Get an Option(String) from a row.
  pfn popt(row, idx) do
    pget(row, idx)
  end

  -- Get an Option(Int) from a row.
  pfn popt_int(row, idx) do
    match pget(row, idx) do
      None    -> None
      Some(s) -> string_to_int(s)
    end
  end

  -- ── Timestamp helpers ────────────────────────────────────────────────────

  -- Current time as epoch milliseconds.
  pfn pnow() do DateTime.now() end

  -- Parse a BIGINT epoch-ms column into a DateTime.
  pfn pparse_ts(row, idx) do
    DateTime.from_timestamp(pint(row, idx))
  end

  -- Parse an optional BIGINT epoch-ms column into Option(DateTime).
  pfn pparse_opt_ts(row, idx) do
    match pget(row, idx) do
      None    -> None
      Some(s) ->
        match string_to_int(s) do
          None     -> None
          Some(ms) -> Some(DateTime.from_timestamp(ms))
        end
    end
  end

  -- Convert a DateTime to a ParamText epoch-ms string.
  pfn pts(dt) do
    ParamText(int_to_string(DateTime.to_timestamp(dt)))
  end

  -- Convert an Option(DateTime) to a Param (ParamNull on None).
  pfn popt_ts(opt) do
    match opt do
      None     -> ParamNull
      Some(dt) -> pts(dt)
    end
  end

  -- ── JSON list helpers ────────────────────────────────────────────────────

  -- JSON-escape a string for embedding in a JSON array literal.
  pfn pjesc(s) do
    s |> String.replace("\\", "\\\\")
      |> String.replace("\"", "\\\"")
      |> String.replace("\n", "\\n")
      |> String.replace("\r", "\\r")
  end

  pfn pjoin_quoted(lst) do
    match lst do
      Nil           -> ""
      Cons(h, Nil)  -> "\"" ++ pjesc(h) ++ "\""
      Cons(h, t)    -> "\"" ++ pjesc(h) ++ "\"," ++ pjoin_quoted(t)
    end
  end

  -- Encode a List(String) as a JSON array literal (for JSONB columns).
  pfn pencode_list(lst) do
    "[" ++ pjoin_quoted(lst) ++ "]"
  end

  -- Decode a JSONB column value (returned as a JSON string) into List(String).
  pfn pdecode_list(s) do
    match Json.parse(s) do
      Err(_)   -> Nil
      Ok(json) ->
        match json do
          Json.Array(items) ->
            List.filter_map(items, fn item ->
              match item do
                Json.String(v) -> Some(v)
                _              -> None
              end
            )
          _ -> Nil
        end
    end
  end

  -- ── Fixed-order column list strings ─────────────────────────────────────
  -- Each query SELECTs columns in this exact order so converters can use
  -- positional indices without needing to look up column names.

  pfn pjob_cols() do
    "id, queue, job_type, payload, status, attempt, max_attempts, priority, " ++
    "backoff, dead_letter_queue, inserted_at, scheduled_at, run_at, " ++
    "started_at, completed_at, heartbeat_at, worker_id, unique_key, errors, tags"
  end
  -- Indices: 0=id 1=queue 2=job_type 3=payload 4=status 5=attempt
  --          6=max_attempts 7=priority 8=backoff 9=dead_letter_queue
  --          10=inserted_at 11=scheduled_at 12=run_at 13=started_at
  --          14=completed_at 15=heartbeat_at 16=worker_id 17=unique_key
  --          18=errors 19=tags

  pfn pdl_cols() do
    "id, job_id, queue, job_type, payload, errors, attempts, " ++
    "first_attempted_at, last_attempted_at, discarded_at, " ++
    "reviewed, reviewed_by, reviewed_at, retry_count"
  end
  -- Indices: 0=id 1=job_id 2=queue 3=job_type 4=payload 5=errors
  --          6=attempts 7=first_attempted_at 8=last_attempted_at
  --          9=discarded_at 10=reviewed 11=reviewed_by 12=reviewed_at
  --          13=retry_count

  pfn pcron_cols() do
    "id, job_type, schedule, timezone, queue, payload, overlap, enabled, " ++
    "last_run_at, last_job_id, next_run_at, tags"
  end
  -- Indices: 0=id 1=job_type 2=schedule 3=timezone 4=queue 5=payload
  --          6=overlap 7=enabled 8=last_run_at 9=last_job_id
  --          10=next_run_at 11=tags

  pfn pnode_cols() do
    "id, hostname, pid, queues, pool_size, started_at, last_seen_at, status"
  end
  -- Indices: 0=id 1=hostname 2=pid 3=queues 4=pool_size
  --          5=started_at 6=last_seen_at 7=status

  pfn pwf_cols() do
    "id, workflow_type, parent_id, input, output, status, " ++
    "started_at, completed_at, timeout_at, error, error_at, tags, meta"
  end
  -- Indices: 0=id 1=workflow_type 2=parent_id 3=input 4=output 5=status
  --          6=started_at 7=completed_at 8=timeout_at 9=error 10=error_at
  --          11=tags 12=meta

  pfn pchk_cols() do
    "id, workflow_id, name, value, created_at, duration_ms"
  end
  -- Indices: 0=id 1=workflow_id 2=name 3=value 4=created_at 5=duration_ms

  pfn psig_cols() do
    "id, workflow_id, signal_type, payload, status, " ++
    "sent_at, delivered_at, expires_at, sent_by"
  end
  -- Indices: 0=id 1=workflow_id 2=signal_type 3=payload 4=status
  --          5=sent_at 6=delivered_at 7=expires_at 8=sent_by

  pfn pevt_cols() do
    "id, workflow_id, sequence, event_type, payload, recorded_at"
  end
  -- Indices: 0=id 1=workflow_id 2=sequence 3=event_type 4=payload 5=recorded_at

  -- ── Row-to-type converters ───────────────────────────────────────────────

  pfn prow_to_job(row) do
    {
      id                = pstr(row, 0),
      queue             = pstr(row, 1),
      job_type          = pstr(row, 2),
      payload           = pstr(row, 3),
      status            = pstr(row, 4),
      attempt           = pint(row, 5),
      max_attempts      = pint(row, 6),
      priority          = pint(row, 7),
      backoff           = pstr(row, 8),
      dead_letter_queue = popt(row, 9),
      inserted_at       = pparse_ts(row, 10),
      scheduled_at      = pparse_ts(row, 11),
      run_at            = pparse_ts(row, 12),
      started_at        = pparse_opt_ts(row, 13),
      completed_at      = pparse_opt_ts(row, 14),
      heartbeat_at      = pparse_opt_ts(row, 15),
      worker_id         = popt(row, 16),
      unique_key        = popt(row, 17),
      errors            = pdecode_list(pstr(row, 18)),
      tags              = pdecode_list(pstr(row, 19))
    }
  end

  pfn prow_to_dl(row) do
    {
      id                 = pstr(row, 0),
      job_id             = pstr(row, 1),
      queue              = pstr(row, 2),
      job_type           = pstr(row, 3),
      payload            = pstr(row, 4),
      errors             = pdecode_list(pstr(row, 5)),
      attempts           = pint(row, 6),
      first_attempted_at = pparse_opt_ts(row, 7),
      last_attempted_at  = pparse_opt_ts(row, 8),
      discarded_at       = pparse_ts(row, 9),
      reviewed           = pbool(row, 10),
      reviewed_by        = popt(row, 11),
      reviewed_at        = pparse_opt_ts(row, 12),
      retry_count        = pint(row, 13)
    }
  end

  pfn prow_to_cron(row) do
    {
      id          = pstr(row, 0),
      job_type    = pstr(row, 1),
      schedule    = pstr(row, 2),
      timezone    = pstr(row, 3),
      queue       = pstr(row, 4),
      payload     = pstr(row, 5),
      overlap     = pstr(row, 6),
      enabled     = pbool(row, 7),
      last_run_at = pparse_opt_ts(row, 8),
      last_job_id = popt(row, 9),
      next_run_at = pparse_opt_ts(row, 10),
      tags        = pdecode_list(pstr(row, 11))
    }
  end

  pfn prow_to_node(row) do
    {
      id           = pstr(row, 0),
      hostname     = pstr(row, 1),
      pid          = pint(row, 2),
      queues       = pdecode_list(pstr(row, 3)),
      pool_size    = pint(row, 4),
      started_at   = pparse_ts(row, 5),
      last_seen_at = pparse_ts(row, 6),
      status       = pstr(row, 7)
    }
  end

  pfn prow_to_wf(row) do
    {
      id            = pstr(row, 0),
      workflow_type = pstr(row, 1),
      parent_id     = popt(row, 2),
      input         = pstr(row, 3),
      output        = popt(row, 4),
      status        = pstr(row, 5),
      started_at    = pparse_ts(row, 6),
      completed_at  = pparse_opt_ts(row, 7),
      timeout_at    = pparse_opt_ts(row, 8),
      error         = popt(row, 9),
      error_at      = pparse_opt_ts(row, 10),
      tags          = pdecode_list(pstr(row, 11)),
      meta          = pstr(row, 12)
    }
  end

  pfn prow_to_chk(row) do
    {
      id          = pint(row, 0),
      workflow_id = pstr(row, 1),
      name        = pstr(row, 2),
      value       = pstr(row, 3),
      created_at  = pparse_ts(row, 4),
      duration_ms = popt_int(row, 5)
    }
  end

  pfn prow_to_sig(row) do
    {
      id           = pint(row, 0),
      workflow_id  = pstr(row, 1),
      signal_type  = pstr(row, 2),
      payload      = pstr(row, 3),
      status       = pstr(row, 4),
      sent_at      = pparse_ts(row, 5),
      delivered_at = pparse_opt_ts(row, 6),
      expires_at   = pparse_opt_ts(row, 7),
      sent_by      = popt(row, 8)
    }
  end

  pfn prow_to_evt(row) do
    {
      id          = pint(row, 0),
      workflow_id = pstr(row, 1),
      sequence    = pint(row, 2),
      event_type  = pstr(row, 3),
      payload     = pstr(row, 4),
      recorded_at = pparse_ts(row, 5)
    }
  end

  pfn prow_to_summary(row) do
    {
      queue       = pstr(row, 0),
      pending     = pint(row, 1),
      running     = pint(row, 2),
      failed      = pint(row, 3),
      dead        = pint(row, 4),
      throughput  = pint(row, 5),
      avg_latency = pint(row, 6)
    }
  end

  -- ── Dashboard filter builders ────────────────────────────────────────────

  -- Build (WHERE clause, params) for dashboard_jobs_list.
  -- Param indices start at 1; LIMIT and OFFSET come last.
  pfn pjobs_filter(queue, status, limit_n, offset_n) do
    let lim = int_to_string(limit_n)
    let off = int_to_string(offset_n)
    match (queue != "", status != "") do
      (false, false) ->
        ("LIMIT $1 OFFSET $2",
         [ParamText(lim), ParamText(off)])
      (true, false) ->
        ("WHERE queue = $1 LIMIT $2 OFFSET $3",
         [ParamText(queue), ParamText(lim), ParamText(off)])
      (false, true) ->
        ("WHERE status = $1 LIMIT $2 OFFSET $3",
         [ParamText(status), ParamText(lim), ParamText(off)])
      (true, true) ->
        ("WHERE queue = $1 AND status = $2 LIMIT $3 OFFSET $4",
         [ParamText(queue), ParamText(status), ParamText(lim), ParamText(off)])
    end
  end

  -- Build (WHERE clause, params) for dashboard_workflows_list.
  pfn pwf_filter(status_filter, limit_n, offset_n) do
    let lim = int_to_string(limit_n)
    let off = int_to_string(offset_n)
    if status_filter == "" do
      ("LIMIT $1 OFFSET $2", [ParamText(lim), ParamText(off)])
    else
      ("WHERE status = $1 LIMIT $2 OFFSET $3",
       [ParamText(status_filter), ParamText(lim), ParamText(off)])
    end
  end

  -- ── Load-then-update helper for errors list ──────────────────────────────

  -- Load the current errors list for a job, append msg, write back.
  pfn pappend_error(pg, job_id, msg) do
    match pexec(pg, "SELECT errors FROM conduit_jobs WHERE id = $1",
                [ParamText(job_id)]) do
      Err(e) -> Err(e)
      Ok(result) ->
        let existing = match pfirst_row(result) do
          None      -> Nil
          Some(row) -> pdecode_list(pstr(row, 0))
        end
        let new_errors = List.append(existing, Cons(msg, Nil))
        pmutate(pg,
          "UPDATE conduit_jobs SET errors = $2::jsonb WHERE id = $1",
          [ParamText(job_id), ParamText(pencode_list(new_errors))])
    end
  end


  -- impl Conduit.Storage(PG) removed (Phase 5 not yet complete).
  -- A second impl alongside FakeWorkflowStorage in tests prevents the
  -- mono pass $single_impl sentinel from resolving polymorphic Storage
  -- call sites. Re-add when Phase 5 ships.

end -- mod Conduit.Storage.Postgres
