mod Conduit.Time do
  doc """
  Cooperative yield-based sleep.

  Yields to the March task scheduler approximately `ms` milliseconds worth of
  scheduler ticks.  This is NOT a wall-clock sleep — on an idle system with no
  peer tasks, yields complete immediately.  Use for poll delays and heartbeat
  intervals, not for precision timing.
  """
  fn sleep_ms(ms : Int) : () do
    psleep_loop(int_div(ms, 10))
  end

  pfn psleep_loop(n : Int) : () do
    if n <= 0 do
      ()
    else
      task_yield()
      psleep_loop(n - 1)
    end
  end
end
