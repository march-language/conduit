-- Conduit.Worker — task-based worker pool with heartbeat and stale-rescue.
--
-- Each worker runs as an independent March task in an infinite loop:
--
--   1. fetch_next  — claim one job from the queue (SELECT … FOR UPDATE SKIP LOCKED).
--   2. mark_running — atomically record the worker_id and increment attempt.
--   3. heartbeat task — spawned in parallel; updates heartbeat_at periodically so
--      the stale-rescue loop can detect crashed workers.
--   4. rate-limit check — if configured, try to acquire a token; snooze on failure.
--   5. dispatch — call the registered performer function.
--   6. handle_result — transition the job to completed | retry | discard | dlq | snooze.
--
-- The heartbeat task is stopped via a Vault flag (not task_await_unwrap, which
-- would block forever on the infinite heartbeat loop).
--
-- `start_workers/4` also spawns one stale-rescue loop per queue group that
-- reclaims jobs abandoned by workers that died mid-execution.
mod Conduit.Worker do

  doc """
  Start `count` worker tasks for the given queue, plus one stale-rescue task.

  Each worker runs an infinite poll loop:  fetch → mark_running → heartbeat →
  dispatch → handle_result → repeat.  The stale-rescue task fires every
  `poll_interval_ms * 10` ms, finding jobs whose heartbeat has expired and
  resetting them to pending for re-execution.

  Returns all task handles.  In production, wrap these in a supervisor for
  auto-restart on unexpected panics.
  """
  fn start_workers(storage, queue : String, count : Int, poll_interval_ms : Int) : List(Task) do
    Logger.debug("conduit: start_workers queue=" ++ queue ++ " count=" ++ int_to_string(count))
    let workers = List.range(0, count - 1)
      |> List.map(fn _ ->
        task_spawn(fn _ -> worker_loop(storage, queue, poll_interval_ms)))
    let rescuer = task_spawn(fn _ ->
      rescue_loop(storage, poll_interval_ms * 10))
    List.append(workers, Cons(rescuer, Nil))
  end

  -- The inner poll loop for a single worker task.
  --
  -- On storage error: log and sleep one poll interval before retrying — avoids
  -- hammering a degraded DB with tight loops.
  --
  -- On empty queue: sleep one poll interval, then loop.
  --
  -- On job available: call execute/2, then immediately loop (no extra sleep)
  -- so the next job is picked up as fast as possible.
  pfn worker_loop(storage, queue : String, poll_interval_ms : Int) : () do
    match Conduit.Storage.fetch_next(storage, queue) do
      Err(e) ->
        Logger.error("conduit: fetch_next error on queue " ++ queue ++ ": " ++ e)
        psleep_ms(poll_interval_ms)
        worker_loop(storage, queue, poll_interval_ms)
      Ok(None) ->
        psleep_ms(poll_interval_ms)
        worker_loop(storage, queue, poll_interval_ms)
      Ok(Some(job)) ->
        execute(storage, job)
        worker_loop(storage, queue, poll_interval_ms)
    end
  end

  -- Execute a single job.
  --
  -- Steps:
  --   1. Atomically claim the job via mark_running (skips if already claimed).
  --   2. Look up the registered JobConfig (backoff, timeout, DLQ, callbacks).
  --   3. Spawn a heartbeat task using a Vault stop-flag for clean termination.
  --   4. Perform optional rate-limit check; snooze on rejection.
  --   5. Dispatch the registered performer.
  --   6. Signal the heartbeat to stop, then route the result.
  pfn execute(storage, job : Conduit.JobRow) : () do
    Logger.debug("conduit: execute job.id=" ++ job.id ++ " job_type=" ++ job.job_type)
    let worker_id = uuid_v4()
    Logger.debug("conduit: execute: calling mark_running job.id=" ++ job.id)
    match Conduit.Storage.mark_running(storage, job.id, worker_id) do
      Err(e) ->
        Logger.warn("conduit: could not claim job " ++ job.id ++ ": " ++ e)
      Ok(_) ->
        Logger.debug("conduit: execute: mark_running ok, attempt=" ++ int_to_string(job.attempt))
        -- next_attempt is the attempt number that is now executing (post-increment).
        let next_attempt = job.attempt + 1
        let config = Conduit.Queue.lookup_config(job.job_type)
          |> Option.unwrap_or(Conduit.JobConfig.default())
        Logger.debug("conduit: execute: got config, timeout=" ++ int_to_string(config.timeout))

        -- Heartbeat interval: one third of the job timeout, minimum 5s.
        let heartbeat_interval_ms = int_div(config.timeout, 3)
          |> pmax_int(5000)
        Logger.debug("conduit: execute: heartbeat_interval=" ++ int_to_string(heartbeat_interval_ms))

        -- Create a per-job stop flag so we can terminate the heartbeat task
        -- without calling task_await_unwrap (which would block forever on an
        -- infinite loop).
        let hb_flags = Vault.new("conduit_hb_flags")
        Vault.set(hb_flags, job.id, false)

        let hb_task = task_spawn(fn _ ->
          heartbeat_loop(storage, job.id, heartbeat_interval_ms, hb_flags))
        Logger.debug("conduit: execute: heartbeat task spawned")

        -- Notify handlers that execution is beginning.
        Conduit.Telemetry.dispatch(
          Conduit.Telemetry.JobStarted(job.id, job.job_type, worker_id, next_attempt))

        -- Capture wall-clock start so handle_result can compute duration_ms.
        let started_at_ms = DateTime.now()

        -- Rate limit check: if configured, try to acquire a token.
        let rate_ok = match config.rate_limit do
          None -> Ok(true)
          Some(rl) -> Conduit.RateLimiter.acquire(storage, job.job_type, rl, job.payload)
        end
        Logger.debug("conduit: execute: rate check done")

        match rate_ok do
          Err(e) ->
            -- Storage error during rate limit check — proceed anyway to avoid blocking.
            Logger.warn("conduit: rate limit check failed for " ++ job.id ++ ": " ++ e)
            let result = Conduit.Queue.dispatch(job.job_type, job.payload)
            Vault.set(hb_flags, job.id, true)
            handle_result(storage, job, next_attempt, config, result, started_at_ms)
          Ok(b) ->
            if b do
              -- Rate check passed: dispatch the job.
              Logger.debug("conduit: execute: dispatching job_type=" ++ job.job_type)
              let result = Conduit.Queue.dispatch(job.job_type, job.payload)
              Logger.debug("conduit: execute: dispatch complete")
              -- Signal the heartbeat to stop on its next tick.
              Vault.set(hb_flags, job.id, true)
              handle_result(storage, job, next_attempt, config, result, started_at_ms)
            else
              -- Rate-limited: snooze the job.
              let snooze_dur = match config.rate_limit do
                None     -> 1000
                Some(rl) -> Conduit.RateLimiter.snooze_duration(rl.max_per_second)
              end
              Vault.set(hb_flags, job.id, true)
              handle_result(storage, job, next_attempt, config, Err(Conduit.ConduitError.Snooze(snooze_dur)), started_at_ms)
            end
        end
    end
  end

  doc """
  Route the performer result to the correct next state and emit telemetry.

  Result dispatch table:
    Ok(())                        → mark_completed + emit JobCompleted + release unique key
    Err(ConduitError.Retry(msg))  → phandle_retry (emit JobFailed; reschedule or dead-letter)
    Err(ConduitError.WorkerError) → logged as error, then treated as Retry
    Err(ConduitError.Discard(msg))→ phandle_discard (emit JobDiscarded; DLQ if configured)
    Err(ConduitError.Snooze(ms))  → mark_snoozed + emit JobSnoozed

  `started_at_ms` is the epoch-ms captured just before the performer was
  dispatched; it is used to compute `duration_ms` for the JobCompleted event.
  """
  pfn handle_result(storage, job : Conduit.JobRow, attempt : Int, config : Conduit.JobConfig, result : Result((), Conduit.ConduitError), started_at_ms : Int) : () do
    match result do
      Ok(_) ->
        match Conduit.Storage.mark_completed(storage, job.id) do
          Ok(_)  ->
            let duration_ms = DateTime.now() - started_at_ms
            Conduit.Telemetry.dispatch(
              Conduit.Telemetry.JobCompleted(job.id, duration_ms))
            -- Release unique key on successful completion.
            prelease_unique(storage, job)
          Err(e)  -> Logger.error("conduit: mark_completed failed for " ++ job.id ++ ": " ++ e)
        end

      Err(Conduit.ConduitError.Retry(msg)) ->
        phandle_retry(storage, job, attempt, config, msg)

      Err(Conduit.ConduitError.WorkerError(msg)) ->
        Logger.error("conduit: worker error on " ++ job.id ++ ": " ++ msg)
        phandle_retry(storage, job, attempt, config, "worker error: " ++ msg)

      Err(Conduit.ConduitError.Discard(msg)) ->
        Logger.info("conduit: discarding " ++ job.id ++ " (" ++ job.job_type ++ "): " ++ msg)
        phandle_discard(storage, job, config, msg)

      Err(Conduit.ConduitError.Snooze(dur)) ->
        let wake_at = DateTime.add_ms(DateTime.from_timestamp(DateTime.now()), dur)
        match Conduit.Storage.mark_snoozed(storage, job.id, wake_at) do
          Ok(_)  ->
            Conduit.Telemetry.dispatch(
              Conduit.Telemetry.JobSnoozed(job.id, wake_at))
          Err(e)  -> Logger.error("conduit: mark_snoozed error for " ++ job.id ++ ": " ++ e)
        end
    end
  end

  -- Retry path: check if attempts remain; if so reschedule, else dead-letter.
  --
  -- Backoff delay = base strategy delay + uniform jitter in [0, 1000] ms.
  -- Jitter uses the global RNG (Random.int) to give each concurrent retrying job
  -- a distinct run_at, avoiding thundering-herd on the queue.
  pfn phandle_retry(storage, job : Conduit.JobRow, attempt : Int, config : Conduit.JobConfig, error_msg : String) : () do
    if attempt >= config.max_attempts do
      -- Exhausted — emit failure event (no more retries) then dead-letter.
      Logger.info("conduit: job " ++ job.id ++ " exhausted " ++ int_to_string(attempt) ++ " attempts, dead-lettering")
      Conduit.Telemetry.dispatch(
        Conduit.Telemetry.JobFailed(job.id, error_msg, attempt, false))
      phandle_dead(storage, job, config, error_msg)
    else
      -- Compute run_at: base backoff delay + random jitter.
      -- Random.int uses the global PRNG (not time-seeded), so concurrent retries
      -- get independent jitter values even if they run in the same millisecond.
      let base_delay  = Conduit.Backoff.delay(config.backoff, attempt)
      let jitter_ms   = Random.int(0, 1000)
      let run_at      = DateTime.add_ms(
                          DateTime.add_ms(DateTime.from_timestamp(DateTime.now()), base_delay),
                          jitter_ms
                        )
      Logger.debug("conduit: scheduling retry for " ++ job.id ++ " at attempt " ++ int_to_string(attempt + 1))
      Conduit.Telemetry.dispatch(
        Conduit.Telemetry.JobFailed(job.id, error_msg, attempt, true))
      match Conduit.Storage.schedule_retry(storage, job.id, error_msg, run_at) do
        Ok(_)  -> ()
        Err(e)  -> Logger.error("conduit: schedule_retry error for " ++ job.id ++ ": " ++ e)
      end
    end
  end

  -- Discard path: no retries, but may still go to DLQ.
  --
  -- If dead_letter_queue is configured, route to the dead-letter table and fire
  -- the on_dead_letter callback.  Otherwise, discard the job in-place (mark dead).
  pfn phandle_discard(storage, job : Conduit.JobRow, config : Conduit.JobConfig, reason : String) : () do
    Conduit.Telemetry.dispatch(
      Conduit.Telemetry.JobDiscarded(job.id, reason))
    match config.dead_letter_queue do
      None ->
        -- No DLQ configured: just mark the job dead in-place.
        match Conduit.Storage.discard(storage, job.id, "discarded: " ++ reason) do
          Ok(_)  -> prelease_unique(storage, job)
          Err(e)  -> Logger.error("conduit: discard error for " ++ job.id ++ ": " ++ e)
        end
      Some(_) ->
        -- Route to the dead-letter table.
        phandle_dead(storage, job, config, "discarded: " ++ reason)
    end
  end

  -- Dead-letter path: insert into conduit_dead_letters, fire callback, release unique key.
  --
  -- The unique constraint is released so the same job type + payload can be
  -- re-enqueued (e.g. after the underlying bug is fixed).
  pfn phandle_dead(storage, job : Conduit.JobRow, config : Conduit.JobConfig, error_msg : String) : () do
    let dl = Conduit.DeadLetter.from_job(job, error_msg)
    match Conduit.Storage.move_to_dead_letter(storage, dl) do
      Err(e)  -> Logger.error("conduit: move_to_dead_letter error for " ++ job.id ++ ": " ++ e)
      Ok(_)  ->
        -- Release the unique constraint so the same job can be re-enqueued.
        prelease_unique(storage, job)
        -- Fire the on_dead_letter callback if configured.
        match config.on_dead_letter do
          None         -> ()
          Some(cb)     -> cb(Conduit.DeadLetter.to_job_info(job))
        end
    end
  end

  -- Heartbeat task: updates the DB every `interval_ms`, stops when the stop flag is set.
  --
  -- The stop flag lives in the shared `hb_flags` Vault table under the job's id.
  -- After job execution (success or failure), the worker sets the flag to `true`.
  -- The next heartbeat tick checks the flag and exits cleanly — no task_await_unwrap
  -- needed, which would block forever on an infinite-loop task.
  pfn heartbeat_loop(storage, job_id : String, interval_ms : Int, hb_flags) : () do
    psleep_ms(interval_ms)
    match Vault.get(hb_flags, job_id) do
      Some(true) ->
        -- Clean up the flag entry and exit.
        Vault.drop(hb_flags, job_id)
      _ ->
        match Conduit.Storage.heartbeat(storage, job_id) do
          Ok(_)  -> ()
          Err(e)  -> Logger.warn("conduit: heartbeat error for " ++ job_id ++ ": " ++ e)
        end
        heartbeat_loop(storage, job_id, interval_ms, hb_flags)
    end
  end

  -- Stale-rescue loop: periodically finds crashed workers' jobs and requeues them.
  --
  -- A job is considered stale when heartbeat_at has not been updated for more than
  -- the stale timeout (default 60s).  The rescue loop resets stale jobs to "pending"
  -- so they can be re-claimed by healthy workers.
  --
  -- Runs every `interval_ms` (typically 10× the worker poll interval).
  pfn rescue_loop(storage, interval_ms : Int) : () do
    let _ = psleep_ms(interval_ms)
    let _ = match Conduit.Storage.rescue_stale(storage, 60) do
      Ok(ids) ->
        if is_nil(ids) do ()
        else Logger.info("conduit: rescued " ++ int_to_string(length(ids)) ++ " stale job(s)") end
      Err(e) ->
        Logger.error("conduit: rescue_stale error: " ++ e)
    end
    rescue_loop(storage, interval_ms)
  end

  -- Cooperative sleep: yields the task scheduler `n * 10` times to sleep ~ms.
  --
  -- This is not a wall-clock sleep; it yields for approximately `ms` worth of
  -- scheduler ticks.  Use for poll delays and heartbeat intervals, not for
  -- precision timing.
  pfn psleep_ms(ms : Int) : () do
    psleep_loop(int_div(ms, 10))
  end

  pfn psleep_loop(n : Int) : () do
    if n <= 0 do
      ()
    else
      task_yield()
      psleep_loop(n - 1)
    end
  end

  -- Release the unique constraint for a job, if it has one.
  --
  -- Called on success and on dead-letter so that the same job type + payload can
  -- be re-enqueued without triggering the uniqueness guard.
  pfn prelease_unique(storage, job : Conduit.JobRow) : () do
    match job.unique_key do
      None    -> ()
      Some(_) ->
        match Conduit.Unique.release(storage, job.id) do
          Ok(_)  -> ()
          Err(e)  -> Logger.warn("conduit: unique_release error for " ++ job.id ++ ": " ++ e)
        end
    end
  end

  pfn pmax_int(a : Int, b : Int) : Int do
    if a > b do a else b end
  end
end
