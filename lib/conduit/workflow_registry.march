mod Conduit.WorkflowRegistry do
  needs IO.Mut

  type WorkflowEntry = { config : Conduit.WorkflowConfig }

  fn register(
    workflow_type : String,
    runner        : String -> Conduit.WorkflowContext -> Result(String, Conduit.WorkflowError),
    config        : Conduit.WorkflowConfig
  ) : () do
    Vault.set(fn_registry_key(), "fn:" ++ workflow_type, runner)
    Vault.set(cfg_registry_key(), "cfg:" ++ workflow_type, config)
  end

  fn lookup_config(workflow_type : String) : Option(Conduit.WorkflowConfig) do
    Vault.get(cfg_registry_key(), "cfg:" ++ workflow_type)
  end

  fn lookup(workflow_type : String) : Option(WorkflowEntry) do
    match Vault.get(cfg_registry_key(), "cfg:" ++ workflow_type) do
      None      -> None
      Some(cfg) -> Some({ config: cfg })
    end
  end

  fn run(
    workflow_type : String,
    input_json    : String,
    ctx           : Conduit.WorkflowContext
  ) do
    match Vault.get(fn_registry_key(), "fn:" ++ workflow_type) do
      None    -> Err(Conduit.WorkflowError.Failed("No workflow registered for type: " ++ workflow_type))
      Some(runner) ->
        let apply_ctx = runner(input_json)
        apply_ctx(ctx)
    end
  end

  -- Vault table handles are typed `Vault(v)`, so runner functions and
  -- configs (different element types) need separate tables now.
  pfn fn_registry_key() do
    match Vault.whereis("conduit_workflow_registry_fn") do
      Some(tbl) -> tbl
      None      -> Vault.new("conduit_workflow_registry_fn")
    end
  end

  pfn cfg_registry_key() do
    match Vault.whereis("conduit_workflow_registry_cfg") do
      Some(tbl) -> tbl
      None      -> Vault.new("conduit_workflow_registry_cfg")
    end
  end
end
