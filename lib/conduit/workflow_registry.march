mod Conduit.WorkflowRegistry do

  type WorkflowEntry = { config : Conduit.WorkflowConfig }

  fn register(
    workflow_type : String,
    runner        : String -> Conduit.WorkflowContext -> Result(String, Conduit.WorkflowError),
    config        : Conduit.WorkflowConfig
  ) : () do
    let tbl = registry_key()
    Vault.set(tbl, "fn:" ++ workflow_type, runner)
    Vault.set(tbl, "cfg:" ++ workflow_type, config)
  end

  fn lookup_config(workflow_type : String) : Option(Conduit.WorkflowConfig) do
    Vault.get(registry_key(), "cfg:" ++ workflow_type)
  end

  fn lookup(workflow_type : String) : Option(WorkflowEntry) do
    match Vault.get(registry_key(), "cfg:" ++ workflow_type) do
      None      -> None
      Some(cfg) -> Some({ config = cfg })
    end
  end

  fn run(
    workflow_type : String,
    input_json    : String,
    ctx           : Conduit.WorkflowContext
  ) : Result(String, Conduit.WorkflowError) do
    match Vault.get(registry_key(), "fn:" ++ workflow_type) do
      None    -> Err(Conduit.WorkflowError.Failed("No workflow registered for type: " ++ workflow_type))
      Some(runner) ->
        let apply_ctx = runner(input_json)
        apply_ctx(ctx)
    end
  end

  pfn registry_key() do
    match Vault.whereis("conduit_workflow_registry") do
      Some(tbl) -> tbl
      None      -> Vault.new("conduit_workflow_registry")
    end
  end
end
