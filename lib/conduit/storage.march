-- Conduit.Storage — pluggable storage backend interface.
--
-- Every function in the Conduit engine that touches durable state calls through
-- this interface.  Implement it for your preferred database to make Conduit work
-- with that backend.
--
-- The only shipping implementation is `Conduit.Storage.Postgres` (Phase 5).
-- Tests use lightweight in-memory fakes that implement this interface directly
-- (see `test/test_conduit.march` and `test/test_deterministic_app.march`).
--
-- All methods follow the same error convention:
--   Ok(value)   — success
--   Err(String) — storage error message.  Workers and schedulers treat these as
--                 transient; they log the error and retry on the next cycle.
--
-- Implementation notes
-- ─────────────────────
-- • fetch_next MUST use a SELECT … FOR UPDATE SKIP LOCKED (or equivalent) to
--   prevent two workers from claiming the same job.
-- • mark_running MUST be idempotent: if the job was already claimed by another
--   worker between fetch_next and mark_running, return Err so the caller backs
--   off gracefully.
-- • All timestamp columns should be `timestamptz`; store and return UTC.
-- • The storage backend is responsible for atomicity within each call; the
--   application layer does not wrap multiple calls in a single transaction.
mod Conduit do
  interface Storage(s) do

    -- ── Job lifecycle ──────────────────────────────────────────────────────

    doc """
    Insert a new job row and return its id on success.

    The row must be inserted with `status = "pending"`.  If a `unique_key` is
    present on the row, enforce the partial unique index
    (unique_key IS NOT NULL AND status NOT IN ('completed', 'dead')).
    On conflict with an existing active unique_key, return Err with a descriptive
    message so the application layer can apply its `on_conflict` policy.
    """
    fn enqueue : s -> Conduit.JobRow -> Result(String, String)

    doc """
    Atomically claim the next eligible job from `queue` for execution.

    Eligibility criteria (to be enforced by the storage implementation):
      • status IN ('pending', 'snoozed')
      • run_at <= NOW()
    Order: priority DESC, run_at ASC (highest priority, earliest scheduled first).

    Uses SELECT … FOR UPDATE SKIP LOCKED so that concurrent workers on the same
    queue each claim a distinct job.  Returns Ok(None) when the queue is empty.
    """
    fn fetch_next : s -> String -> Result(Option(Conduit.JobRow), String)

    doc """
    Claim a job for execution by setting status = "running", worker_id, and
    started_at = NOW().  Increment `attempt` by 1.

    Must be idempotent: if the job was claimed by a different worker between
    fetch_next and mark_running, return Err so the caller skips this job.
    """
    fn mark_running : s -> String -> String -> Result((), String)

    doc """
    Mark a job as successfully completed.

    Sets status = "completed" and completed_at = NOW().
    """
    fn mark_completed : s -> String -> Result((), String)

    doc """
    Postpone a job without consuming a retry attempt.

    Sets status = "snoozed" and run_at = wake_at.  The job will become eligible
    again when run_at elapses.  Used by the rate-limiter and by performers that
    return `Snooze`.
    """
    fn mark_snoozed : s -> String -> DateTime -> Result((), String)

    doc """
    Refresh the heartbeat timestamp for a running job.

    Sets heartbeat_at = NOW().  Called by the per-job heartbeat background task
    every (timeout / 3) ms.  Jobs with a stale heartbeat_at are reclaimed by
    `rescue_stale`.
    """
    fn heartbeat : s -> String -> Result((), String)

    doc """
    Schedule a failed job for retry.

    Appends `error_msg` to the job's `errors` list, sets status = "pending", and
    sets run_at = retry_at.  Does NOT increment `attempt`; that is done by
    `mark_running` when the job is next claimed.
    """
    fn schedule_retry : s -> String -> String -> DateTime -> Result((), String)

    doc """
    Permanently discard a job without retrying.

    Sets status = "dead" and appends `reason` to the errors list.  Used when
    there is no dead-letter queue configured.
    """
    fn discard : s -> String -> String -> Result((), String)

    doc """
    Move a failed job to the dead-letter table.

    Inserts a row into `conduit_dead_letters` and sets the originating job's
    status = "dead".  Should be done atomically (e.g. in a transaction) to avoid
    the dead-letter row existing without a corresponding terminal job status.
    """
    fn move_to_dead_letter : s -> Conduit.DeadLetter -> Result((), String)

    doc """
    Reclaim in-flight jobs from crashed workers.

    Finds jobs in status = "running" whose heartbeat_at is older than
    `stale_threshold_s` seconds (or whose started_at is old and heartbeat_at
    is NULL).  Resets them to status = "pending" so they will be picked up again.
    Returns the list of reclaimed job ids.

    Called by both the node stale-detection loop and the per-queue rescue loop.
    """
    fn rescue_stale : s -> Int -> Result(List(String), String)

    -- ── Cron ──────────────────────────────────────────────────────────────

    doc """
    Insert or update a cron schedule row (upsert by id).

    Called by `Conduit.CronScheduler.upsert_static` at startup for static crons
    and by `Conduit.API.schedule_cron` for dynamic crons.  Must update all
    mutable fields (schedule, timezone, queue, payload, overlap, enabled,
    next_run_at, tags) when a row with the same id already exists.
    """
    fn cron_upsert : s -> Conduit.CronSchedule -> Result((), String)

    doc """
    Load all enabled cron schedules that are due to fire.

    A schedule is due when `enabled = true` AND `next_run_at <= NOW()` (or
    `next_run_at IS NULL`, meaning it has never run).
    """
    fn cron_load_due : s -> Result(List(Conduit.CronSchedule), String)

    doc "Load a single cron schedule by id.  Returns None if not found."
    fn cron_load_by_id : s -> String -> Result(Option(Conduit.CronSchedule), String)

    doc """
    Record that a cron fired and update scheduling metadata.

    Sets last_run_at = NOW(), last_job_id = job_id, and next_run_at = next
    for the cron with the given id.
    """
    fn cron_mark_fired : s -> String -> String -> Option(DateTime) -> Result((), String)

    doc """
    Return true if the job with the given id is still active (pending or running).

    Used by the Skip overlap policy to decide whether to fire the next tick.
    """
    fn cron_job_active : s -> String -> Result(Bool, String)

    doc """
    Cancel a job that was previously fired by a cron (for the Replace policy).

    Sets the job's status = "dead".  If the job is not found or already in a
    terminal state, succeed silently.
    """
    fn cron_cancel_job : s -> String -> Result((), String)

    doc """
    Delete a cron schedule row permanently.

    Does not affect already-enqueued jobs.  Used by `Conduit.API.cancel_cron`.
    """
    fn cron_delete : s -> String -> Result((), String)

    doc """
    Attempt to acquire an advisory lock for the given integer lock_id.

    Returns Ok(true) if the lock was acquired by this session, Ok(false) if
    another session already holds it.  Used by the cron scheduler to ensure
    only one node fires cron jobs per tick.

    In Postgres: `SELECT pg_try_advisory_lock(lock_id)`.
    """
    fn cron_advisory_lock : s -> Int -> Result(Bool, String)

    doc """
    Release a previously acquired advisory lock.

    Must be called after `cron_advisory_lock` returns Ok(true), even if the
    tick produced an error, to avoid starving other nodes.

    In Postgres: `SELECT pg_advisory_unlock(lock_id)`.
    """
    fn cron_advisory_unlock : s -> Int -> Result((), String)

    -- ── Multi-node cluster ─────────────────────────────────────────────────

    doc """
    Insert or update a node registration row in `conduit_workers`.

    Called at startup by `Conduit.Node.start`.  Upsert by node id.
    """
    fn node_register : s -> Conduit.NodeInfo -> Result((), String)

    doc """
    Refresh `last_seen_at` for the given node id.

    Called every `heartbeat_interval_ms` by the node heartbeat background task.
    """
    fn node_heartbeat : s -> String -> Result((), String)

    doc """
    Mark a node as stopped and clear its in-flight jobs.

    Sets status = "stopped" for the given node id.  Called by
    `Conduit.API.stop` during graceful shutdown.
    """
    fn node_deregister : s -> String -> Result((), String)

    doc """
    Return all nodes with status = "running".

    Used by the dashboard nodes page and by `Conduit.API.cluster_nodes`.
    """
    fn node_list_active : s -> Result(List(Conduit.NodeInfo), String)

    doc """
    Reclaim in-flight jobs from nodes that have not sent a heartbeat within
    `stale_threshold_s` seconds.

    Sets those jobs back to status = "pending".  Returns the list of reclaimed
    job ids.  Complementary to `rescue_stale`: `rescue_stale` uses heartbeat_at
    on the job row; `node_reclaim_jobs` uses last_seen_at on the node row.
    """
    fn node_reclaim_jobs : s -> Int -> Result(List(String), String)

    doc """
    Mark nodes that have exceeded the stale threshold as stopped.

    Sets status = "stale" (or "stopped") for nodes with
    last_seen_at < NOW() - stale_threshold_s seconds.
    Returns the number of nodes updated.
    """
    fn node_cleanup_stale : s -> Int -> Result(Int, String)

    doc """
    Attempt to acquire the leader advisory lock (lock_id = 8473625).

    Returns Ok(true) if this node is now the leader, Ok(false) if another node
    holds the lock.  Implementations should use a session-level advisory lock
    that is automatically released if the connection drops.
    """
    fn node_try_leader_lock : s -> Int -> Result(Bool, String)

    doc """
    Release the leader advisory lock.

    Called by `Conduit.Node.stop` during graceful shutdown so another node
    can be elected immediately.
    """
    fn node_release_leader_lock : s -> Int -> Result((), String)

    -- ── Workflows ──────────────────────────────────────────────────────────

    doc """
    Insert a new workflow row.  Returns the workflow id on success.
    """
    fn workflow_insert : s -> Conduit.WorkflowRow -> Result(String, String)

    doc """
    Load a workflow row by id.  Returns None if not found.
    """
    fn workflow_load : s -> String -> Result(Option(Conduit.WorkflowRow), String)

    doc """
    Return all workflow rows.  Used by the dashboard list page.

    NOTE: This loads the full table without pagination; implementations should
    add a LIMIT if the table is large.  A paginated variant is planned for
    Phase 6.
    """
    fn workflow_list_all : s -> Result(List(Conduit.WorkflowRow), String)

    doc """
    Return only the status field for a workflow id.

    More efficient than `workflow_load` when the caller only needs to poll status.
    Returns None if the workflow does not exist.
    """
    fn workflow_status_get : s -> String -> Result(Option(String), String)

    doc """
    Transition a workflow to a new status.

    Sets status, optionally output (on "completed"), optionally error (on
    "failed" / "cancelled" / "timed_out"), and completed_at = NOW() for all
    terminal statuses.
    """
    fn workflow_update_status : s -> String -> String -> Option(String) -> Option(String) -> Result((), String)

    doc """
    Cancel a running workflow.

    Sets status = "cancelled" and error = reason.  If the workflow is already
    in a terminal state, this is a no-op (return Ok).
    """
    fn workflow_cancel : s -> String -> String -> Result((), String)

    -- ── Checkpoints ────────────────────────────────────────────────────────

    doc """
    Return the stored value for a checkpoint (workflow_id, name) pair.

    Returns None if no checkpoint with that name exists for the workflow.
    """
    fn checkpoint_get : s -> String -> String -> Result(Option(String), String)

    doc """
    Persist a checkpoint value.

    Upsert by (workflow_id, name).  `duration_ms` is the wall-clock time the
    checkpoint function took; store it for observability.
    """
    fn checkpoint_set : s -> String -> String -> String -> Int -> Result((), String)

    doc """
    Load all checkpoints for a workflow in insertion order.

    Used by `WorkflowContext.warm_cache` to pre-populate the in-process Vault
    cache before workflow execution begins, avoiding per-checkpoint DB round-trips
    during replay.
    """
    fn checkpoint_load_all : s -> String -> Result(List(Conduit.WorkflowCheckpoint), String)

    -- ── Signals ────────────────────────────────────────────────────────────

    doc """
    Insert a workflow signal row.  Returns the new signal id on success.
    """
    fn signal_insert : s -> Conduit.WorkflowSignal -> Result(Int, String)

    doc """
    Return the oldest undelivered signal of `signal_type` for `workflow_id`.

    Returns None if no matching pending signal exists.
    """
    fn signal_peek : s -> String -> String -> Result(Option(Conduit.WorkflowSignal), String)

    doc """
    Mark a signal as delivered (status = "delivered", delivered_at = NOW()).
    """
    fn signal_mark_delivered : s -> Int -> Result((), String)

    -- ── Dashboard queries ──────────────────────────────────────────────────

    doc """
    Return per-queue aggregate stats for the dashboard overview page.

    Each row should contain counts for pending, running, failed, dead jobs
    and optionally throughput (completed in last 24 h) and average latency.
    """
    fn dashboard_queue_summary : s -> Result(List(Conduit.Dashboard.QueueSummary), String)

    doc """
    Return a paginated list of jobs for a queue, optionally filtered by status.

    `queue` — queue name; empty string means all queues.
    `status` — status filter; empty string means all statuses.
    `page`   — 1-based page number; page size is implementation-defined (typ. 50).
    """
    fn dashboard_jobs_list : s -> String -> String -> Int -> Result(List(Conduit.JobRow), String)

    doc """
    Return a single job row by primary key id.

    Used by the dashboard job-detail page.  Prefer this over loading all jobs
    and filtering in memory.  Returns None if the job does not exist.
    """
    fn dashboard_job_by_id : s -> String -> Result(Option(Conduit.JobRow), String)

    doc """
    Return all cron schedules (enabled and disabled) for the dashboard crons page.

    Unlike `cron_load_due`, this returns every schedule regardless of whether it
    is currently past its next_run_at.  The dashboard needs to show disabled and
    future crons too.
    """
    fn dashboard_crons_list : s -> Result(List(Conduit.CronSchedule), String)

    doc """
    Return a paginated list of workflows, optionally filtered by status.

    `status_filter` — status string ("running", "completed", …); empty means all.
    `page`          — 1-based page number; page size is implementation-defined (typ. 50).
    """
    fn dashboard_workflows_list : s -> String -> Int -> Result(List(Conduit.WorkflowRow), String)

    doc """
    Return a paginated list of dead-letter rows.

    `page` — 1-based page number; page size is implementation-defined (typ. 50).
    """
    fn dead_letter_list : s -> Int -> Result(List(Conduit.DeadLetter), String)

    doc """
    Return all dead-letter rows across all pages.

    Used by bulk-retry and bulk-delete operations that must act on every row,
    not just the first page.  Implementations may stream the rows in batches.
    """
    fn dead_letter_list_all : s -> Result(List(Conduit.DeadLetter), String)

    doc """
    Delete all dead-letter rows.  Irreversible.

    Used by the dashboard delete-all action.
    """
    fn dead_letter_delete_all : s -> Result(Int, String)

    doc "Load a single dead-letter row by id.  Returns None if not found."
    fn dead_letter_load : s -> String -> Result(Option(Conduit.DeadLetter), String)

    doc """
    Reset a job to pending so it can be retried by a worker.

    Sets status = "pending", attempt = 0, run_at = NOW(), and clears
    started_at / completed_at / worker_id.  Used by the dashboard Retry action.
    """
    fn job_retry : s -> String -> Result((), String)

    doc """
    Cancel a job by setting status = "dead" with a reason string appended to errors.

    Used by the dashboard Cancel action.
    """
    fn job_cancel : s -> String -> String -> Result((), String)

    doc "Hard-delete a job row.  Irreversible."
    fn job_delete : s -> String -> Result((), String)

    doc "Hard-delete a dead-letter row.  Irreversible."
    fn dead_letter_delete : s -> String -> Result((), String)

    doc """
    Subscribe to Postgres LISTEN notifications for the given channel.

    The channel name follows the convention `conduit_queue_<queue>`.  Callers
    use this to wake workers immediately when a new job is inserted, reducing
    effective latency below the poll interval.  Implementations that do not
    support LISTEN/NOTIFY may return Ok(()) as a no-op.
    """
    fn notify_subscribe : s -> String -> Result((), String)

    -- ── Rate limiting ──────────────────────────────────────────────────────

    doc """
    Attempt to consume one token from the rate-limit bucket for `key`.

    `key`  — namespaced bucket identifier (e.g. "conduit_rl:MyJob").
    `rate` — maximum tokens per second; the bucket refills at this rate.

    Returns Ok(true) if a token was consumed (job may proceed), Ok(false) if
    the bucket is empty (job should be snoozed).  Uses a token-bucket algorithm
    stored in `conduit_rate_limit_buckets`.
    """
    fn rate_limit_acquire : s -> String -> Int -> Result(Bool, String)

    doc """
    Return true if an active job with the given unique fingerprint exists.

    "Active" means status NOT IN ('completed', 'dead').  Used by the uniqueness
    guard before enqueuing.
    """
    fn unique_check : s -> String -> Result(Bool, String)

    doc """
    Clear the unique_key for the job with the given id (set to NULL).

    Called after a job completes, is discarded, or is dead-lettered, so the
    same logical job can be enqueued again without violating the unique index.
    """
    fn unique_release : s -> String -> Result((), String)

    -- ── Event store (Phase 3 — Deterministic Replay) ──────────────────────

    doc """
    Append an event to the workflow event log.

    `workflow_id` — owning workflow.
    `sequence`    — 0-based monotonic sequence number within the workflow.
    `event_type`  — category string; "checkpoint" for checkpoint events.
    `payload`     — JSON string with event-specific fields.

    Returns the auto-generated event id on success.  Should reject duplicate
    (workflow_id, sequence) pairs to preserve replay determinism.
    """
    fn event_append : s -> String -> Int -> String -> String -> Result(Int, String)

    doc """
    Load all events for a workflow ordered by sequence ASC.

    Used by `EventStore.warm_replay` to populate the in-process replay cache.
    """
    fn event_load_all : s -> String -> Result(List(Conduit.WorkflowEvent), String)

    doc """
    Load events for a workflow with sequence <= max_sequence, ordered by sequence ASC.

    Used by `EventStore.warm_replay_to` for point-in-time replay debugging.
    """
    fn event_load_up_to : s -> String -> Int -> Result(List(Conduit.WorkflowEvent), String)

    doc "Return the total number of events recorded for a workflow."
    fn event_count : s -> String -> Result(Int, String)
  end
end
