mod Conduit.WorkflowContext do
  doc "Create a root context for a new or resuming workflow execution."
  fn new(workflow_id : String) : Conduit.WorkflowContext do
    {
      workflow_id: workflow_id,
      parent_id: None,
      namespace: "",
      checkpoint_key: pvault_key(workflow_id)
    }
  end

  doc "Create a sub-context for a parallel branch (namespaced checkpoints)."
  fn child(ctx : Conduit.WorkflowContext, branch_prefix : String) : Conduit.WorkflowContext do
    {
      workflow_id: ctx.workflow_id,
      parent_id: ctx.parent_id,
      namespace: ctx.namespace ++ branch_prefix,
      checkpoint_key: ctx.checkpoint_key
    }
  end

  doc """
  Execute a durable checkpoint.

  1. Check in-memory Vault cache for `namespace ++ name`.
  2. If cached: return immediately — fn is NOT called.
  3. Check DB: `conduit_checkpoints` for (workflow_id, full_name).
  4. If found in DB: populate cache and return.
  5. Otherwise: call fn(), record duration, persist to DB, cache, return.

  `f` must return a String (typically JSON-serialized). The return value
  is the stored string on success or a WorkflowError on failure.
  """
  fn checkpoint(storage : s, ctx : Conduit.WorkflowContext, name : String, f) : Result(String, WorkflowError) do
    let full_name = ctx.namespace ++ name
    -- Check if deterministic replay mode is active for this workflow.
    let replay_key = Conduit.EventStore.replay_key(ctx.workflow_id)
    let mode = Vault.get(replay_key, "mode") |> unwrap_or("")
    if mode == "deterministic_replay" do
      preplay_checkpoint(storage, ctx, replay_key, full_name, f)
    else
      -- Normal checkpoint mode (Phase 4 behavior).
      pnormal_checkpoint(storage, ctx, full_name, f)
    end
  end

  -- Normal checkpoint: cache → DB → execute → persist (Phase 4 path).
  pfn pnormal_checkpoint(storage : s, ctx : Conduit.WorkflowContext, full_name : String, f) do
    -- 1. In-memory cache hit
    match pvault_get(ctx.checkpoint_key, full_name) do
      Some(v) -> Ok(v)
      None    ->
        -- 2. DB lookup
        match Conduit.Storage.checkpoint_get(storage, ctx.workflow_id, full_name) do
          Err(e)      -> Err(StorageError(e))
          Ok(Some(v)) ->
            pvault_set(ctx.checkpoint_key, full_name, v)
            Ok(v)
          Ok(None) ->
            -- Atomically claim the key before executing. The "__in_progress__"
            -- sentinel prevents two concurrent resumes from both executing f().
            if Vault.put_new(ctx.checkpoint_key, full_name, "__in_progress__") do
              let started = DateTime.now()
              let value   = f()
              let dur_ms  = (DateTime.now() - started) * 1000
              match Conduit.Storage.checkpoint_set(storage, ctx.workflow_id, full_name, value, dur_ms) do
                Err(e) ->
                  Vault.drop(ctx.checkpoint_key, full_name)
                  Err(StorageError(e))
                Ok(_) ->
                  pvault_set(ctx.checkpoint_key, full_name, value)
                  Ok(value)
              end
            else
              -- Another task holds the claim; re-read the sentinel.
              match pvault_get(ctx.checkpoint_key, full_name) do
                Some(v) ->
                  if v == "__in_progress__" do
                    Err(StorageError("checkpoint '" ++ full_name ++ "' is already executing"))
                  else
                    Ok(v)
                  end
                None -> Err(StorageError("checkpoint '" ++ full_name ++ "' claim lost"))
              end
            end
        end
    end
  end

  -- Deterministic replay checkpoint: consume from event store or execute + append.
  pfn preplay_checkpoint(storage : s, ctx : Conduit.WorkflowContext, replay_key, full_name : String, f) do
    let cursor      = Vault.get(replay_key, "cursor")      |> unwrap_or(0)
    let event_count = Vault.get(replay_key, "event_count") |> unwrap_or(0)
    if cursor < event_count do
      -- Replay: read recorded event, advance cursor, return value.
      let event_payload = Vault.get(replay_key, "event:" ++ int_to_string(cursor)) |> unwrap_or("{}")
      let value = Conduit.EventStore.extract_value(event_payload)
      let _ = Vault.incr(replay_key, "cursor", 1)
      -- Also populate the normal checkpoint cache so subsequent non-replay reads work.
      pvault_set(ctx.checkpoint_key, full_name, value)
      Ok(value)
    else
      -- First execution territory: execute fn, append event, advance cursor.
      let started = DateTime.now()
      let value   = f()
      let dur_ms  = (DateTime.now() - started) * 1000
      let next_seq = Vault.get(replay_key, "next_seq") |> unwrap_or(cursor)
      let event_payload = Conduit.EventStore.checkpoint_payload(full_name, value, dur_ms)
      match Conduit.EventStore.append(storage, ctx.workflow_id, next_seq, "checkpoint", event_payload) do
        Err(e) -> Err(StorageError(e))
        Ok(_)  ->
          -- Cache the event in Vault for potential later replay access.
          Vault.set(replay_key, "event:" ++ int_to_string(next_seq), event_payload)
          let _ = Vault.incr(replay_key, "cursor",      1)
          let _ = Vault.incr(replay_key, "next_seq",    1)
          let _ = Vault.incr(replay_key, "event_count", 1)
          -- Also populate normal checkpoint cache + DB.
          match Conduit.Storage.checkpoint_set(storage, ctx.workflow_id, full_name, value, dur_ms) do
            Err(e) -> Err(StorageError(e))
            Ok(_) ->
              pvault_set(ctx.checkpoint_key, full_name, value)
              Ok(value)
          end
      end
    end
  end

  doc """
  Fan-out over a list of items, each with its own checkpoint sub-namespace.

  Each item gets a child context `"parallel:N:"` so its checkpoints are
  isolated and resumable independently. Execution is sequential in Phase 4.

  `f` takes (item, sub_ctx) and returns Result(String, WorkflowError).
  Returns Ok(List(String)) with results in order, or Err on first failure.
  """
  fn parallel(storage : s, ctx : Conduit.WorkflowContext, items : List(a), f) do
    pparallel_loop(storage, ctx, items, f, 0, Nil)
  end

  pfn pparallel_loop(storage : s, ctx : Conduit.WorkflowContext, items : List(a), f, index : Int, acc : List(String)) do
    match items do
      Nil -> Ok(List.reverse(acc))
      Cons(item, rest) ->
        let branch_prefix = "parallel:" ++ int_to_string(index) ++ ":"
        let branch_ctx    = child(ctx, branch_prefix)
        match f(item, branch_ctx) do
          Err(e)  -> Err(e)
          Ok(val) -> pparallel_loop(storage, ctx, rest, f, index + 1, Cons(val, acc))
        end
    end
  end

  doc """
  Wait for a signal of `signal_type` to arrive for this workflow.

  Checks the DB immediately for a pending/undelivered signal. If found,
  marks it delivered and returns its payload. If not found, polls every
  second until a signal arrives or the timeout fires.

  Returns Ok(payload_json) or Err(WorkflowError.TimedOut).
  """
  fn wait_for_signal(storage : s, ctx : Conduit.WorkflowContext, signal_type : String, timeout : Option(Duration)) do
    let deadline = Option.map(timeout, fn dur -> DateTime.now() + int_div(Duration.to_milliseconds(dur), 1000))
    pwait_loop(storage, ctx.workflow_id, signal_type, deadline)
  end

  pfn pwait_loop(storage : s, workflow_id : String, signal_type : String, deadline : Option(Int)) do
    let now_ts = DateTime.now()
    let timed_out = match deadline do
      None    -> false
      Some(d) -> now_ts >= d
    end
    if timed_out do
      Err(TimedOut)
    else
      match Conduit.Storage.signal_peek(storage, workflow_id, signal_type) do
        Err(e)        -> Err(StorageError(e))
        Ok(Some(sr)) ->
          match Conduit.Storage.signal_mark_delivered(storage, sr.id) do
            Err(e) -> Err(StorageError(e))
            Ok(_) -> Ok(sr.payload)
          end
        Ok(None) ->
          let _ = psleep_ms(1000)
          pwait_loop(storage, workflow_id, signal_type, deadline)
      end
    end
  end

  doc """
  Load all checkpoints for this workflow from the DB into Vault.
  Call this once before run() to avoid redundant DB lookups during execution.
  """
  fn warm_cache(storage : s, ctx : Conduit.WorkflowContext) : Result((), String) do
    match Conduit.Storage.checkpoint_load_all(storage, ctx.workflow_id) do
      Err(e)          -> Err(e)
      Ok(checkpoints) ->
        List.each(checkpoints, fn cp ->
          pvault_set(ctx.checkpoint_key, cp.name, cp.value))
        Ok(())
    end
  end

  -- ─────────────────────────────────────────────────────────────
  -- Private helpers
  -- ─────────────────────────────────────────────────────────────

  pfn pvault_key(workflow_id : String) do
    let name = "conduit_wf_" ++ workflow_id
    match Vault.whereis(name) do
      Some(tbl) -> tbl
      None      -> Vault.new(name)
    end
  end

  pfn pvault_get(vault_key, name : String) : Option(String) do
    Vault.get(vault_key, name)
  end

  pfn pvault_set(vault_key, name : String, value : String) : () do
    Vault.set(vault_key, name, value)
  end

  pfn psleep_ms(ms : Int) : () do
    psleep_loop(int_div(ms, 10))
  end

  pfn psleep_loop(n : Int) : () do
    if n <= 0 do
      ()
    else
      task_yield()
      psleep_loop(n - 1)
    end
  end
end
