-- Conduit.Node — multi-node cluster registration and leader election.
--
-- Each Conduit process that calls `Conduit.Node.start` registers itself in the
-- `conduit_workers` DB table and maintains its registration via three background
-- tasks:
--
--   heartbeat task  — updates `last_seen_at` every `heartbeat_interval_ms`.
--   stale task      — reclaims jobs from dead workers and purges stale node rows.
--   leader task     — tries to acquire a Postgres advisory lock (id 8473625);
--                     the holder is the cluster leader.
--
-- Leader state is stored in Vault (in-process) so `is_leader()` and
-- `leader_node_id()` are O(1) reads with no DB round-trip.
--
-- Hostname detection
-- ─────────────────
-- `pbuild_node_info` reads the `HOSTNAME` environment variable (set automatically
-- in most container environments).  If unset, it falls back to "localhost".
-- Override via `CONDUIT_HOSTNAME` for bare-metal deployments that use a
-- non-standard env variable.
mod Conduit.Node do

  -- Postgres advisory lock id used for leader election.
  -- This is an arbitrary 32-bit constant shared across all Conduit processes.
  let leader_lock_id = 8473625

  doc """
  Register this node and start the three background tasks.

  Inserts a NodeInfo row into `conduit_workers`, then spawns:
    • A heartbeat task that pings the DB every `heartbeat_interval_ms`.
    • A stale-detection task that reclaims orphaned jobs and prunes dead nodes.
    • A leader-election task that competes for the advisory lock each heartbeat.

  Must be called once at application startup (from `Conduit.API.start`).
  Returns the list of task handles; keep them alive for the lifetime of the node.
  """
  fn start(storage : s, config : Conduit.Config) : List(Task(())) do
    let node = pbuild_node_info(config)
    match Conduit.Storage.node_register(storage, node) do
      Ok(_)  -> ()
      Err(e)  -> Logger.warn("conduit_node: register failed: " ++ e)
    end
    let cluster_tbl = pcluster_tbl()
    Vault.set(cluster_tbl, "node_id",   config.node_id)
    Vault.set(cluster_tbl, "is_leader",  false)

    let heartbeat_task =
      task_spawn(fn _ -> pheartbeat_loop(storage, config.node_id, config.heartbeat_interval_ms))

    let stale_task =
      task_spawn(fn _ -> pstale_loop(storage, config.stale_node_threshold_ms, config.poll_interval_ms * 10))

    let leader_task =
      task_spawn(fn _ -> pleader_loop(storage, config.node_id, config.heartbeat_interval_ms))

    Cons(heartbeat_task, Cons(stale_task, Cons(leader_task, Nil)))
  end

  doc """
  Deregister this node on graceful shutdown.

  Removes the node row from `conduit_workers` and releases the advisory leader
  lock if this node currently holds it.  Call during application shutdown before
  the process exits.
  """
  fn stop(storage : s, node_id : String) : () do
    match Conduit.Storage.node_deregister(storage, node_id) do
      Ok(_)  -> ()
      Err(e)  -> Logger.warn("conduit_node: deregister failed for " ++ node_id ++ ": " ++ e)
    end
    if is_leader() do
      let _ = Conduit.Storage.node_release_leader_lock(storage, leader_lock_id)
      Vault.set(pcluster_tbl(), "is_leader", false)
    else () end
  end

  doc """
  Return true if this node is the current cluster leader.

  Fast in-process Vault read — no DB round-trip.  Updated by the leader task
  on every heartbeat cycle.
  """
  fn is_leader() : Bool do
    Vault.get(pcluster_tbl(), "is_leader") |> unwrap_or(false)
  end

  doc """
  Return the node_id of the last known cluster leader, or None.

  Updated by the leader task each time it wins (or confirms) the advisory lock.
  May lag by up to one heartbeat interval when the leader changes.
  """
  fn leader_node_id() : Option(String) do
    Vault.get(pcluster_tbl(), "leader_node_id")
  end

  -- Update this node's `last_seen_at` in the DB every `interval_ms`.
  --
  -- If the heartbeat fails (DB error), log a warning and continue — a single
  -- missed heartbeat does not remove the node; the stale threshold provides
  -- a grace period (default 30 s).
  pfn pheartbeat_loop(storage : s, node_id : String, interval_ms : Int) : () do
    match Conduit.Storage.node_heartbeat(storage, node_id) do
      Ok(_)  -> ()
      Err(e)  -> Logger.warn("conduit_node: heartbeat failed: " ++ e)
    end
    psleep_ms(interval_ms)
    pheartbeat_loop(storage, node_id, interval_ms)
  end

  -- Reclaim jobs from stale workers and purge dead node rows.
  --
  -- A node is stale if `last_seen_at` is older than `threshold_ms`.  Jobs
  -- owned by stale workers are reset to "pending" so healthy workers can
  -- re-claim them.
  pfn pstale_loop(storage : s, threshold_ms : Int, interval_ms : Int) : () do
    let threshold_s = int_div(threshold_ms, 1000)
    match Conduit.Storage.node_reclaim_jobs(storage, threshold_s) do
      Ok(ids) ->
        if List.is_empty(ids) do ()
        else Logger.info("conduit_node: reclaimed " ++ int_to_string(List.length(ids)) ++ " stale job(s)") end
      Err(e) -> Logger.warn("conduit_node: stale reclaim error: " ++ e)
    end
    match Conduit.Storage.node_cleanup_stale(storage, threshold_s) do
      Ok(n)  ->
        if n > 0 do
          Logger.info("conduit_node: marked " ++ int_to_string(n) ++ " stale node(s) as stopped")
        else () end
      Err(e) -> Logger.warn("conduit_node: stale cleanup error: " ++ e)
    end
    psleep_ms(interval_ms)
    pstale_loop(storage, threshold_ms, interval_ms)
  end

  -- Compete for the advisory leader lock each interval.
  --
  -- `node_try_leader_lock` is an idempotent try-acquire — if this node already
  -- holds the lock, it returns Ok(true) again.  The Vault state is updated each
  -- cycle so callers see the most recent election result.
  pfn pleader_loop(storage : s, node_id : String, interval_ms : Int) : () do
    match Conduit.Storage.node_try_leader_lock(storage, leader_lock_id) do
      Ok(true) ->
        let ct = pcluster_tbl()
        Vault.set(ct, "is_leader",      true)
        Vault.set(ct, "leader_node_id", node_id)
      Ok(false) ->
        Vault.set(pcluster_tbl(), "is_leader", false)
      Err(e) ->
        Logger.warn("conduit_node: leader election error: " ++ e)
    end
    psleep_ms(interval_ms)
    pleader_loop(storage, node_id, interval_ms)
  end

  -- Build the NodeInfo row for this process.
  --
  -- Hostname is read from the HOSTNAME environment variable (set automatically
  -- in Docker/Kubernetes containers) with fallback to "localhost".  Override via
  -- the CONDUIT_HOSTNAME env var for custom deployments.
  pfn pbuild_node_info(config : Conduit.Config) : Conduit.NodeInfo do
    let hostname =
      match process_env("CONDUIT_HOSTNAME") do
        Some(h) -> h
        None    ->
          match process_env("HOSTNAME") do
            Some(h) -> h
            None    -> "localhost"
          end
      end
    let now = DateTime.from_timestamp(DateTime.now())
    {
      id           = config.node_id,
      hostname     = hostname,
      pid          = System.pid(),
      queues       = config.queues,
      pool_size    = config.workers_per_queue,
      started_at   = now,
      last_seen_at = now,
      status       = "running"
    }
  end

  -- Return (or create) the Vault table used for cluster state.
  --
  -- Uses Vault.whereis to find an existing table before creating a new one,
  -- ensuring the cluster table is process-global and idempotent.
  pfn pcluster_tbl() do
    match Vault.whereis("conduit_cluster") do
      Some(tbl) -> tbl
      None      -> Vault.new("conduit_cluster")
    end
  end

  pfn psleep_ms(ms : Int) : () do Conduit.Time.sleep_ms(ms) end
end
