mod Conduit.Node do
  let leader_lock_id = 8473625

  fn start(storage, config : Conduit.Config) : List(Task) do
    let node = pbuild_node_info(config)
    match Conduit.Storage.node_register(storage, node) do
      Ok(_)  -> ()
      Err(e)  -> Logger.warn("conduit_node: register failed: " ++ e)
    end
    Vault.set("conduit_cluster", "node_id",   config.node_id)
    Vault.set("conduit_cluster", "is_leader",  false)

    let heartbeat_task =
      task_spawn(fn () -> pheartbeat_loop(storage, config.node_id, config.heartbeat_interval_ms))

    let stale_task =
      task_spawn(fn () -> pstale_loop(storage, config.stale_node_threshold_ms, config.poll_interval_ms * 10))

    let leader_task =
      task_spawn(fn () -> pleader_loop(storage, config.node_id, config.heartbeat_interval_ms))

    Cons(heartbeat_task, Cons(stale_task, Cons(leader_task, Nil)))
  end

  fn stop(storage, node_id : String) : () do
    match Conduit.Storage.node_deregister(storage, node_id) do
      Ok(_)  -> ()
      Err(e)  -> Logger.warn("conduit_node: deregister failed for " ++ node_id ++ ": " ++ e)
    end
    if is_leader() do
      Conduit.Storage.node_release_leader_lock(storage, leader_lock_id)
      Vault.set("conduit_cluster", "is_leader", false)
    end
  end

  fn is_leader() : Bool do
    Vault.get("conduit_cluster", "is_leader") |> unwrap_or(false)
  end

  fn leader_node_id() : Option(String) do
    Vault.get("conduit_cluster", "leader_node_id")
  end

  pfn pheartbeat_loop(storage, node_id : String, interval_ms : Int) : () do
    match Conduit.Storage.node_heartbeat(storage, node_id) do
      Ok(_)  -> ()
      Err(e)  -> Logger.warn("conduit_node: heartbeat failed: " ++ e)
    end
    psleep_ms(interval_ms)
    pheartbeat_loop(storage, node_id, interval_ms)
  end

  pfn pstale_loop(storage, threshold_ms : Int, interval_ms : Int) : () do
    let threshold_s = int_div(threshold_ms, 1000)
    match Conduit.Storage.node_reclaim_jobs(storage, threshold_s) do
      Ok(ids) ->
        if not (List.is_empty(ids)) do
          Logger.info("conduit_node: reclaimed " ++ int_to_string(List.length(ids)) ++ " stale job(s)")
        end
      Err(e) -> Logger.warn("conduit_node: stale reclaim error: " ++ e)
    end
    match Conduit.Storage.node_cleanup_stale(storage, threshold_s) do
      Ok(n)  ->
        if n > 0 do
          Logger.info("conduit_node: marked " ++ int_to_string(n) ++ " stale node(s) as stopped")
        end
      Err(e) -> Logger.warn("conduit_node: stale cleanup error: " ++ e)
    end
    psleep_ms(interval_ms)
    pstale_loop(storage, threshold_ms, interval_ms)
  end

  pfn pleader_loop(storage, node_id : String, interval_ms : Int) : () do
    match Conduit.Storage.node_try_leader_lock(storage, leader_lock_id) do
      Ok(true) ->
        Vault.set("conduit_cluster", "is_leader",      true)
        Vault.set("conduit_cluster", "leader_node_id", node_id)
      Ok(false) ->
        Vault.set("conduit_cluster", "is_leader", false)
      Err(e) ->
        Logger.warn("conduit_node: leader election error: " ++ e)
    end
    psleep_ms(interval_ms)
    pleader_loop(storage, node_id, interval_ms)
  end

  pfn pbuild_node_info(config : Conduit.Config) : Conduit.NodeInfo do
    {
      id           = config.node_id,
      hostname     = System.hostname(),
      pid          = System.pid(),
      queues       = config.queues,
      pool_size    = config.workers_per_queue,
      started_at   = DateTime.now(),
      last_seen_at = DateTime.now(),
      status       = "running"
    }
  end

  pfn psleep_ms(ms : Int) : () do
    psleep_loop(int_div(ms, 10))
  end

  pfn psleep_loop(n : Int) : () do
    if n <= 0 do
      ()
    else
      task_yield()
      psleep_loop(n - 1)
    end
  end
end
