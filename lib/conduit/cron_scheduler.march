mod Conduit.CronScheduler do
  needs IO.Spawn
  needs IO.Clock
  doc "Start the cron scheduler as a background task."
  fn start(storage : s, tick_interval_ms : Int) : Task(()) do
    task_spawn(fn _ -> scheduler_loop(storage, tick_interval_ms))
  end

  pfn scheduler_loop(storage : s, tick_interval_ms : Int) : () do
    ptick(storage)
    psleep_ms(tick_interval_ms)
    scheduler_loop(storage, tick_interval_ms)
  end

  pfn ptick(storage : s) : () do
    -- Try to acquire the advisory lock. If another node holds it, skip this tick.
    match Conduit.Storage.cron_advisory_lock(storage, 7326482) do
      Err(e) ->
        Logger.error("conduit_cron: advisory lock error: " ++ e)
      Ok(false) ->
        ()   -- another node is handling this tick
      Ok(true) ->
        let result = pfire_due(storage)
        Conduit.Storage.cron_advisory_unlock(storage, 7326482)
        match result do
          Ok(_) -> ()
          Err(e) -> Logger.error("conduit_cron: tick error: " ++ e)
        end
    end
  end

  pfn pfire_due(storage : s) : Result((), String) do
    match Conduit.Storage.cron_load_due(storage) do
      Err(e)       -> Err(e)
      Ok(schedules) ->
        List.each(schedules, fn sched -> pfire_one(storage, sched))
        Ok(())
    end
  end

  pfn pfire_one(storage : s, sched : Conduit.CronSchedule) : () do
    let overlap = Conduit.CronRegistry.overlap_from_string(sched.overlap)
    let should_fire = match overlap do
      Skip ->
        -- Only fire if there is no pending/running job from the last tick.
        match sched.last_job_id do
          None     -> true
          Some(jid) ->
            match Conduit.Storage.cron_job_active(storage, jid) do
              Ok(active) -> if active do false else true end
              Err(_)     -> false
            end
        end
      Allow   -> true
      CronOverlap.Replace ->
        -- Cancel the previous job (if any) before firing.
        match sched.last_job_id do
          None      -> ()
          Some(jid) ->
            match Conduit.Storage.cron_cancel_job(storage, jid) do
              Ok(_)   -> ()
              Err(e)  -> Logger.warn("conduit_cron: cancel previous job " ++ jid ++ ": " ++ e)
            end
        end
        true
    end
    if should_fire do
      pdo_fire(storage, sched)
    else
      ()
    end
  end

  pfn pdo_fire(storage : s, sched : Conduit.CronSchedule) : () do
    -- Honour the registered job's full JobConfig (max_attempts, timeout, backoff,
    -- DLQ, rate_limit, etc.) when the performer is registered.  The cron's own
    -- queue and tags override the job's defaults so users can route a single
    -- performer to different queues per cron schedule.
    let base_config = Conduit.Queue.lookup_config(sched.job_type)
      |> Option.unwrap_or(Conduit.JobConfig.default())
    let config = { base_config with queue: sched.queue, tags: sched.tags }

    -- Apply jitter: if jitter_ms is set, delay the job by a random amount within
    -- [0, jitter_ms].  Prevents thundering-herd when many crons fire at the same second.
    let jitter = match sched.jitter_ms do
      None    -> 0
      Some(j) -> if j > 0 do Random.int(0, j) else 0 end
    end

    let enqueue_result = if jitter > 0 do
      Conduit.Queue.enqueue_in(storage, sched.job_type, sched.payload, jitter, config)
    else
      Conduit.Queue.enqueue(storage, sched.job_type, sched.payload, config)
    end

    match enqueue_result do
      Err(e) ->
        Logger.error("conduit_cron: failed to enqueue " ++ sched.job_type ++ ": " ++ e)
      Ok(job_id) ->
        -- Compute next_run_at in the cron's configured timezone, then convert
        -- the result back to UTC for storage.
        let offset_s  = timezone_offset_s(sched.timezone)
        let now_local = DateTime.from_timestamp(DateTime.now() + offset_s)
        let next = match Conduit.CronParser.next_run(sched.schedule, now_local) do
          Ok(t)  -> Some(DateTime.from_timestamp(DateTime.to_timestamp(t) - offset_s))
          Err(e) ->
            Logger.warn("conduit_cron: cannot compute next_run for " ++ sched.id ++ ": " ++ e)
            None
        end
        match Conduit.Storage.cron_mark_fired(storage, sched.id, job_id, next) do
          Ok(_)   -> ()
          Err(e)  -> Logger.error("conduit_cron: cron_mark_fired error for " ++ sched.id ++ ": " ++ e)
        end
    end
  end

  -- ─────────────────────────────────────────────────────────────
  -- Startup: upsert static crons into the DB
  -- ─────────────────────────────────────────────────────────────

  doc """
  Upsert a static cron into conduit_cron_schedules so it survives restarts.
  Called during Conduit.start for each registered static cron.
  """
  fn upsert_static(storage : s, cron_type : String, config : Conduit.CronConfig) : Result((), String) do
    -- Compute the first next_run_at in the cron's configured timezone, then
    -- convert back to UTC so the scheduler fires at the correct wall-clock time.
    let offset_s  = timezone_offset_s(config.timezone)
    let now_local = DateTime.from_timestamp(DateTime.now() + offset_s)
    let next = match Conduit.CronParser.next_run(config.schedule, now_local) do
      Ok(t)  -> Some(DateTime.from_timestamp(DateTime.to_timestamp(t) - offset_s))
      Err(_) -> None
    end
    let sched : Conduit.CronSchedule = {
      id: cron_type,    -- static crons use their type name as id
      job_type: cron_type,
      schedule: config.schedule,
      timezone: config.timezone,
      queue: config.queue,
      payload: "{}",
      overlap: Conduit.CronRegistry.overlap_to_string(config.overlap),
      enabled: true,
      last_run_at: None,
      last_job_id: None,
      next_run_at: next,
      tags: config.tags,
      jitter_ms: config.jitter_ms
    }
    Conduit.Storage.cron_upsert(storage, sched)
  end

  -- ─────────────────────────────────────────────────────────────
  -- Timezone offset helpers
  -- ─────────────────────────────────────────────────────────────

  -- Parse a UTC-offset timezone string into a signed offset in seconds.
  --
  -- Accepted forms:
  --   "UTC"        →  0
  --   "UTC+N"      →  N * 3600
  --   "UTC-N"      → -N * 3600
  --   "UTC+N:MM"   →  N * 3600 + MM * 60
  --   "UTC-N:MM"   → -(N * 3600 + MM * 60)
  --
  -- Unrecognised strings fall back to 0 (UTC).
  --
  -- Exposed as a public function so it can be unit-tested directly.
  fn timezone_offset_s(tz : String) : Int do
    if tz == "UTC" do
      0
    else
      if String.starts_with(tz, "UTC+") do
        let rest = String.slice(tz, 4, String.byte_size(tz) - 4)
        pparse_tz_hm(rest, 1)
      else
        if String.starts_with(tz, "UTC-") do
          let rest = String.slice(tz, 4, String.byte_size(tz) - 4)
          pparse_tz_hm(rest, -1)
        else
          0
        end
      end
    end
  end

  -- Parse "H" or "H:MM" into seconds, then multiply by sign (+1 or -1).
  pfn pparse_tz_hm(s : String, sign : Int) : Int do
    match String.split_first(s, ":") do
      None ->
        match String.to_int(s) do
          Ok(h)  -> sign * h * 3600
          Err(_) -> 0
        end
      Some((h_str, m_str)) ->
        let h = match String.to_int(h_str) do
          Ok(n)  -> n
          Err(_) -> 0
        end
        let m = match String.to_int(m_str) do
          Ok(n)  -> n
          Err(_) -> 0
        end
        sign * (h * 3600 + m * 60)
    end
  end

  pfn psleep_ms(ms : Int) : () do Conduit.Time.sleep_ms(ms) end
end
