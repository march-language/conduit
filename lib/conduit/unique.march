mod Conduit.Unique do
  import Conduit
  doc """
  Compute a unique fingerprint for a job based on its type and the configured
  fields extracted from the payload string.

  The fingerprint is: SHA-256 hex of (job_type ++ ":" ++ field1=val1 ++ "," ++ ...).

  If `fields` is empty, the entire payload is included.
  """
  fn fingerprint(job_type : String, payload : String, fields : List(String)) : String do
    let extracted = if is_nil(fields) do
      payload
    else
      let pairs = List.map(fields, fn field -> field ++ "=" ++ pextract_json_field(payload, field))
      String.join(pairs, ",")
    end
    let input = job_type ++ ":" ++ extracted
    Crypto.sha256(input) |> Bytes.to_hex
  end

  doc """
  Check whether a unique constraint is active (not expired) for the given
  fingerprint. Returns true if a conflicting active job exists.
  """
  fn conflicts(storage, unique_key : String) : Result(Bool, String) do
    Conduit.Storage.unique_check(storage, unique_key)
  end

  doc """
  Release a unique constraint for a job (set unique_key = NULL).
  Called when the job completes, is discarded, or dead-lettered.
  """
  fn release(storage, job_id : String) : Result((), String) do
    Conduit.Storage.unique_release(storage, job_id)
  end

  pfn pextract_json_field(payload : String, field : String) : String do
    match JSON.parse(payload) do
      Err(_) -> ""
      Ok(json) ->
        match JSON.get(json, field) do
          None    -> ""
          Some(v) -> JSON.to_string(v)
        end
    end
  end
end
