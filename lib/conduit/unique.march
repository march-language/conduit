mod Conduit.Unique do
  doc """
  Compute a unique fingerprint for a job.

  Scope controls the uniqueness boundary:
  - `PerQueue` (default): fingerprint includes the queue name, so the same job
    type+payload is unique per queue but can be enqueued in different queues.
  - `Global`: fingerprint excludes the queue, so only one active job with this
    type+payload may exist across all queues.

  The fingerprint is: SHA-256 hex of (prefix ++ ":" ++ field1=val1 ++ "," ++ ...).
  If `fields` is empty, the entire payload is included.
  """
  fn fingerprint(job_type : String, queue : String, payload : String, fields : List(String), scope) : String do
    let prefix = match scope do
      PerQueue -> queue ++ ":" ++ job_type
      Global   -> job_type
    end
    let extracted = if is_nil(fields) do
      payload
    else
      -- If the payload cannot be parsed as JSON, the requested fields cannot
      -- be extracted reliably.  Falling back to "" for every field would make
      -- two malformed payloads collide on the same fingerprint, silently
      -- de-duplicating jobs that should not be de-duplicated.  Mix the SHA of
      -- the raw payload into the fingerprint instead so distinct malformed
      -- payloads still produce distinct fingerprints.
      match Json.parse(payload) do
        Err(_) -> "raw:" ++ Crypto.sha256(payload)
        Ok(json) ->
          let pairs = List.map(fields, fn field -> field ++ "=" ++ pextract_field_from_json(json, field))
          String.join(pairs, ",")
      end
    end
    let input = prefix ++ ":" ++ extracted
    Crypto.sha256(input)
  end

  doc """
  Check whether a unique constraint is active (not expired) for the given
  fingerprint. Returns true if a conflicting active job exists.
  """
  fn conflicts(storage : s, unique_key : String) : Result(Bool, String) do
    Conduit.Storage.unique_check(storage, unique_key)
  end

  doc """
  Release a unique constraint for a job (set unique_key = NULL).
  Called when the job completes, is discarded, or dead-lettered.
  """
  fn release(storage : s, job_id : String) : Result((), String) do
    Conduit.Storage.unique_release(storage, job_id)
  end

  -- Extract a field value from already-parsed JSON.  A missing field encodes
  -- as the literal "<absent>" sentinel so that the absence is preserved in
  -- the fingerprint and cannot collide with a present field whose value is
  -- the empty string.
  pfn pextract_field_from_json(json, field : String) : String do
    match Json.get(json, field) do
      None    -> "<absent>"
      Some(v) -> Json.to_string(v)
    end
  end
end
