mod Conduit.Backoff do
  import Conduit
  fn delay(strat : Conduit.Backoff, attempt : Int) : Int do
    match strat do
      Linear ->
        5000 * attempt
      Exponential ->
        int_pow(2, attempt - 1) * 1000
      Fibonacci ->
        pfib(attempt) * 1000
      Custom(f) ->
        f(attempt)
    end
  end

  pfn pfib(n : Int) : Int do
    if n <= 1 do
      n
    else
      pfib(n - 1) + pfib(n - 2)
    end
  end
end
