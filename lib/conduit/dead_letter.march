mod Conduit.DeadLetter do
  import Conduit
  fn from_job(job : Conduit.JobRow, final_error : String) : Conduit.DeadLetter do
    {
      id                 = uuid_v4(),
      job_id             = job.id,
      queue              = job.queue,
      job_type           = job.job_type,
      payload            = job.payload,
      errors             = List.append(job.errors, Cons(final_error, Nil)),
      attempts           = job.attempt,
      first_attempted_at = job.started_at,
      last_attempted_at  = Some(DateTime.now()),
      discarded_at       = DateTime.now(),
      reviewed           = false,
      reviewed_by        = None,
      reviewed_at        = None,
      retry_count        = 0
    }
  end

  fn to_job_info(job : Conduit.JobRow) : Conduit.JobInfo do
    {
      id           = job.id,
      queue        = job.queue,
      job_type     = job.job_type,
      attempt      = job.attempt,
      max_attempts = job.max_attempts,
      tags         = job.tags,
      inserted_at  = job.inserted_at,
      errors       = job.errors
    }
  end
end
