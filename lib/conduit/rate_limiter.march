mod Conduit.RateLimiter do
  needs IO.Clock
  doc """
  Attempt to acquire a rate-limit token for the given job.

  Returns:
    Ok(true)  — token acquired, job may proceed
    Ok(false) — rate-limited, job should be snoozed
    Err(e)    — storage error (treat as allowed to avoid blocking the queue)

  When Ok(false) is returned, call `snooze_duration/1` to compute how long
  to wait before retrying.

  The backend in `config` controls how tokens are tracked:
  - `StorageBacked`: Postgres token bucket via the storage interface (default)
  - `Custom(f)`: user-supplied function, e.g. for Redis or in-process buckets
  """
  fn acquire(storage, job_type : String, config : Conduit.RateLimit, payload : String) : Result(Bool, String) do
    -- Check the global per-job-type bucket first.
    let global_key = "conduit_rl:" ++ job_type
    match pacquire_token(storage, config.backend, global_key, config.max_per_second) do
      Err(e)      -> Err(e)
      Ok(false)   -> Ok(false)
      Ok(true)    ->
        -- Global OK. Now check per-key if configured.
        match config.per_key do
          None -> Ok(true)
          Some(pk) ->
            let user_key = "conduit_rl:" ++ job_type ++ ":" ++ pk.key_fn(payload)
            pacquire_token(storage, config.backend, user_key, pk.limit)
        end
    end
  end

  doc """
  Compute how long to snooze a rate-limited job (in milliseconds).

  For a rate of N tokens/second, the minimum wait is 1000/N ms.
  We add a small jitter (0–100ms) to avoid thundering herd.
  """
  fn snooze_duration(rate : Int) : Int do
    let base_ms = if rate > 0 do int_div(1000, rate) else 1000 end
    let jitter  = Random.int(0, 100)
    base_ms + jitter
  end

  -- Dispatch token acquisition to the configured backend.
  pfn pacquire_token(storage, backend, key : String, rate : Int) : Result(Bool, String) do
    match backend do
      StorageBacked -> Conduit.Storage.rate_limit_acquire(storage, key, rate)
      Custom(f)     -> f(key, rate)
    end
  end
end
